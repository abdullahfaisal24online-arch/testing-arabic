---
// غلاف المشغّل — بيحلّ إنّ صورة الـ thumbnail كانت تجي من Bunny (لقطة عشوائية من
// الفيديو) بدل الصورة اللي ترفعها من لوحة التحكّم.
//
// الفكرة: بنحطّ صورة الغلاف كطبقة فوق مشغّل Bunny مع زر تشغيل، والطبقة
// pointer-events: none — يعني ضغطة الزائر بتمرّ من خلالها لزر التشغيل الحقيقي.
// بنسمع أحداث Bunny الرسمية عبر postMessage حتى نخفي الغلاف عند التشغيل
// ونعلن عن مشاهدة مؤهلة بعد 10 ثوانٍ تشغيل فعلية.
//
// بتنستدعى من Base.astro وبتاخد الصورة من نفس القيمة اللي بتروح لـ og:image،
// فما في داعي لأي تعديل على صفحات الدروس.
// وإذا الدرس بلا صورة غلاف — أو الصورة ما زبطت بالتحميل — ما بتنحطّ أي طبقة
// والمشغّل بيضلّ زي ما هو بالضبط.

interface Props {
  poster?: string | null;
}

const { poster } = Astro.props;
---

{poster ? <span id="vf-poster" data-poster={poster} hidden></span> : null}

<style is:global>
  /* الطبقة absolute، فلازم الحاوية تكون مرجع للتموضع */
  .player { position: relative; }

  .vf-cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none; /* الأساس: الضغطة تمرّ للمشغّل تحت */
    background: var(--player-bg, #0d1526);
    transition: opacity 0.3s ease;
  }

  .vf-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vf-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(6, 12, 24, 0) 45%, rgba(6, 12, 24, 0.35) 100%);
  }

  .vf-play {
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0;
    margin-inline: auto;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    border-radius: 999px;
    background: var(--orange, #f6823b);
    color: #fff;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    z-index: 1;
  }

  @media (max-width: 560px) {
    .vf-play { width: 58px; height: 58px; }
    .vf-play svg { width: 22px; height: 22px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vf-cover { transition: none; }
  }
</style>

<script>
  const PLAYER_ORIGIN = 'https://iframe.mediadelivery.net';
  const QUALIFIED_VIEW_SECONDS = 10;
  const COMPLETE_AT_PERCENT = 90;
  const COMPLETE_KEY = 'ta-video-complete';
  const PLAY_ICON =
    '<svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z"/></svg>';

  const marker = document.getElementById('vf-poster');
  const poster = marker?.dataset.poster;
  const frame = document.querySelector<HTMLIFrameElement>(
    'iframe[src*="iframe.mediadelivery.net"]',
  );
  const box = frame?.parentElement;

  if (frame && box) {
    const player = frame;
    let cover: HTMLElement | null = null;
    let coverGone = false;
    let watchedSeconds = 0;
    let lastVideoTime: number | null = null;
    let qualified = false;
    const lessonId = player.dataset.trackWatch === 'true' ? (player.dataset.lessonId ?? '') : '';
    type WatchedRange = [number, number];

    const readRanges = (): WatchedRange[] => {
      if (!lessonId) return [];
      try {
        const value = JSON.parse(localStorage.getItem(`ta-watch:${lessonId}`) ?? '[]');
        if (!Array.isArray(value)) return [];
        return value.filter(
          (range): range is WatchedRange =>
            Array.isArray(range) &&
            range.length === 2 &&
            Number.isFinite(range[0]) &&
            Number.isFinite(range[1]) &&
            range[1] > range[0],
        );
      } catch {
        return [];
      }
    };

    let watchedRanges = readRanges();
    let lastProgress = -1;

    const addWatchedRange = (start: number, end: number) => {
      const sorted = [...watchedRanges, [start, end] as WatchedRange].sort((a, b) => a[0] - b[0]);
      const merged: WatchedRange[] = [];
      sorted.forEach((range) => {
        const previous = merged[merged.length - 1];
        if (!previous || range[0] > previous[1] + 0.25) merged.push([...range]);
        else previous[1] = Math.max(previous[1], range[1]);
      });
      watchedRanges = merged;
    };

    const saveCertificateProgress = (duration: number) => {
      if (!lessonId || !Number.isFinite(duration) || duration <= 0) return;
      const watched = watchedRanges.reduce((sum, range) => sum + (range[1] - range[0]), 0);
      const exactPercent = Math.min(100, (watched / duration) * 100);
      const percent = Math.floor(exactPercent);
      const complete = exactPercent >= COMPLETE_AT_PERCENT;

      try {
        localStorage.setItem(`ta-watch:${lessonId}`, JSON.stringify(watchedRanges));
        localStorage.setItem(`ta-video-progress:${lessonId}`, String(percent));
        if (complete) {
          const stored = JSON.parse(localStorage.getItem(COMPLETE_KEY) ?? '[]');
          const completed: string[] = Array.isArray(stored) ? stored : [];
          if (!completed.includes(lessonId)) {
            completed.push(lessonId);
            localStorage.setItem(COMPLETE_KEY, JSON.stringify(completed));
          }
        }
      } catch {
        /* المتصفّح مانع التخزين */
      }

      if (percent !== lastProgress) {
        lastProgress = percent;
        window.dispatchEvent(
          new CustomEvent('ta:video-progress', { detail: { lessonId, percent, complete } }),
        );
      }
    };

    const hideCover = () => {
      if (coverGone) return;
      coverGone = true;
      if (!cover) return;
      cover.style.opacity = '0';
      window.setTimeout(() => cover?.remove(), 320);
    };

    if (poster) {
      const img = document.createElement('img');
      img.alt = '';
      img.decoding = 'async';

      img.addEventListener(
        'load',
        () => {
          if (coverGone) return;
          cover = document.createElement('div');
          cover.className = 'vf-cover';
          cover.setAttribute('aria-hidden', 'true');

          const play = document.createElement('span');
          play.className = 'vf-play';
          play.innerHTML = PLAY_ICON;

          cover.append(img, play);
          box.appendChild(cover);
        },
        { once: true },
      );

      // ما زبطت الصورة؟ ما بنحطّ ولا شي — المشغّل بيضلّ زي ما هو
      img.addEventListener('error', () => {}, { once: true });
      img.src = poster;
    }

    const activateEvents = () => {
      player.contentWindow?.postMessage({ command: 'activate' }, PLAYER_ORIGIN);
    };

    player.addEventListener('load', activateEvents);
    activateEvents();

    // بعض إعدادات Bunny لا ترسل حدث play للصفحة الأم بشكل ثابت.
    // انتقال التركيز للـ iframe يحصل فور ضغط زر التشغيل، فنستخدمه فقط
    // كـ fallback لإخفاء الغلاف. احتساب المشاهدة يبقى مع timeupdate أدناه.
    const hideWhenPlayerFocused = () => {
      window.requestAnimationFrame(() => {
        if (document.activeElement === player) hideCover();
      });
    };
    player.addEventListener('focus', hideCover);
    window.addEventListener('blur', hideWhenPlayerFocused);

    window.addEventListener('message', (event) => {
      if (event.origin !== PLAYER_ORIGIN || event.source !== player.contentWindow) return;

      const data = event.data as {
        channel?: string;
        video?: string;
        event?: string;
        status?: { currentTime?: number; duration?: number };
      };
      if (data?.channel !== 'bunnystream' || !data.video) return;

      if (data.event === 'play') {
        hideCover();
        lastVideoTime = null;
        return;
      }

      if (data.event === 'pause' || data.event === 'seeking' || data.event === 'seeked') {
        lastVideoTime = null;
        return;
      }

      if (data.event !== 'timeupdate') return;

      const currentTime = Number(data.status?.currentTime);
      if (!Number.isFinite(currentTime)) return;

      if (lastVideoTime !== null) {
        const delta = currentTime - lastVideoTime;
        // Bunny يرسل timeupdate دورياً. الفروقات الكبيرة تعني Seek ولا تُحسب.
        if (delta > 0 && delta <= 3) {
          if (!qualified) watchedSeconds += delta;
          if (lessonId) addWatchedRange(lastVideoTime, currentTime);
        }
      }
      lastVideoTime = currentTime;

      if (lessonId) saveCertificateProgress(Number(data.status?.duration));

      if (!qualified && watchedSeconds >= QUALIFIED_VIEW_SECONDS) {
        qualified = true;
        window.dispatchEvent(
          new CustomEvent('ta:video-view-qualified', { detail: { videoId: data.video } }),
        );
      }
    });
  }
</script>
