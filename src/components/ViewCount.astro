---
interface Props {
  videoId: string;
  threshold?: number;
}

const { videoId, threshold = 10 } = Astro.props;
---

<div
  class="view-count"
  data-video-id={videoId}
  data-threshold={String(threshold)}
  aria-label="عدد المشاهدات"
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M2.4 12s3.5-6.1 9.6-6.1 9.6 6.1 9.6 6.1-3.5 6.1-9.6 6.1S2.4 12 2.4 12Z" />
    <circle cx="12" cy="12" r="2.7" />
  </svg>
  <span class="number" aria-live="polite">—</span>
  <span>مشاهدة</span>
</div>

<style>
  .view-count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding: 9px 16px;
    color: var(--ink-2);
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 600;
  }

  .view-count[hidden] {
    display: none;
  }

  svg {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .number {
    color: var(--cyan);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('.view-count');
  const output = root?.querySelector<HTMLElement>('.number');

  if (root && output) {
    const videoId = root.dataset.videoId ?? '';
    const threshold = Math.max(0, Number(root.dataset.threshold ?? '10'));
    let submitted = false;

    const paint = (views: number) => {
      output.textContent = new Intl.NumberFormat('ar-JO-u-nu-latn').format(views);
      root.hidden = views < threshold;
    };

    fetch(`/api/views?video=${encodeURIComponent(videoId)}`)
      .then((response) => response.json())
      .then((data: { ok?: boolean; views?: number }) => {
        if (data?.ok && typeof data.views === 'number') paint(data.views);
      })
      .catch(() => {
        output.textContent = '—';
        root.hidden = true;
      });

    window.addEventListener('ta:video-view-qualified', async (event) => {
      const detail = (event as CustomEvent<{ videoId?: string }>).detail;
      if (submitted || detail?.videoId !== videoId) return;
      submitted = true;

      try {
        const response = await fetch('/api/views', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ videoId }),
        });
        const data = (await response.json()) as { ok?: boolean; views?: number };
        if (data?.ok && typeof data.views === 'number') paint(data.views);
      } catch {
        // فشل التسجيل ما لازم يأثر على تشغيل الفيديو.
      }
    });
  }
</script>
