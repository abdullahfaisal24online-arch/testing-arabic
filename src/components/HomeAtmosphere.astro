---
// Native vector artwork: jointed legs, seven spots, shell highlights and flight wings.
const bugs = [0, 1, 2];
---
<div id="home-atmosphere" aria-hidden="true">
  <svg class="home-web" viewBox="0 0 160 120" fill="none"><g stroke="currentColor" stroke-width=".75">
    <path d="M0 0H160M0 0 156 30M0 0 137 60M0 0 112 87M0 0 79 105M0 0 40 116M0 0V120" />
    {[.2,.4,.6,.8,1].map(scale => <path transform={`scale(${scale})`} d="M160 0Q151 12 156 30Q138 39 137 60Q118 66 112 87Q91 89 79 105Q58 101 40 116Q18 107 0 120" />)}
  </g></svg>
  <div class="home-web-air"><span class="web-wisp"></span><span class="web-wisp wisp-second"></span><span class="web-dust"></span></div>
</div>
<div id="home-bug-swarm" hidden>
  {bugs.map(n => <button type="button" class="home-bug" aria-label={`طيّر الدعسوقة ${n + 1}`} title="اضغط لتطير" hidden>
    <span class="lady-shadow" aria-hidden="true"></span>
    <span class="lady-turn" aria-hidden="true"><span class="lady-lift">
      <svg class="lady-art" viewBox="0 0 64 76" fill="none">
        <defs>
          <radialGradient id={`shell-${n}`} cx="23" cy="33" r="38" gradientUnits="userSpaceOnUse"><stop stop-color="#ff9a65"/><stop offset=".28" stop-color="#e95127"/><stop offset=".68" stop-color="#b02819"/><stop offset="1" stop-color="#49151a"/></radialGradient>
          <linearGradient id={`body-${n}`} x1="12" y1="18" x2="46" y2="65" gradientUnits="userSpaceOnUse"><stop stop-color="#53535a"/><stop offset=".4" stop-color="#181a20"/><stop offset="1" stop-color="#05090e"/></linearGradient>
          <linearGradient id={`wing-${n}`} x1="32" y1="29" x2="14" y2="67" gradientUnits="userSpaceOnUse"><stop stop-color="#e0e5d7" stop-opacity=".82"/><stop offset="1" stop-color="#a4cbdc" stop-opacity=".23"/></linearGradient>
        </defs>
        <g class="lady-legs" stroke="#40322e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path class="leg-a" d="M21 31 13 26 10 17 7 15M43 44 53 44 58 50 60 49M23 55 16 63 15 69 11 70"/>
          <path class="leg-b" d="M43 31 51 26 54 17 57 15M21 44 11 44 6 50 4 49M41 55 48 63 49 69 53 70"/>
        </g>
        <path d="M25 16 22 8 18 5M39 16 42 8 46 5" stroke="#393330" stroke-width="1.6" stroke-linecap="round"/>
        <circle cx="18" cy="5" r="1.5" fill="#423a33"/><circle cx="46" cy="5" r="1.5" fill="#423a33"/>
        <ellipse cx="32" cy="45" rx="19" ry="25" fill={`url(#body-${n})`}/>
        <path d="M19 28Q18 13 32 12Q46 13 45 28Z" fill={`url(#body-${n})`}/>
        <path d="M21 20Q24 16 27 18L26 24 21 25ZM43 20Q40 16 37 18L38 24 43 25Z" fill="#e7e0ca"/>
        <circle cx="25" cy="14" r="1.8" fill="#11171c"/><circle cx="39" cy="14" r="1.8" fill="#11171c"/>
        <g class="lady-wings" fill={`url(#wing-${n})`} stroke="#d0dfdb" stroke-opacity=".38" stroke-width=".65">
          <path class="wing-left" d="M31 29C9 26-7 41 3 61C13 74 30 47 31 29ZM29 33 6 59M24 37 8 45M20 43 15 57"/>
          <path class="wing-right" d="M33 29C55 26 71 41 61 61C51 74 34 47 33 29ZM35 33 58 59M40 37 56 45M44 43 49 57"/>
        </g>
        <g class="shell-left">
          <path d="M31.6 26C5 22 5 63 24 69Q28 71 31.6 69Z" fill={`url(#shell-${n})`} stroke="#671824" stroke-width=".6"/>
          <path d="M30 27Q25 27 25 32Q26 36 31 36Z" fill="#1c1b22"/>
          <ellipse cx="19.5" cy="40" rx="4.1" ry="4.8" fill="#1c1b22" transform="rotate(16 19.5 40)"/>
          <ellipse cx="18" cy="55" rx="3.5" ry="4" fill="#1c1b22"/>
          <ellipse cx="27" cy="63" rx="2.7" ry="3" fill="#1c1b22"/>
          <path d="M24 29Q14 33 15 44" stroke="#ffd5b0" stroke-opacity=".5" stroke-width="2.8" stroke-linecap="round"/>
        </g>
        <g class="shell-right">
          <path d="M32.4 26C59 22 59 63 40 69Q36 71 32.4 69Z" fill={`url(#shell-${n})`} stroke="#671824" stroke-width=".6"/>
          <path d="M34 27Q39 27 39 32Q38 36 33 36Z" fill="#1c1b22"/>
          <ellipse cx="44.5" cy="40" rx="4.1" ry="4.8" fill="#1c1b22" transform="rotate(-16 44.5 40)"/>
          <ellipse cx="46" cy="55" rx="3.5" ry="4" fill="#1c1b22"/>
          <ellipse cx="37" cy="63" rx="2.7" ry="3" fill="#1c1b22"/>
          <path d="M48 38Q54 56 41 66" stroke="#fb7960" stroke-opacity=".28" stroke-width="1.4"/>
        </g>
      </svg>
    </span></span>
  </button>)}
</div>
<button type="button" class="home-motion-toggle" aria-pressed="false" hidden>إيقاف التأثيرات</button>

<style is:global>
  .home-effects .hero { position: relative; isolation: isolate; }
  .home-effects .hero-in { position: relative; z-index: 1; }
  /* أقل كثافة، وثابتة: حركة الدعسوقات هي الحركة المحيطية الوحيدة. */
  .home-effects .bgfx-dots,
  html:not([data-theme='light']) .home-effects .dots.bgfx-band::before {
    background-image: radial-gradient(circle at 1px 1px, rgba(56,189,248,.065) .8px, transparent 0);
    background-size: 28px 28px;
    animation: none;
    will-change: auto;
  }
  .home-effects .bgfx-glow,
  html:not([data-theme='light']) .home-effects .dots.bgfx-band::after { display: none; }
  #home-atmosphere { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .home-web { position: absolute; top: 0; left: 0; width: clamp(190px, 20vw, 270px); height: auto; color: var(--cyan); opacity: .25; transform-origin: 0 0; }
  .home-web-air { position: absolute; top: 0; left: 0; width: clamp(230px, 25vw, 340px); height: 220px; overflow: hidden; mask-image: radial-gradient(ellipse at 12% 18%, #000 18%, transparent 73%); }
  .web-wisp { position: absolute; top: 15px; left: -100%; width: 110%; height: 100px; border-radius: 50%; background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--ink-2) 19%, transparent), transparent 68%); filter: blur(12px); opacity: 0; animation: home-air-pass 17s ease-in-out infinite; animation-play-state: paused; }
  .web-wisp.wisp-second { top: 70px; height: 70px; animation-delay: -8s; animation-duration: 21s; }
  .web-dust { position: absolute; inset: 0; background-image: radial-gradient(circle at 14% 24%, var(--ink-2) .7px, transparent 1.3px), radial-gradient(circle at 44% 55%, var(--ink-2) .6px, transparent 1.2px), radial-gradient(circle at 62% 30%, var(--ink-2) .8px, transparent 1.4px), radial-gradient(circle at 30% 70%, var(--ink-2) .6px, transparent 1.1px); background-size: 110px 90px; opacity: 0; animation: home-dust-pass 19s linear infinite; animation-play-state: paused; }
  #home-atmosphere[data-running='true'] :is(.web-wisp, .web-dust) { animation-play-state: running; }
  @keyframes home-air-pass { 0%,12% { transform: translateX(0) translateY(20px) rotate(-18deg); opacity: 0; } 30% { opacity: .6; } 58% { opacity: .35; } 78%,100% { transform: translateX(195%) translateY(-32px) rotate(-8deg); opacity: 0; } }
  @keyframes home-dust-pass { 0%,15% { transform: translate(-35px,22px); opacity: 0; } 32%,65% { opacity: .17; } 90%,100% { transform: translate(58px,-26px); opacity: 0; } }
  .home-web.is-shivering { animation: home-web-sway .85s ease-out; }
  @keyframes home-web-sway { 20% { transform: skewY(1.2deg); } 45% { transform: skewY(-.7deg); } 70% { transform: skewY(.3deg); } }
  .home-motion-toggle { position: absolute; left: max(24px, calc((100% - 1152px) / 2)); bottom: 8px; z-index: 3; min-height: 44px; padding: 8px 4px; border: 0; background: transparent; color: var(--muted); font: inherit; font-size: 11px; cursor: pointer; }
  .home-motion-toggle:hover { color: var(--ink); }
  .home-effects :is(a.card, a.game-card) { transition: border-color .22s ease, box-shadow .22s ease, transform .22s ease; }
  .home-effects .welcome { transform: none; }
  .home-effects .welcome .thumb { isolation: isolate; }
  .home-effects .welcome :is(.vf-play, .play) { transition: scale .22s ease, box-shadow .22s ease; }
  @media (hover: hover) and (pointer: fine) {
    .home-effects :is(a.card, a.game-card):hover { border-color: var(--cyan); box-shadow: 0 0 0 1px var(--cyan-soft), 0 12px 32px var(--cyan-soft); transform: translateY(-3px); }
    .home-effects .welcome:hover { border-color: var(--cyan); box-shadow: var(--shadow-lg), 0 0 22px var(--cyan-soft); }
    .home-effects .welcome:hover :is(.vf-play, .play) { scale: 1.06; box-shadow: 0 0 0 7px var(--orange-soft), 0 8px 28px var(--orange-soft); }
  }
  .home-effects :is(a.card, a.game-card):focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; }
  @media (hover: none) {
    .home-effects :is(a.card, a.game-card):hover { transform: none; }
    .home-effects :is(a.card, a.game-card):active { border-color: var(--cyan); }
  }
  .home-effects[data-home-motion='paused'] :is(.card, .game-card, .vf-play, .play, .home-bug-turn) { transition: none; }
  .home-effects[data-home-motion='paused'] :is(a.card, a.game-card):hover { transform: none; }
  .home-effects[data-home-motion='paused'] .welcome :is(.vf-play, .play) { scale: 1; }
  .home-effects[data-home-motion='paused'] .home-web { animation: none; }
  @media (max-width: 760px) { .home-web { width: 156px; height: auto; opacity: .2; } .home-web-air { width: 205px; height: 145px; } .web-wisp { filter: blur(8px); } }
  @media (prefers-reduced-motion: reduce) {
    .home-bug, .home-motion-toggle { display: none; }
    .home-web { animation: none !important; }
    .home-web-air { display: none; }
    .home-effects :is(a.card, a.game-card):hover { transform: none; }
    .home-effects .welcome :is(.vf-play, .play) { scale: 1 !important; }
  }
</style>
<style is:global>
  .home-effects .hero { position: relative; }
  #home-bug-swarm { position: absolute; inset: 0; pointer-events: none; z-index: 3; overflow: clip; }
  #home-bug-swarm[hidden], .home-bug[hidden] { display: none !important; }
  .home-bug { position: absolute; left: 0; top: 0; width: 44px; height: 44px; margin: 0; padding: 0; border: 0; background: transparent; border-radius: 50%; pointer-events: auto; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .home-bug:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .lady-turn { position: absolute; inset: 0; display: grid; place-items: center; transition: rotate .32s ease; }
  .lady-lift { display: block; width: 42px; height: 50px; transition: scale .25s ease, translate .25s ease; }
  .lady-art { width: 100%; height: 100%; overflow: visible; filter: drop-shadow(0 2px 1px #0004); }
  .lady-shadow { position: absolute; width: 23px; height: 27px; left: 11px; top: 13px; border-radius: 50%; background: #0005; filter: blur(2px); transition: scale .25s ease, opacity .25s ease; }
  .lady-wings { opacity: 0; transition: opacity .12s; }
  .shell-left { transform-origin: 31px 27px; transition: transform .2s ease; }
  .shell-right { transform-origin: 33px 27px; transition: transform .2s ease; }
  .home-bug.is-flying .shell-left { transform: rotate(32deg); }
  .home-bug.is-flying .shell-right { transform: rotate(-32deg); }
  .home-bug.is-flying .lady-wings { opacity: 1; }
  .home-bug.is-flying .wing-left { transform-origin: 31px 29px; animation: lady-wing-left .055s alternate infinite; }
  .home-bug.is-flying .wing-right { transform-origin: 33px 29px; animation: lady-wing-right .055s alternate infinite; }
  .home-bug.is-flying .lady-lift { scale: 1.15; translate: 0 -3px; }
  .home-bug.is-flying .lady-shadow { scale: 1.5; opacity: .3; }
  .home-bug.is-walking .leg-a { transform-origin: 32px 42px; animation: lady-step .15s alternate infinite; }
  .home-bug.is-walking .leg-b { transform-origin: 32px 42px; animation: lady-step .15s -.15s alternate infinite; }
  @keyframes lady-step { to { transform: rotate(7deg); } }
  @keyframes lady-wing-left { to { transform: rotate(17deg) scaleX(.7); } }
  @keyframes lady-wing-right { to { transform: rotate(-17deg) scaleX(.7); } }
  .home-bug.is-resting .lady-turn { transition-duration: .6s; }
  .home-bug.is-peeking .lady-lift { animation: lady-peek 1s ease-out both; }
  @keyframes lady-peek { 0% { clip-path: inset(0 0 72% 0); opacity: .35; translate: 0 7px; } 45% { clip-path: inset(0 0 35% 0); opacity: 1; translate: 0 3px; } 100% { clip-path: inset(0); translate: 0 0; } }
  .home-effects[data-home-motion='paused'] .home-bug * { animation-play-state: paused !important; transition: none; }
  .home-effects .home-bug.is-still * { animation-play-state: paused !important; transition: none; }
  @media(max-width:760px) { .lady-lift { width: 34px; height: 40px; } .lady-shadow { scale: .8; } }
  @media(prefers-reduced-motion:reduce) { #home-bug-swarm { display: none; } }
</style>
<script>
  import '../scripts/home-atmosphere';
</script>
