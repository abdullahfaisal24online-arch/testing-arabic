---
import { NEWSLETTER_ACTION } from '../consts';
---
{NEWSLETTER_ACTION && (
  <section class="section">
    <div class="wrap">
      <div class="nl dots">
        <div class="txt">
          <h2>خلّي طريقك لعندي مضمون</h2>
          <p class="lead">اشترك بالنشرة، وبيوصلك كل درس ومقال جديد على بريدك مباشرة — بدون ما تعتمد على خوارزمية أو منصة واحدة.</p>
        </div>
        <form class="form" action={NEWSLETTER_ACTION} method="post" target="_blank">
          <label class="sr-only" for="nl-email">بريدك الإلكتروني</label>
          <input id="nl-email" name="email" type="email" required placeholder="بريدك الإلكتروني" />
          <button class="btn btn-primary" type="submit">اشترك</button>
          <span class="note">بدون سبام. إلغاء الاشتراك بضغطة واحدة.</span>
        </form>
      </div>
    </div>
  </section>
)}

<style>
  .nl {
    display: flex;
    gap: 44px;
    align-items: center;
    flex-wrap: wrap;
    background: var(--navy);
    border: 1px solid rgba(246, 130, 59, 0.3);
    border-radius: var(--r-xl);
    padding: 42px 44px;
  }
  .txt { flex: 1 1 380px; display: grid; gap: 12px; }
  .form { flex: 0 1 420px; display: grid; grid-template-columns: 1fr auto; gap: 10px; }
  .form input {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: 14px 18px;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    min-height: 48px;
  }
  .form input::placeholder { color: var(--faint); }
  .note { grid-column: 1 / -1; font-size: 13px; color: var(--faint); }
  @media (max-width: 620px) {
    .nl { padding: 28px 22px; }
    .form { grid-template-columns: 1fr; }
  }
</style>
