---
import Icon from './Icon.astro';
import { bunnyThumb } from '../lib/utils';
import { getSite } from '../lib/site';

interface Props {
  lesson: {
    id: string;
    data: {
      title: string;
      description: string;
      category: string;
      duration: string;
      videoId?: string;
      thumbnail?: string;
      publishDate: Date;
    };
  };
  /** اسم الدورة التي ينتمي لها الدرس — يظهر كشارة على البطاقة */
  courseTitle?: string;
}
const { lesson, courseTitle } = Astro.props;
const { data } = lesson;
const site = await getSite();
const thumb = bunnyThumb(data.videoId, data.thumbnail, site.bunnyCdnHostname);
---
<a class="card lesson-card" href={`/lessons/${lesson.id}/`}>
  <div class:list={['thumb', { 'thumb--ph': !thumb }]}>
    {thumb ? (
      <img src={thumb} alt="" loading="lazy" decoding="async" width="640" height="360" />
    ) : (
      <span class="thumb-ph" aria-hidden="true">
        <span class="ph-mark">🔻</span>
        <span class="ph-txt">Testing بالعربي</span>
      </span>
    )}
    {thumb && <span class="play"><Icon name="play" size={20} /></span>}
    <span class="time mono">{data.duration}</span>
  </div>
  <div class="card-body">
    <span class="cat">{data.category}</span>
    <span class="card-title">{data.title}</span>
    <span class="card-meta">
      {courseTitle ? (
        <span class="in-course" title={`ضمن دورة ${courseTitle}`}>
          <Icon name="list" size={13} /> {courseTitle}
        </span>
      ) : (
        <span class="standalone"><Icon name="play" size={12} /> فيديو متفرّق</span>
      )}
    </span>
  </div>
</a>

<style>
  .lesson-card { color: inherit; }
  .cat { font-size: 12px; font-weight: 600; color: var(--orange); }
  .in-course,
  .standalone {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    padding: 4px 10px;
    border-radius: 999px;
    max-width: 100%;
  }
  .in-course { background: var(--cyan-soft); color: var(--cyan); }
  .standalone { border: 1px solid var(--line); color: var(--muted); }
  .in-course span,
  .standalone span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* غلاف بديل بهوية المنصة لما الدرس ما إله صورة/فيديو بعد */
  .thumb-ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(150deg, #12213d 0%, #0a1428 100%);
    overflow: hidden;
  }
  .thumb-ph::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(56, 189, 248, 0.12) 1px, transparent 1.5px);
    background-size: 16px 16px;
    opacity: 0.5;
  }
  .thumb-ph::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 70% at 50% 40%, rgba(246, 130, 59, 0.07), transparent 70%);
  }
  .ph-mark {
    position: relative;
    font-size: 30px;
    line-height: 1;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
  }
  .ph-txt {
    position: relative;
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-2, #c3d0e4);
    letter-spacing: 0.2px;
  }
</style>
