---
import { getEntry } from 'astro:content';
import { getSite } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const site = await getSite();
const {
  title,
  description = site.description,
  image = '/og-default.png',
  type = 'website',
  publishDate,
  updatedDate,
  noindex = false,
  jsonLd,
} = Astro.props;

const base = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL(image, base);
const cleanText = (value: string) => value.replace(/\s+/g, ' ').trim();
const shorten = (value: string, max: number) =>
  value.length <= max ? value : `${value.slice(0, max - 1).trimEnd()}…`;
const cleanTitle = cleanText(title);
const titleWithBrand = cleanTitle === site.name
  ? `${site.name} | تعلّم اختبار البرمجيات`
  : cleanTitle.includes(site.name) ? cleanTitle : `${cleanTitle} | ${site.name}`;
const fullTitle = shorten(titleWithBrand, 65);
const cleanDescription = cleanText(description);
const usefulDescription = cleanDescription.length < 70
  ? `${cleanDescription} شرح مبسّط وعملي بالعربي من منصة ${site.name}.`
  : cleanDescription;
const metaDescription = shorten(usefulDescription, 160);
// ===== GEO: هوية المنصة والمؤسس بكل صفحة (ثابتة بـ @id عشان محركات البحث وأدوات الـ AI تربطهم ببعض) =====
const siteUrl = site.url.replace(/\/$/, '');
const about = await getEntry('pages', 'about').catch(() => undefined);
const profile = about?.data as Record<string, string> | undefined;
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'EducationalOrganization',
      '@id': `${siteUrl}/#organization`,
      name: site.name,
      alternateName: ['Testing Arabic', 'Testing Bil Arabi'],
      url: `${siteUrl}/`,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/brand/testing-arabic-logo.jpg` },
      description: site.description,
      inLanguage: 'ar',
      founder: { '@id': `${siteUrl}/#author` },
      ...(site.email ? { email: site.email } : {}),
      sameAs: [site.facebook, site.instagram, site.youtube].filter(Boolean),
      knowsAbout: ['Software Testing', 'Quality Assurance', 'ISTQB', 'Test Management', 'Agile', 'Scrum', 'Jira', 'API Testing', 'Postman', 'Mobile Test Automation'],
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#author`,
      name: site.author,
      url: `${siteUrl}/about/`,
      ...(profile?.profileRole ? { jobTitle: profile.profileRole } : {}),
      ...(profile?.profilePhoto ? { image: `${siteUrl}${profile.profilePhoto}` } : {}),
      worksFor: { '@id': `${siteUrl}/#organization` },
      sameAs: [site.linkedin].filter(Boolean),
      knowsAbout: ['Software Testing', 'Quality Assurance', 'ISTQB', 'Test Automation'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: site.name,
      url: `${siteUrl}/`,
      inLanguage: 'ar',
      description: site.description,
      publisher: { '@id': `${siteUrl}/#organization` },
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
  ],
};
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="ar_JO" />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0a1428" />

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
{blocks.map((block) => (
  <script type="application/ld+json" set:html={JSON.stringify(block)} />
))}
