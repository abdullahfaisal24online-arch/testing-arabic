---
import { getCollection } from 'astro:content';
import { BUG_HUNTER_CASES } from '../data/bug-hunter-cases';
/** قسم "العب وتعلّم" بالرئيسية — كل ألعاب المنصة بكروت موحّدة جنب بعض. */
import Icon from './Icon.astro';

interface Props {
  bugHunter?: {
    enabled: boolean;
    showHomeCard: boolean;
    homeBadge: string;
    homeTitle: string;
    homeText: string;
    homeCta: string;
    durationSeconds: number;
    bugs: unknown[];
  };
  debugHunt?: {
    showHomeCard: boolean;
    homeBadge: string;
    homeTitle: string;
    homeText: string;
    homeCta: string;
    homeMeta: string[];
  };
}
const { bugHunter, debugHunt } = Astro.props;
const dh = debugHunt ?? { showHomeCard: true, homeBadge: 'جديد 🎮', homeTitle: 'Debug Hunt', homeText: 'اصطاد الـ bugs قبل ما توصل Production… وانتبه لا تكسر أي feature 😅', homeCta: 'العب Debug Hunt', homeMeta: [] };
// الـ Cases المتاحة للعب: Case 01 دايماً + كل Case مفعّلة بالـ CMS وإلها محتوى بالكود — الأرقام بتتحدّث لحالها
const liveIds = new Set(['broken-shop', ...(await getCollection('bugCases').catch(() => []))
  .filter((c) => c.data.enabled && !c.data.comingSoon).map((c) => c.id)]);
const liveCases = Object.entries(BUG_HUNTER_CASES).filter(([id, c]) => liveIds.has(id) && c.bugs.length);
const bhBugs = liveCases.reduce((n, [, c]) => n + c.bugs.length, 0);
const isLatin = (t: string) => /^[\x00-\x7F\s]+$/.test(t);

const games = [
  bugHunter?.enabled && bugHunter.showHomeCard && {
    href: '/bug-hunter/',
    img: '/games/bug-hunter-case-files.webp',
    kind: 'تحدّي عملي',
    badge: bugHunter.homeBadge,
    title: bugHunter.homeTitle,
    text: bugHunter.homeText,
    meta: [liveCases.length > 1 ? `${liveCases.length} Cases` : `${bugHunter.durationSeconds} ثانية`, `${bhBugs} Bugs`, 'بدون تسجيل'],
    cta: bugHunter.homeCta,
    tone: 'orange',
  },
  dh.showHomeCard && {
    href: '/debug-hunt/',
    img: '/games/debug-hunt-cover.webp',
    kind: 'استراحة retro',
    badge: dh.homeBadge,
    title: dh.homeTitle,
    text: dh.homeText,
    meta: dh.homeMeta?.length ? dh.homeMeta : ['60 ثانية', 'بتلعب عالموبايل', 'شارك سكورك'],
    cta: dh.homeCta,
    tone: 'cyan',
    pixel: false,
    pixelTitle: isLatin(dh.homeTitle),
  },
].filter(Boolean) as any[];
---

{games.length > 0 && (
  <section class="section games" aria-labelledby="games-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <span class="eyebrow">العب وتعلّم</span>
          <h2 id="games-title">تحدّى نفسك بين الدروس</h2>
          <p class="lead">ألعاب قصيرة بتختبر عينك كـ QA — بدون تسجيل وبدون ما تنزّل إشي.</p>
        </div>
      </div>

      <div class:list={['games-grid', { single: games.length === 1 }]}>
        {games.map((g) => (
          <a class:list={['game-card', `tone-${g.tone}`]} href={g.href}>
            <div class="shot">
              <img src={g.img} alt="" width="1280" height="720" loading="lazy" decoding="async" class:list={{ pixel: g.pixel }} />
            </div>
            <div class="body">
              {g.badge && <span class="badge"><span aria-hidden="true">●</span> {g.badge}</span>}
              <h3 class:list={{ px: g.pixelTitle }}>{g.title}</h3>
              <p>{g.text}</p>
              <ul class="meta">{g.meta.map((m: string) => <li>{m}</li>)}</ul>
              <span class="btn btn-primary cta">{g.cta} <Icon name="arrow" size={18} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .games-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .games-grid.single { grid-template-columns: minmax(0, 620px); }
  .game-card {
    display: flex; flex-direction: column; overflow: hidden; border-radius: 22px; color: #eaf3ff;
    background: linear-gradient(160deg, #101f3d 0%, #0b1730 70%, #081327 100%);
    border: 1px solid rgba(56, 189, 248, .32); box-shadow: 0 20px 50px rgba(2, 8, 23, .28);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }
  .game-card:hover { transform: translateY(-3px); border-color: #38bdf8; box-shadow: 0 26px 60px rgba(2, 8, 23, .38); color: #fff; }
  .tone-orange:hover { border-color: #f6823b; }
  .shot { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #070f1e; border-bottom: 1px solid rgba(56, 189, 248, .22); }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .35s ease; }
  .shot img.pixel { image-rendering: pixelated; }
  .game-card:hover .shot img { transform: scale(1.03); }
  .kind { position: absolute; top: 12px; right: 12px; font-size: 13px; font-weight: 700; padding: 5px 12px; border-radius: 999px;
    background: rgba(6, 11, 22, .78); border: 1px solid rgba(56, 189, 248, .4); color: #cfe6fb; backdrop-filter: blur(4px); }
  .tone-orange .kind { border-color: rgba(246, 130, 59, .55); color: #ffd2b3; }
  .body { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 22px 24px 24px; flex: 1; }
  .badge { display: inline-flex; gap: 8px; align-items: center; font-size: 13.5px; font-weight: 700; color: #ff9b5d; }
  .badge span { color: #fb4f4f; text-shadow: 0 0 10px #fb4f4f; }
  .tone-cyan .badge { color: #7dd3fc; } .tone-cyan .badge span { color: #38bdf8; text-shadow: 0 0 10px #38bdf8; }
  h3 { font-size: 24px; line-height: 1.5; margin: 0; color: #fff; }
  h3.px { font-family: 'Press Start 2P', monospace; font-size: 19px; line-height: 1.6; direction: ltr; unicode-bidi: isolate; }
  p { margin: 0; color: #b9c9df; font-size: 16px; line-height: 1.8; }
  .meta { list-style: none; margin: 2px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .meta li { font-size: 13px; font-weight: 600; color: #d6e3f4; padding: 4px 11px; border-radius: 999px; background: rgba(56, 189, 248, .08); border: 1px solid rgba(56, 189, 248, .22); }
  .cta { margin-top: auto; }
  .tone-cyan .cta { background: #38bdf8; color: #06121f; }
  @media (max-width: 820px) { .games-grid { grid-template-columns: 1fr; } }
</style>
