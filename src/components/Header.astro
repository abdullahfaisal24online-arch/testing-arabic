---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const nav = site.nav.length ? site.nav : [{ label: 'الرئيسية', href: '/' }];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-head">
  <div class="wrap inner">
    <a href="/" class="brand" aria-label="الصفحة الرئيسية"><Logo /></a>

    <nav class="nav" aria-label="القائمة الرئيسية">
      {nav.map((item) => (
        <a href={item.href} class:list={['nav-link', { on: isActive(item.href) }]}
           aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="grow"></div>

    <button class="icon-btn theme-btn" type="button" aria-label="تبديل وضع القراءة" title="تبديل الوضع الفاتح والغامق">
      <span class="i-dark"><Icon name="sun" size={19} /></span>
      <span class="i-light"><Icon name="moon" size={19} /></span>
    </button>
    <a href="/search/" class="icon-btn" aria-label="بحث"><Icon name="search" size={19} /></a>
    {site.headerCtaLabel && (
      <a href={site.headerCtaHref} class="btn btn-primary btn-sm start">{site.headerCtaLabel}</a>
    )}

    <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="القائمة">
      <Icon name="list" size={20} />
    </button>
  </div>

  <nav class="mobile-nav" id="mobile-nav" hidden aria-label="القائمة">
    {nav.map((item) => <a href={item.href} class:list={['m-link', { on: isActive(item.href) }]}>{item.label}</a>)}
    <a href="/search/" class="m-link">بحث</a>
  </nav>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--head-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .inner { display: flex; align-items: center; gap: 26px; padding-block: 12px; }
  .brand { color: inherit; }
  .nav { display: flex; align-items: center; gap: 22px; }
  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
    padding-block-end: 3px;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link.on { color: var(--ink); border-bottom-color: var(--orange); }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .icon-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .menu-btn { display: none; }
  .theme-btn { display: grid; }
  .theme-btn .i-light { display: none; }
  :root[data-theme='light'] .theme-btn .i-dark { display: none; }
  :root[data-theme='light'] .theme-btn .i-light { display: grid; }
  .mobile-nav { display: none; }

  @media (max-width: 900px) {
    .nav, .start { display: none; }
    .menu-btn { display: grid; }
    .mobile-nav[hidden] { display: none; }
    .mobile-nav {
      display: grid;
      gap: 2px;
      padding: 10px 24px 18px;
      border-top: 1px solid var(--line);
    }
    .m-link {
      color: var(--ink-2);
      font-size: 16px;
      font-weight: 500;
      padding: 12px 4px;
      min-height: 48px;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--line);
    }
    .m-link.on { color: var(--orange); }
  }
</style>

<script>
  // مفتاح الوضع الفاتح/الغامق
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-btn');
  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('ta-theme', next);
    } catch {
      /* المتصفّح مانع التخزين — الاختيار بيضل لهذه الصفحة بس */
    }
  });

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    if (nav) nav.hidden = open;
  });
</script>
