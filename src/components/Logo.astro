---
import { getSite } from '../lib/site';

interface Props { size?: number; withText?: boolean; }
const { size = 38, withText = true } = Astro.props;
const site = await getSite();
---
<span class="logo">
  <span class="mark" style={`width:${size}px;height:${size}px`}>
    <svg width={size * 0.5} height={size * 0.5} viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="4" width="20" height="14" rx="2"></rect>
      <path d="M8 21h8"></path><path d="M12 18v3"></path>
      <path d="m9.5 10.5 2 2 3.5-3.5" stroke="var(--cyan)"></path>
    </svg>
  </span>
  {withText && (
    <span class="txt">
      <b>{site.logoTop}</b>
      <i>{site.logoBottom}</i>
    </span>
  )}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 11px; color: var(--ink); }
  .mark {
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--bg);
    border: 2px solid var(--cyan);
    box-shadow: var(--glow);
    color: var(--ink);
    flex-shrink: 0;
  }
  .txt { display: flex; flex-direction: column; line-height: 1.15; }
  .txt b { font-size: 15px; font-weight: 700; letter-spacing: 0.2px; }
  .txt i { font-size: 12.5px; font-style: normal; font-weight: 500; color: var(--muted); }
</style>
