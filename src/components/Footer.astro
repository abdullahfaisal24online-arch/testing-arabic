---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { getSite } from '../lib/site';

const site = await getSite();
const year = new Date().getFullYear();
---
<footer class="site-foot">
  <div class="wrap inner">
    <div class="brand-col">
      <Logo />
      <p class="tag">{site.tagline}</p>
      <div class="social">
        {site.youtube && <a href={site.youtube} rel="me noopener" target="_blank" aria-label="يوتيوب" title="يوتيوب"><Icon name="youtube" size={17} /></a>}
        {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank" aria-label="لينكدإن" title="لينكدإن"><Icon name="board" size={17} /></a>}
        {site.facebook && <a href={site.facebook} rel="me noopener" target="_blank" aria-label="فيسبوك" title="فيسبوك"><Icon name="facebook" size={17} /></a>}
        {site.instagram && <a href={site.instagram} rel="me noopener" target="_blank" aria-label="إنستغرام" title="إنستغرام"><Icon name="instagram" size={17} /></a>}
        {site.email && <a href={`mailto:${site.email}`} aria-label="بريد" title="بريد"><Icon name="mail" size={17} /></a>}
        <a href="/rss.xml" aria-label="RSS" title="RSS"><Icon name="rss" size={17} /></a>
      </div>
    </div>

    <nav class="col" aria-label="روابط التعلّم">
      <h3 class="ttl">تعلّم</h3>
      <a href="/courses/">الدورات</a>
      <a href="/lessons/">الدروس</a>
      <a href="/articles/">المقالات</a>
      <a href="/interview/">أسئلة مقابلات</a>
      <a href="/glossary/">قاموس المصطلحات</a>
    </nav>

    <nav class="col" aria-label="روابط المنصة">
      <h3 class="ttl">المنصة</h3>
      <a href="/start/">ابدأ من هنا</a>
      <a href="/resources/">الموارد والقوالب</a>
      <a href="/store/" class="store">المتجر</a>
      <a href="/news/">آخر الأخبار</a>
      <a href="/about/">عن المنصة</a>
      <a href="/contact/">تواصل معنا</a>
    </nav>
  </div>

  <div class="wrap bottom">
    <span class="copy">© {year} {site.name}</span>
    <nav class="legal" aria-label="معلومات">
      <a href="/privacy/">سياسة الخصوصية</a>
      <a href="/terms/">الشروط والأحكام</a>
      <button class="footer-link" type="button" data-analytics-settings>إعدادات التحليلات</button>
    </nav>
    {site.footerNote && <span class="made">{site.footerNote}</span>}
  </div>
</footer>

<style>
  .site-foot { background: var(--navy); border-top: 1px solid var(--line); margin-top: 40px; }
  .inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 32px;
    padding-block: 38px 28px;
  }
  .brand-col { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .tag { color: var(--muted); font-size: 15px; max-width: 42ch; margin: 0; }
  .social { display: flex; flex-wrap: wrap; gap: 8px; }
  .social a {
    width: 36px; height: 36px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid var(--line); color: var(--muted);
    transition: color .2s, border-color .2s;
  }
  .social a:hover { color: var(--cyan); border-color: var(--cyan); }

  .col { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .col a { color: var(--muted); font-size: 15px; }
  .col a:hover { color: var(--cyan); }
  .col a.store { color: #F6823B; }
  .ttl { font-size: 14px; color: var(--ink); margin: 0 0 2px; }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px 20px;
    flex-wrap: wrap;
    padding-block: 16px 24px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--faint);
  }
  .legal { display: flex; flex-wrap: wrap; gap: 6px 16px; }
  .legal a, .footer-link { color: var(--faint); font-size: 13px; }
  .footer-link {
    border: 0; padding: 0; background: transparent;
    font: inherit; font-size: 13px; cursor: pointer;
  }
  .legal a:hover, .footer-link:hover { color: var(--cyan); }

  @media (max-width: 820px) {
    .inner { grid-template-columns: 1fr 1fr; gap: 26px 20px; }
    .brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .inner { padding-block: 28px 20px; gap: 22px 16px; }
    .brand-col { align-items: center; text-align: center; }
    .tag { font-size: 14px; }
    .col a { font-size: 14px; }
    .bottom { flex-direction: column; justify-content: center; text-align: center; padding-block: 14px 22px; }
    .legal { justify-content: center; }
  }
</style>
