---
/**
 * مساعد الموقع — بوت أسئلة QA / testing فقط.
 * بيتصل بـ /api/chat (Workers AI). الشكل معتمد من المستخدم.
 *
 * لإطفاء البوت مؤقتاً: بدّل السطر التالي لـ false.
 */
const CHATBOT_ENABLED = true;
---

{CHATBOT_ENABLED && (
  <>
    <button class="tachat-launcher" id="tachat-launcher" type="button" aria-label="افتح مساعد الأسئلة">
      <svg class="tachat-rbt-sm" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 6v5" stroke="#fff" stroke-width="2.6" stroke-linecap="round"/><circle cx="24" cy="4.5" r="2.4" fill="#fff"/><rect x="4.5" y="20" width="4" height="10" rx="2" fill="#ffd9c2"/><rect x="39.5" y="20" width="4" height="10" rx="2" fill="#ffd9c2"/><rect x="9" y="12" width="30" height="26" rx="9" fill="#fff"/><rect x="13.5" y="17.5" width="21" height="15" rx="6.5" fill="#0a1428"/><circle class="tachat-eye" cx="19.5" cy="24" r="2.7" fill="#f6823b"/><circle class="tachat-eye" cx="28.5" cy="24" r="2.7" fill="#f6823b"/><path d="M19.5 28.6c2.7 2 6.3 2 9 0" stroke="#f6823b" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span>اسأل Testo</span>
    </button>

    <section class="tachat-panel" id="tachat-panel" aria-label="مساعد الأسئلة" hidden>
      <div class="tachat-head">
        <span class="tachat-av" aria-hidden="true"><svg class="tachat-rbt" viewBox="0 0 48 48" fill="none"><path d="M24 6v5" stroke="#f6823b" stroke-width="2.6" stroke-linecap="round"/><circle cx="24" cy="4.5" r="2.4" fill="#ff9a57"/><rect x="4.5" y="20" width="4" height="10" rx="2" fill="#e56b1f"/><rect x="39.5" y="20" width="4" height="10" rx="2" fill="#e56b1f"/><rect x="9" y="12" width="30" height="26" rx="9" fill="#f6823b"/><rect x="13.5" y="17.5" width="21" height="15" rx="6.5" fill="#0a1428"/><circle class="tachat-eye" cx="19.5" cy="24" r="2.7" fill="#38bdf8"/><circle class="tachat-eye" cx="28.5" cy="24" r="2.7" fill="#38bdf8"/><path d="M19.5 28.6c2.7 2 6.3 2 9 0" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round"/></svg></span>
        <div class="tachat-tt">
          <b>Testo <span class="tachat-name-sub">· مساعد الاختبار</span></b>
          <small><span class="tachat-dot"></span> بجاوب أسئلة الـ QA و الـ testing</small>
        </div>
        <button class="tachat-x" id="tachat-close" type="button" aria-label="إغلاق">✕</button>
      </div>

      <div class="tachat-disc">🤖 مساعد ذكي — مصمّم لأسئلة الـ QA / testing فقط. تأكّد من المعلومة قبل الاعتماد عليها.</div>

      <div class="tachat-msgs" id="tachat-msgs"></div>

      <div class="tachat-input">
        <input id="tachat-inp" type="text" maxlength="500" placeholder="اكتب سؤالك عن الـ QA…" autocomplete="off" aria-label="سؤالك">
        <button class="tachat-send" id="tachat-send" type="button" aria-label="إرسال">➤</button>
      </div>
    </section>

    <style is:global>
      .tachat-launcher{
        position:fixed; bottom:24px; right:24px; z-index:60;
        display:flex; align-items:center; gap:9px;
        background:linear-gradient(135deg,#f6823b,#e56b1f); color:#fff; border:none; cursor:pointer;
        padding:12px 17px 12px 14px; border-radius:999px; font-family:inherit; font-weight:700; font-size:14.5px;
        box-shadow:0 10px 30px rgba(246,130,59,.45); animation:tachat-pulse 3.2s ease-in-out infinite;
      }
      .tachat-launcher:hover{filter:brightness(1.05)}
      @keyframes tachat-pulse{0%,100%{box-shadow:0 10px 30px rgba(246,130,59,.35)}50%{box-shadow:0 10px 38px rgba(246,130,59,.62)}}
      .tachat-rbt-sm{width:24px;height:24px}
      .tachat-rbt{width:42px;height:42px;filter:drop-shadow(0 3px 8px rgba(246,130,59,.35))}
      .tachat-eye{transform-box:fill-box;transform-origin:center;animation:tachat-blink 4.2s infinite}
      @keyframes tachat-blink{0%,93%,100%{transform:scaleY(1)}96.5%{transform:scaleY(.12)}}

      .tachat-panel{
        position:fixed; bottom:24px; right:24px; z-index:61; width:380px; max-width:calc(100vw - 32px);
        height:min(600px, calc(100vh - 48px));
        background:var(--surface,#12213d); border:1px solid var(--line,rgba(56,189,248,.16)); border-radius:20px;
        display:flex; flex-direction:column; overflow:hidden; box-shadow:0 24px 70px rgba(0,0,0,.55);
        font-family:inherit; color:var(--ink,#e8eef9);
      }
      .tachat-panel[hidden]{display:none}
      .tachat-head{padding:14px 15px; border-bottom:1px solid var(--line,rgba(56,189,248,.16));
        background:linear-gradient(180deg,rgba(246,130,59,.14),transparent); display:flex; align-items:center; gap:11px}
      .tachat-av{width:44px;height:44px;flex:0 0 auto;display:grid;place-items:center}
      .tachat-tt{flex:1;min-width:0}
      .tachat-tt b{display:block;font-size:15px;font-weight:800}
      .tachat-name-sub{font-size:12px;font-weight:500;color:var(--muted,#93a4c0)}
      .tachat-tt small{display:flex;align-items:center;gap:6px;color:var(--muted,#93a4c0);font-size:12px;margin-top:2px}
      .tachat-dot{width:7px;height:7px;border-radius:50%;background:#34d399;box-shadow:0 0 0 3px rgba(52,211,153,.18)}
      .tachat-x{background:none;border:none;color:var(--muted,#93a4c0);font-size:19px;cursor:pointer;padding:4px 8px;border-radius:8px;line-height:1}
      .tachat-x:hover{background:rgba(255,255,255,.06);color:var(--ink,#e8eef9)}
      .tachat-disc{font-size:11.5px;color:var(--muted,#93a4c0);text-align:center;padding:8px 14px;
        background:rgba(56,189,248,.06);border-bottom:1px solid var(--line,rgba(56,189,248,.16))}

      .tachat-msgs{flex:1;overflow-y:auto;padding:16px 14px;display:flex;flex-direction:column;gap:12px}
      .tachat-msgs::-webkit-scrollbar{width:7px}
      .tachat-msgs::-webkit-scrollbar-thumb{background:rgba(56,189,248,.22);border-radius:8px}
      .tachat-row{display:flex;gap:9px;max-width:100%}
      .tachat-row.me{flex-direction:row-reverse}
      .tachat-mini{width:30px;height:30px;flex:0 0 auto;display:grid;place-items:center}
      .tachat-mini .tachat-rbt{width:27px;height:27px}
      .tachat-bub{padding:11px 13px;border-radius:14px;font-size:13.8px;line-height:1.8;max-width:80%;white-space:pre-wrap;word-wrap:break-word}
      .tachat-row.bot .tachat-bub{background:var(--navy,#0d1b33);border:1px solid var(--line,rgba(56,189,248,.16));border-top-right-radius:5px}
      .tachat-row.me .tachat-bub{background:linear-gradient(135deg,#f6823b,#e56b1f);color:#fff;border-top-left-radius:5px}
      .tachat-src{display:flex;flex-direction:column;gap:6px;margin-top:10px}
      .tachat-src-cap{font-size:11.5px;color:var(--muted,#93a4c0);font-weight:600;margin-bottom:1px}
      .tachat-src a{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;color:#ff9a57;text-decoration:none;
        background:rgba(246,130,59,.12);border:1px solid rgba(246,130,59,.3);padding:6px 10px;border-radius:9px}
      .tachat-src a:hover{background:rgba(246,130,59,.2)}

      .tachat-input{padding:11px 13px;border-top:1px solid var(--line,rgba(56,189,248,.16));display:flex;gap:9px;align-items:center}
      /* 16px عن قصد: iOS بيكبّر الصفحة تلقائياً لو أصغر من هيك عند الكتابة */
      .tachat-input input{flex:1;background:var(--bg,#0a1428);border:1px solid var(--line,rgba(56,189,248,.16));border-radius:12px;
        color:var(--ink,#e8eef9);font-family:inherit;font-size:16px;padding:11px 14px;outline:none}
      .tachat-input input:focus{border-color:#f6823b}
      .tachat-send{background:linear-gradient(135deg,#f6823b,#e56b1f);border:none;color:#fff;width:44px;height:44px;
        border-radius:12px;cursor:pointer;font-size:17px;flex:0 0 auto;display:grid;place-items:center}
      .tachat-send:disabled{opacity:.5;cursor:default}
      .tachat-foot{text-align:center;font-size:10.5px;color:var(--muted,#93a4c0);padding:0 0 9px}

      .tachat-typing{display:flex;gap:4px;padding:4px 2px}
      .tachat-typing i{width:7px;height:7px;border-radius:50%;background:var(--muted,#93a4c0);animation:tachat-bl 1.2s infinite}
      .tachat-typing i:nth-child(2){animation-delay:.2s}.tachat-typing i:nth-child(3){animation-delay:.4s}
      @keyframes tachat-bl{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-3px)}}

      @media (max-width:520px){
        .tachat-launcher{bottom:16px;right:16px}
        /* على الموبايل: شاشة كاملة، وارتفاعها بيتظبّط بالـ JS حسب المساحة الظاهرة (بدون ما يغطّيها الـ keyboard) */
        .tachat-panel{top:0;right:0;left:0;bottom:auto;width:auto;max-width:none;height:100dvh;border-radius:0}
        .tachat-head{padding-top:calc(14px + env(safe-area-inset-top,0px))}
        .tachat-input{padding-bottom:calc(11px + env(safe-area-inset-bottom,0px))}
      }
      @media (prefers-reduced-motion:reduce){
        .tachat-launcher,.tachat-eye,.tachat-typing i{animation:none}
      }
    </style>

    <script>
      (function () {
        var launcher = document.getElementById('tachat-launcher');
        var panel = document.getElementById('tachat-panel');
        var closeBtn = document.getElementById('tachat-close');
        var msgs = document.getElementById('tachat-msgs');
        var inp = document.getElementById('tachat-inp');
        var send = document.getElementById('tachat-send');
        if (!launcher || !panel || !msgs || !inp || !send) return;

        var ROBOT =
          '<svg class="tachat-rbt" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 6v5" stroke="#f6823b" stroke-width="2.6" stroke-linecap="round"/><circle cx="24" cy="4.5" r="2.4" fill="#ff9a57"/><rect x="4.5" y="20" width="4" height="10" rx="2" fill="#e56b1f"/><rect x="39.5" y="20" width="4" height="10" rx="2" fill="#e56b1f"/><rect x="9" y="12" width="30" height="26" rx="9" fill="#f6823b"/><rect x="13.5" y="17.5" width="21" height="15" rx="6.5" fill="#0a1428"/><circle class="tachat-eye" cx="19.5" cy="24" r="2.7" fill="#38bdf8"/><circle class="tachat-eye" cx="28.5" cy="24" r="2.7" fill="#38bdf8"/><path d="M19.5 28.6c2.7 2 6.3 2 9 0" stroke="#38bdf8" stroke-width="1.8" stroke-linecap="round"/></svg>';

        var started = false;
        var pending = false;
        var vv = window.visualViewport;

        function scroll() { msgs.scrollTop = msgs.scrollHeight; }

        function isMobile() { return window.innerWidth <= 520; }

        // على الموبايل بنقيس المساحة الظاهرة فعلياً (اللي فوق الـ keyboard) ونثبّت البانل عليها
        function fit() {
          if (panel.hidden) return;
          if (!isMobile() || !vv) { panel.style.height = ''; panel.style.top = ''; return; }
          panel.style.height = vv.height + 'px';
          panel.style.top = vv.offsetTop + 'px';
          scroll();
        }

        function greet() {
          if (started) return;
          started = true;
          botBubble(
            'أهلين! أنا Testo، مساعد المنصة 👋\nاسألني أي إشي عن الـ QA و الـ testing — المصطلحات، الدورات، أو مفاهيم عامة. أنا مصمّم لهالمجال بس.',
            []
          );
        }

        function open() {
          panel.hidden = false;
          launcher.style.display = 'none';
          if (isMobile()) {
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
          }
          if (vv) {
            vv.addEventListener('resize', fit);
            vv.addEventListener('scroll', fit);
          }
          window.addEventListener('resize', fit);
          greet();
          fit();
          setTimeout(function () { inp.focus(); scroll(); }, 60);
        }
        function close() {
          panel.hidden = true;
          launcher.style.display = '';
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          panel.style.height = '';
          panel.style.top = '';
          if (vv) {
            vv.removeEventListener('resize', fit);
            vv.removeEventListener('scroll', fit);
          }
          window.removeEventListener('resize', fit);
        }

        launcher.addEventListener('click', open);
        closeBtn.addEventListener('click', close);
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !panel.hidden) close();
        });

        function userBubble(text) {
          var row = document.createElement('div');
          row.className = 'tachat-row me';
          var b = document.createElement('div');
          b.className = 'tachat-bub';
          b.textContent = text;
          row.appendChild(b);
          msgs.appendChild(row);
          scroll();
        }

        function botBubble(text, sources) {
          var row = document.createElement('div');
          row.className = 'tachat-row bot';
          var mini = document.createElement('div');
          mini.className = 'tachat-mini';
          mini.innerHTML = ROBOT;
          var b = document.createElement('div');
          b.className = 'tachat-bub';
          b.textContent = text;
          if (sources && sources.length) {
            var box = document.createElement('div');
            box.className = 'tachat-src';
            var cap = document.createElement('div');
            cap.className = 'tachat-src-cap';
            cap.textContent = 'ذات صلة:';
            box.appendChild(cap);
            sources.forEach(function (s) {
              if (!s || !s.url) return;
              var a = document.createElement('a');
              a.href = s.url;
              a.textContent = '📖 ' + (s.title || 'من المنصة');
              box.appendChild(a);
            });
            b.appendChild(box);
          }
          row.appendChild(mini);
          row.appendChild(b);
          msgs.appendChild(row);
          scroll();
        }

        function showTyping() {
          var row = document.createElement('div');
          row.className = 'tachat-row bot';
          row.id = 'tachat-typing';
          var mini = document.createElement('div');
          mini.className = 'tachat-mini';
          mini.innerHTML = ROBOT;
          var b = document.createElement('div');
          b.className = 'tachat-bub';
          b.innerHTML = '<div class="tachat-typing"><i></i><i></i><i></i></div>';
          row.appendChild(mini);
          row.appendChild(b);
          msgs.appendChild(row);
          scroll();
        }
        function hideTyping() {
          var t = document.getElementById('tachat-typing');
          if (t) t.remove();
        }

        function ask() {
          var q = (inp.value || '').trim();
          if (!q || pending) return;
          pending = true;
          send.disabled = true;
          userBubble(q);
          inp.value = '';
          showTyping();

          fetch('/api/chat', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ message: q, page: location.pathname }),
          })
            .then(function (r) { return r.json(); })
            .then(function (data) {
              hideTyping();
              if (data && data.reply) {
                botBubble(data.reply, data.sources || []);
              } else {
                botBubble('صار في خطأ بسيط 🙏 جرّب مرة تانية.', []);
              }
            })
            .catch(function () {
              hideTyping();
              botBubble('ما قدرت أوصل للمساعد هلأ 🙏 تأكّد من النت وجرّب كمان مرة.', []);
            })
            .then(function () {
              pending = false;
              send.disabled = false;
              inp.focus();
            });
        }

        send.addEventListener('click', ask);
        inp.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') { e.preventDefault(); ask(); }
        });
      })();
    </script>
  </>
)}
