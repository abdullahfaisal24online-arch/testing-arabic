---
import Icon from './Icon.astro';

interface Props {
  settings: {
    homeBadge: string;
    homeTitle: string;
    homeText: string;
    homeCta: string;
    durationSeconds: number;
    bugs: unknown[];
  };
}

const { settings } = Astro.props;
---

<section class="section bug-promo-section" aria-labelledby="bug-promo-title">
  <div class="wrap">
    <a class="bug-promo" href="/bug-hunter/">
      <div class="bug-promo-copy">
        <span class="bug-promo-badge"><span aria-hidden="true">●</span> {settings.homeBadge}</span>
        <h2 id="bug-promo-title">{settings.homeTitle}</h2>
        <p>{settings.homeText}</p>
        <div class="bug-promo-meta" aria-label="تفاصيل اللعبة">
          <span><Icon name="clock" size={17} /> {settings.durationSeconds} ثانية</span>
          <span><Icon name="bug" size={18} /> {settings.bugs.length} Bugs</span>
          <span><Icon name="check" size={17} /> بدون تسجيل</span>
        </div>
        <span class="btn btn-primary bug-promo-cta">{settings.homeCta} <Icon name="arrow" size={19} /></span>
      </div>

      <div class="bug-promo-scene" aria-hidden="true">
        <div class="promo-window">
          <div class="promo-window-bar"><i></i><i></i><i></i><span>the-broken-shop.test</span></div>
          <div class="promo-store">
            <div class="promo-product">
              <div class="promo-broken">▧</div>
              <b>Wireless Headphones</b>
              <span>$29.00</span>
              <em>ADD TO CART</em>
            </div>
            <div class="promo-cart">
              <strong>CART</strong>
              <small>Subtotal</small><b>$29.00</b>
              <small>Shipping</small><b>$4.00</b>
              <hr />
              <small>Total</small><b class="bad-total">$42.80</b>
              <em>CHECKOUT</em>
            </div>
            <span class="promo-bug b1">🐞</span>
            <span class="promo-bug b2">🐞</span>
            <span class="promo-bug b3">🐞</span>
          </div>
        </div>
        <span class="promo-score">+100</span>
      </div>
    </a>
  </div>
</section>

<style>
  .bug-promo-section { padding-top: 22px; }
  .bug-promo {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, .95fr);
    min-height: 410px;
    overflow: hidden;
    border: 1px solid rgba(56, 189, 248, .42);
    border-radius: 24px;
    background:
      radial-gradient(circle at 76% 10%, rgba(56, 189, 248, .18), transparent 29%),
      linear-gradient(130deg, #101f3d 0%, #0c1930 62%, #081327 100%);
    box-shadow: 0 25px 65px rgba(2, 8, 23, .3), inset 0 1px rgba(255,255,255,.04);
    color: #eaf3ff;
  }
  .bug-promo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: .35;
    background-image: radial-gradient(circle at 1px 1px, rgba(56, 189, 248, .2) 1px, transparent 0);
    background-size: 25px 25px;
    mask-image: linear-gradient(90deg, #000, transparent 48%);
  }
  .bug-promo:hover { color: #fff; transform: translateY(-2px); border-color: #38bdf8; }
  .bug-promo-copy { padding: clamp(34px, 5vw, 62px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
  .bug-promo-badge { display: inline-flex; gap: 9px; align-items: center; color: #ff9b5d; font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: .5px; }
  .bug-promo-badge span { color: #fb4f4f; text-shadow: 0 0 12px #fb4f4f; }
  .bug-promo h2 { margin-top: 12px; color: #fff; font-size: clamp(28px, 3.2vw, 43px); }
  .bug-promo p { max-width: 620px; margin-top: 13px; color: #b9c9df; font-size: 17px; line-height: 1.85; }
  .bug-promo-meta { display: flex; flex-wrap: wrap; gap: 13px 22px; margin-top: 23px; color: #d6e3f4; font-size: 14px; }
  .bug-promo-meta span { display: flex; align-items: center; gap: 7px; }
  .bug-promo-meta :global(svg) { color: #38bdf8; }
  .bug-promo-cta { margin-top: 27px; }
  .bug-promo-scene { position: relative; display: grid; place-items: center; padding: 45px 42px 45px 0; direction: ltr; }
  .promo-window { width: min(100%, 480px); overflow: hidden; border: 1px solid rgba(125,211,252,.32); border-radius: 14px; background: #f8fafc; box-shadow: 0 28px 55px rgba(0,0,0,.4); transform: rotate(-2deg); }
  .promo-window-bar { height: 34px; padding: 0 12px; display: flex; align-items: center; gap: 6px; background: #17233a; color: #7f91ab; font: 9px 'IBM Plex Mono', monospace; }
  .promo-window-bar i { width: 7px; height: 7px; border-radius: 50%; background: #fb5b5b; }
  .promo-window-bar i:nth-child(2) { background: #fbbf24; }
  .promo-window-bar i:nth-child(3) { background: #34d399; margin-right: 8px; }
  .promo-store { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 18px; min-height: 245px; padding: 27px; color: #0d1b33; }
  .promo-product, .promo-cart { display: flex; flex-direction: column; padding: 13px; border: 1px solid #dfe7f2; border-radius: 9px; background: #fff; }
  .promo-broken { display: grid; place-items: center; height: 86px; margin-bottom: 10px; background: #eef2f7; color: #e33b3b; font-size: 36px; }
  .promo-product b { font-size: 11px; }
  .promo-product span { margin-top: 3px; color: #0a75a8; font: 700 13px 'IBM Plex Mono', monospace; }
  .promo-product em, .promo-cart em { margin-top: auto; padding: 7px; border-radius: 5px; background: #bdd8e2; color: #a9c0c9; font: 700 8px 'IBM Plex Mono', monospace; text-align: center; }
  .promo-cart { display: grid; grid-template-columns: 1fr auto; gap: 7px; font: 10px 'IBM Plex Mono', monospace; }
  .promo-cart strong, .promo-cart hr, .promo-cart em { grid-column: 1 / -1; }
  .promo-cart hr { width: 100%; border: 0; border-top: 1px solid #dfe7f2; }
  .promo-cart .bad-total { color: #dc2626; }
  .promo-cart em { align-self: end; background: #f6823b; color: #fff; }
  .promo-bug { position: absolute; z-index: 3; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: #fee2e2; border: 2px solid #ef4444; font-size: 16px; box-shadow: 0 0 0 5px rgba(239,68,68,.12); animation: promo-pulse 1.6s infinite; }
  .b1 { top: 39px; left: 35px; }
  .b2 { right: 26px; top: 112px; animation-delay: -.5s; }
  .b3 { bottom: 23px; left: 48%; animation-delay: -1s; }
  .promo-score { position: absolute; top: 15%; left: 2%; padding: 5px 10px; border-radius: 7px; background: #16a34a; color: white; font: 700 16px 'IBM Plex Mono', monospace; transform: rotate(8deg); box-shadow: 0 10px 20px rgba(22,163,74,.3); }
  @keyframes promo-pulse { 50% { transform: scale(1.13); box-shadow: 0 0 0 9px rgba(239,68,68,0); } }
  @media (max-width: 900px) {
    .bug-promo { grid-template-columns: 1fr; }
    .bug-promo-scene { min-height: 345px; padding: 0 28px 40px; }
    .promo-score { left: 8%; }
  }
  @media (max-width: 560px) {
    .bug-promo-copy { padding: 30px 24px; }
    .bug-promo-scene { min-height: 285px; padding-inline: 18px; }
    .promo-window { transform: none; }
    .promo-store { min-height: 205px; padding: 16px; gap: 10px; }
    .promo-broken { height: 63px; }
  }
</style>
