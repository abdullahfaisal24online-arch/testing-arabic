---
/**
 * أسئلة العيّنة التفاعلية. بتوصلها بس أسئلة العيّنة (الباقي ما بيوصل للمتصفح).
 * كل النصوص جاية من «إعدادات المتجر» بلوحة التحكم.
 */
import type { BankItem } from '../../lib/banks';
import { tpl } from '../../lib/store';

interface Labels { next: string; finish: string; correct: string; wrong: string; english: string; done: string; doneText: string }
interface Props { items: BankItem[]; total: number; labels: Labels }
const { items, total, labels } = Astro.props;
const n = items.length;
---

<div class="sq" data-sq data-wrong={labels.wrong} data-next={labels.next} data-finish={labels.finish}
  data-done={tpl(labels.done, { n, total })} data-correct={labels.correct}>
  <div class="sq-top">
    <span class="sq-num" data-num>1 / {n}</span>
    <div class="sq-bar"><i data-bar></i></div>
    <span class="sq-score"><b data-score>0</b> ✓</span>
  </div>

  {items.map((it, i) => (
    <article class="sq-q" data-q={i} data-a={it.a} hidden={i !== 0}>
      <span class="sq-ch">Chapter {it.ch}</span>
      <h2 class="sq-en" dir="ltr">{it.q}</h2>
      {it.qAr && <p class="sq-ar">{it.qAr}</p>}
      <div class="sq-opts" dir="ltr">
        {Object.entries(it.o).map(([k, v]) => (
          <button type="button" class="sq-opt" data-k={k}><b>{k}</b><span>{v}</span></button>
        ))}
      </div>
      <div class="sq-ex" data-ex hidden>
        <p class="sq-verdict" data-verdict></p>
        {it.exAr ? <p class="sq-exar">{it.exAr}</p> : <p class="sq-exar" dir="ltr">{it.exEn}</p>}
        {it.exAr && <details><summary>{labels.english}</summary><p dir="ltr">{it.exEn}</p></details>}
      </div>
    </article>
  ))}

  <div class="sq-nav">
    <button type="button" class="btn btn-primary btn-sm" data-go disabled>{n > 1 ? labels.next : labels.finish}</button>
  </div>

  <div class="sq-end" data-end hidden>
    <p class="sq-done" data-donemsg></p>
    {labels.doneText && <p class="sq-more">{tpl(labels.doneText, { n, total })}</p>}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sq]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLElement>('.sq-q')];
    const go = root.querySelector<HTMLButtonElement>('[data-go]')!;
    const num = root.querySelector<HTMLElement>('[data-num]')!;
    const bar = root.querySelector<HTMLElement>('[data-bar]')!;
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const end = root.querySelector<HTMLElement>('[data-end]')!;
    const nav = root.querySelector<HTMLElement>('.sq-nav')!;
    const L = root.dataset;
    let cur = 0, score = 0;

    const paint = () => {
      num.textContent = `${Math.min(cur + 1, qs.length)} / ${qs.length}`;
      bar.style.width = `${(Math.min(cur + (qs[cur]?.dataset.done ? 1 : 0), qs.length) / qs.length) * 100}%`;
      scoreEl.textContent = String(score);
    };

    qs.forEach((q) =>
      q.querySelectorAll<HTMLButtonElement>('.sq-opt').forEach((b) =>
        b.addEventListener('click', () => {
          if (q.dataset.done) return;
          q.dataset.done = '1';
          const ok = b.dataset.k === q.dataset.a;
          if (ok) score++;
          q.querySelectorAll<HTMLButtonElement>('.sq-opt').forEach((o) => {
            o.disabled = true;
            if (o.dataset.k === q.dataset.a) o.classList.add('ok');
            else if (o === b) o.classList.add('bad');
          });
          const v = q.querySelector<HTMLElement>('[data-verdict]')!;
          v.textContent = ok ? L.correct! : L.wrong!.replace('{a}', q.dataset.a!);
          v.className = 'sq-verdict ' + (ok ? 'ok' : 'bad');
          q.querySelector<HTMLElement>('[data-ex]')!.hidden = false;
          go.disabled = false;
          go.textContent = cur === qs.length - 1 ? L.finish! : L.next!;
          paint();
          window.taTrack?.('store_sample_answer', { q: cur + 1, ok });
        }),
      ),
    );

    go.addEventListener('click', () => {
      qs[cur].hidden = true;
      cur++;
      go.disabled = true;
      if (cur >= qs.length) {
        nav.hidden = true;
        end.hidden = false;
        root.querySelector<HTMLElement>('[data-donemsg]')!.textContent = L.done!.replace('{score}', String(score));
        window.taTrack?.('store_sample_done', { score });
      } else {
        qs[cur].hidden = false;
      }
      paint();
      root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    paint();
  });
</script>

<style>
  .sq { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 22px; scroll-margin-top: 90px; }
  .sq-top { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .sq-num, .sq-score { font-size: 14px; font-weight: 700; white-space: nowrap; }
  .sq-num { color: var(--muted); direction: ltr; }
  .sq-score { color: #34d399; }
  .sq-bar { flex: 1; height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .sq-bar i { display: block; height: 100%; width: 0; background: var(--cyan); transition: width .3s ease; }
  .sq-ch { display: inline-block; font-size: 12.5px; font-weight: 700; color: var(--cyan); background: var(--cyan-soft); padding: 2px 12px; border-radius: 999px; direction: ltr; }
  .sq-en { font-size: 19px; line-height: 1.55; margin: 12px 0 6px; text-align: left; }
  .sq-ar { color: var(--muted); font-size: 15px; line-height: 1.8; margin: 0 0 16px; }
  .sq-opts { display: grid; gap: 10px; margin-top: 12px; }
  .sq-opt { font: inherit; display: flex; gap: 12px; align-items: flex-start; text-align: left; width: 100%; padding: 12px 14px; border-radius: 12px;
    border: 1.5px solid var(--line-strong); background: transparent; color: var(--ink); cursor: pointer; font-size: 15px; line-height: 1.6; transition: border-color .15s, background .15s; }
  .sq-opt b { flex: none; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--faint); display: grid; place-items: center; font-size: 13px; }
  .sq-opt:not(:disabled):hover { border-color: var(--cyan); background: var(--cyan-soft); }
  .sq-opt:disabled { cursor: default; opacity: .6; }
  .sq-opt.ok { opacity: 1; border-color: #34d399; background: rgba(52, 211, 153, .12); }
  .sq-opt.ok b { background: #34d399; border-color: #34d399; color: #052e1f; }
  .sq-opt.bad { opacity: 1; border-color: #f87171; background: rgba(248, 113, 113, .1); }
  .sq-opt.bad b { background: #f87171; border-color: #f87171; color: #2a0909; }
  .sq-ex { margin-top: 16px; padding: 14px 16px; border-radius: 14px; background: var(--navy); border: 1px solid var(--line); }
  .sq-verdict { font-weight: 700; margin: 0 0 6px; }
  .sq-verdict.ok { color: #34d399; } .sq-verdict.bad { color: #f87171; }
  .sq-exar { margin: 0; line-height: 1.9; }
  .sq-ex details { margin-top: 8px; font-size: 14px; color: var(--muted); }
  .sq-ex summary { cursor: pointer; color: var(--cyan); }
  .sq-ex details p { margin: 6px 0 0; text-align: left; line-height: 1.7; }
  .sq-nav { display: flex; justify-content: flex-end; margin-top: 16px; }
  .sq-nav[hidden], .sq-end[hidden], .sq-ex[hidden], .sq-q[hidden] { display: none; }
  .sq-nav .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
  .sq-end { text-align: center; padding: 18px 0 6px; }
  .sq-done { font-size: 20px; font-weight: 700; margin: 0 0 6px; }
  .sq-more { color: var(--muted); line-height: 1.8; margin: 0; }
  @media (max-width: 600px) { .sq { padding: 16px; } .sq-en { font-size: 17px; } .sq-opt { font-size: 14.5px; } }
</style>
