---
// CursorFx — مؤشر مثلّث 🔻 فوق العناصر القابلة للنقر + موجة مثلّث عند النقر.
// يُستدعى مرة وحدة من الـ layout الأساسي: <CursorFx />
// لا يشتغل على اللمس، ولا مع من فعّل «تقليل الحركة» بنظامه.
//
// ملاحظة على !important: ستايلات الموقع بتحدّد cursor: pointer على كلاسات
// (.btn و .icon-btn و .chip و .sol summary)، وأي كلاس بيتغلّب على مُحدِّد
// العنصر (button, a) بقواعد الأولوية بالـ CSS. بدون !important المثلّث
// بينطبق بس على العناصر اللي ما عندها قاعدة خاصة — وهاد اللي كان بيصير.
---

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    a[href], area[href], button, summary, label[for], select,
    [role="button"], [role="link"], [role="tab"], [role="menuitem"], [role="option"],
    input[type="submit"], input[type="button"], input[type="reset"],
    input[type="checkbox"], input[type="radio"], input[type="file"], input[type="color"],
    .btn, .icon-btn, .chip, .tri-cursor {
      cursor: url("data:image/png;base64,") 3 5, pointer !important;
    }

    /* استثناء مقصود: روابط قاموس المصطلحات بتضل مؤشر «مساعدة» زي ما هي بالتصميم */
    a.glossary-link,
    .prose a.glossary-link {
      cursor: help !important;
    }

    /* العناصر المعطّلة ترجع لمؤشرها الطبيعي */
    button:disabled,
    input:disabled,
    select:disabled,
    textarea:disabled,
    a[aria-disabled="true"],
    button[aria-disabled="true"],
    [role="button"][aria-disabled="true"] {
      cursor: not-allowed !important;
    }

    /* لا نسرق مؤشر الكتابة داخل الحقول النصية */
    input[type="text"], input[type="email"], input[type="search"],
    input[type="url"], input[type="tel"], input[type="password"],
    input[type="number"], input[type="date"], textarea,
    [contenteditable="true"] {
      cursor: text !important;
    }
  }

  .tri-ripple {
    position: fixed;
    z-index: 2147483000;
    width: 40px;
    height: 36px;
    pointer-events: none;
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }

  .tri-ripple svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .tri-ripple polygon {
    fill: none;
    stroke: #dd2e44;
    stroke-width: 3;
    stroke-linejoin: round;
  }
</style>

<script>
  (() => {
    const CLICKABLE = [
      'a[href]', 'area[href]', 'button', 'summary', 'label[for]', 'select',
      '[role="button"]', '[role="link"]', '[role="tab"]', '[role="menuitem"]', '[role="option"]',
      'input[type="submit"]', 'input[type="button"]', 'input[type="reset"]',
      'input[type="checkbox"]', 'input[type="radio"]', 'input[type="file"]', 'input[type="color"]',
      '.btn', '.icon-btn', '.chip', '.tri-cursor',
    ].join(', ');

    // نفس استثناءات الـ CSS: هدول ما بيطلع عليهم مثلّث، فما بيطلع عليهم موجة
    const EXEMPT = '.glossary-link, :disabled, [aria-disabled="true"]';

    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const MAX_LIVE = 4;
    let live = 0;

    function ripple(x, y) {
      const el = document.createElement('span');
      el.className = 'tri-ripple';
      el.setAttribute('aria-hidden', 'true');
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      el.innerHTML = '<svg viewBox="0 0 40 36" focusable="false"><polygon points="20,33 2,3 38,3" /></svg>';

      document.body.appendChild(el);
      live++;

      let settled = false;
      const done = () => {
        if (settled) return;
        settled = true;
        el.remove();
        live--;
      };

      // شبكة أمان: لو المتصفح جمّد الأنيميشن (تاب بالخلفية مثلاً) وحدث finish
      // ما انطلق، بننضّف العنصر على أي حال بدل ما يضل معلّق
      setTimeout(done, 1500);

      if (typeof el.animate !== 'function') {
        done();
        return;
      }

      el.animate(
        [
          { transform: 'translate(-50%, -50%) scale(0.35)', opacity: 0.85 },
          { transform: 'translate(-50%, -50%) scale(1.5)', opacity: 0 },
        ],
        { duration: 340, easing: 'cubic-bezier(.22,.61,.36,1)' },
      ).addEventListener('finish', done, { once: true });
    }

    document.addEventListener(
      'pointerdown',
      (e) => {
        if (e.button !== 0 || e.pointerType !== 'mouse') return;
        if (!finePointer.matches || reduceMotion.matches) return;
        if (live >= MAX_LIVE) return;

        const hit = e.target instanceof Element ? e.target.closest(CLICKABLE) : null;
        if (!hit) return;
        if (hit.matches(EXEMPT)) return;

        ripple(e.clientX, e.clientY);
      },
      { passive: true },
    );
  })();
</script>
