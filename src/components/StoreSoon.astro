---
// نافذة "المتجر — قريباً"
// بتعترض الضغط على رابط المتجر بالقائمة (سطح المكتب + الموبايل) وبتطلّع Popup
// بدل ما تفتح صفحة المتجر. صفحة /store/ نفسها مسكّرة كـ "قريباً" (src/pages/store/index.astro).
// للرجوع لمتجر شغّال: احذف <StoreSoon /> من Base.astro وارجّع صفحة المتجر من git history.
---

<script is:inline>
  (function () {
    function openStoreSoon() {
      if (document.getElementById('storeSoon')) return;
      var o = document.createElement('div');
      o.id = 'storeSoon';
      o.innerHTML =
        '<div class="ss-box" role="dialog" aria-modal="true" aria-label="المتجر قريباً">' +
          '<button class="ss-x" type="button" aria-label="إغلاق">✕</button>' +
          '<span class="ss-badge"><span class="ss-dot"></span>قريباً</span>' +
          '<h3>المتجر <span class="ss-tri">🔻</span></h3>' +
          '<p>دورات متقدمة، بنوك أسئلة، ملخّصات احترافية.<br>اشترك بالنشرة عشان تكون متابع معنا.</p>' +
          '<a class="ss-cta" href="/newsletter/">اشترك بالنشرة ←</a>' +
        '</div>';
      document.body.appendChild(o);
      function close() {
        o.classList.remove('on');
        setTimeout(function () { o.remove(); }, 260);
      }
      o.querySelector('.ss-x').addEventListener('click', close);
      o.addEventListener('click', function (e) { if (e.target === o) close(); });
      document.addEventListener('keydown', function esc(e) {
        if (e.key === 'Escape') { close(); document.removeEventListener('keydown', esc); }
      });
      requestAnimationFrame(function () { o.classList.add('on'); });
    }

    // اعترِض أي رابط للمتجر مهما كان مكانه بالصفحة (القائمة، الفوتر، أي مكان)
    document.addEventListener('click', function (e) {
      var t = e.target;
      var a = t && t.closest ? t.closest('a[href="/store/"], a[href="/store"]') : null;
      if (!a) return;
      // خلّي فتح الرابط بتبويب جديد (Ctrl/Cmd/وسط) يشتغل طبيعي
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
      e.preventDefault();
      openStoreSoon();
    });
  })();
</script>

<style is:global>
  #storeSoon {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(5, 10, 22, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.25s ease;
    direction: rtl;
  }
  #storeSoon.on { opacity: 1; }
  #storeSoon .ss-box {
    position: relative;
    width: min(92vw, 440px);
    background: linear-gradient(180deg, #12213d, #0a1428);
    border: 1px solid rgba(246, 130, 59, 0.35);
    border-radius: 20px;
    padding: 34px 30px 30px;
    text-align: center;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
    transform: translateY(14px) scale(0.97);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  #storeSoon.on .ss-box { transform: none; }
  #storeSoon .ss-x {
    position: absolute;
    top: 12px;
    left: 14px;
    width: 34px;
    height: 34px;
    border: 0;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.06);
    color: #cdd6e6;
    border-radius: 10px;
    font-size: 18px;
    line-height: 34px;
  }
  #storeSoon .ss-x:hover { background: rgba(255, 255, 255, 0.12); color: #fff; }
  #storeSoon .ss-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 700;
    color: #f6823b;
    background: rgba(246, 130, 59, 0.12);
    border: 1px solid rgba(246, 130, 59, 0.3);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 16px;
  }
  #storeSoon .ss-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #f6823b;
    animation: ssPulse 1.8s infinite;
  }
  @keyframes ssPulse {
    0% { box-shadow: 0 0 0 0 rgba(246, 130, 59, 0.5); }
    70% { box-shadow: 0 0 0 10px rgba(246, 130, 59, 0); }
    100% { box-shadow: 0 0 0 0 rgba(246, 130, 59, 0); }
  }
  #storeSoon h3 { margin: 0 0 12px; font-size: 26px; color: #fff; font-weight: 800; }
  #storeSoon .ss-tri { color: #e5484d; }
  #storeSoon p { margin: 0 0 22px; font-size: 15px; line-height: 1.9; color: #aeb9cc; }
  #storeSoon .ss-cta {
    display: inline-block;
    background: #f6823b;
    color: #0a1428;
    font-weight: 800;
    font-size: 15px;
    text-decoration: none;
    padding: 12px 26px;
    border-radius: 12px;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  #storeSoon .ss-cta:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(246, 130, 59, 0.35); }
  @media (prefers-reduced-motion: reduce) {
    #storeSoon, #storeSoon .ss-box, #storeSoon .ss-dot { transition: none; animation: none; }
  }
</style>
