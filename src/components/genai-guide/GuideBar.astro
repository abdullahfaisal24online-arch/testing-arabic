---
import { CHAPTERS, chapterUrl, guideBase, pageUrl, pagesFor, type GuideBuy, type GuidePage, type GuideView } from '../../lib/genai-guide';

interface Props {
  view: GuideView;
  kind: 'home' | 'chapter' | 'section' | 'glossary';
  chapter?: number;
  page?: GuidePage;
  buy?: GuideBuy;
}
const { view, kind, chapter, page, buy } = Astro.props;
const pages = pagesFor(view);
const siblings = page ? pages.filter((p) => p.chapter === page.chapter) : [];
const available = new Set(pages.map((p) => p.chapter));
---
<div class="gx-bar">
  <div class="wrap gx-bar-inner">
    <nav class="gx-crumbs" aria-label="مسار الصفحة">
      <a href={guideBase(view)}>دليل CT-GenAI</a>
      {chapter && kind !== 'home' && kind !== 'glossary' && (
        <>
          <span aria-hidden="true">/</span>
          {kind === 'chapter'
            ? <span aria-current="page" dir="ltr">Chapter {chapter}</span>
            : <a href={chapterUrl(view, chapter)} dir="ltr" class="gx-crumb-chapter">Chapter {chapter}</a>}
        </>
      )}
      {page && (
        <>
          <span aria-hidden="true">/</span>
          <span class="gx-crumb-here" aria-current="page" dir="ltr"><span class="gx-crumb-num">{page.section}</span> <span class="gx-crumb-title" lang="en">{page.title}</span></span>
        </>
      )}
      {kind === 'glossary' && (
        <>
          <span aria-hidden="true">/</span>
          <span aria-current="page" dir="ltr">Glossary</span>
        </>
      )}
    </nav>

    <div class="gx-bar-tools">
      {buy && (
        <a class="gx-buy-btn" href={buy.href} data-track="guide_buy_bar">
          <span class="gx-buy-full">اشترِ الدليل كامل · </span><b dir="ltr">{buy.price}</b>
        </a>
      )}
      {kind === 'section' ? (
        <nav class="gx-dots" aria-label="عناوين الفصل">
          {siblings.map((p) => (
            <a
              href={pageUrl(view, p)}
              class:list={['gx-dot', { 'is-current': p.slug === page?.slug }]}
              data-guide-dot={p.slug}
              aria-label={`${p.section} ${p.title}`}
              aria-current={p.slug === page?.slug ? 'page' : undefined}
            ></a>
          ))}
        </nav>
      ) : (
        <nav class="gx-pills" aria-label="الفصول">
          {CHAPTERS.map((c) =>
            available.has(c.number) ? (
              <a
                href={chapterUrl(view, c.number)}
                class:list={['gx-pill', { 'is-current': c.number === chapter && kind === 'chapter' }]}
                aria-current={c.number === chapter && kind === 'chapter' ? 'page' : undefined}
                aria-label={`Chapter ${c.number}: ${c.en}`}
              >{String(c.number).padStart(2, '0')}</a>
            ) : (
              <span class="gx-pill is-locked" aria-label={`Chapter ${c.number} — بالدليل الكامل`} title="بالدليل الكامل">{String(c.number).padStart(2, '0')}</span>
            ),
          )}
        </nav>
      )}

      {kind === 'section' && (
        <details class="gx-font">
          <summary aria-label="حجم خط القراءة"><span aria-hidden="true">Aa</span></summary>
          <div class="gx-font-menu">
            <button type="button" data-guide-font="-1" aria-label="تصغير الخط">A−</button>
            <span data-guide-font-value dir="ltr">18</span>
            <button type="button" data-guide-font="1" aria-label="تكبير الخط">A+</button>
          </div>
        </details>
      )}

      <button type="button" class="gx-toc-btn" data-guide-toc-open aria-controls="gx-toc" aria-haspopup="dialog">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"></path></svg>
        <span>الفهرس</span>
      </button>
    </div>
  </div>
  {kind === 'section' && <div class="gx-readbar" aria-hidden="true"><span data-guide-readbar></span></div>}
</div>
