---
/**
 * صفحة دليل دراسة كاملة (الرئيسية، الفصل، العنوان، المصطلحات) لأي دليل.
 * ملفات المسارات تحت src/pages/store/<product>/[view]/[...path].astro بتستدعيها.
 */
import Base from '../../layouts/Base.astro';
import GuideBar from './GuideBar.astro';
import GuideHome from './GuideHome.astro';
import GuideChapterPage from './GuideChapter.astro';
import GuideSection from './GuideSection.astro';
import GuideGlossary from './GuideGlossary.astro';
import GuideToc from './GuideToc.astro';
import { getEntry } from 'astro:content';
import type { Guide, GuideBuy, GuideKind, GuideView } from '../../lib/guide';
import { STORE_OPEN, usd } from '../../lib/store';
import '../../styles/genai-guide.css';

interface Props {
  g: Guide;
  view: GuideView;
  kind: GuideKind;
  chapter?: number;
  slug?: string;
}
const { g, view, kind, chapter, slug } = Astro.props;
const page = kind === 'section' ? g.pagesFor(view).find((p) => p.slug === slug) : undefined;
const chapterNumber = page?.chapter ?? chapter;
const chapterMeta = g.chapters.find((c) => c.number === chapterNumber);

// بالمعاينة المجانية: زر شراء الدليل من منتج المتجر (إذا المتجر مفتوح والمنتج منشور)
const product = STORE_OPEN && view === 'preview' ? await getEntry('products', g.product).catch(() => undefined) : undefined;
const buy: GuideBuy | undefined =
  product && !product.data.draft
    ? {
        href: `/store/${product.id}/`,
        order: `/store/${product.id}/order/`,
        price: usd(product.data.offerPrice ?? product.data.price),
        old: product.data.offerPrice != null ? usd(product.data.price) : undefined,
      }
    : undefined;

const title =
  kind === 'section' && page ? `${page.section} ${page.title} — دليل ${g.name}`
  : kind === 'chapter' && chapterMeta ? `Chapter ${chapterMeta.number}: ${chapterMeta.en} — دليل ${g.name}`
  : kind === 'glossary' ? `Glossary — دليل ${g.name}`
  : view === 'full' ? `مسودة دليل ${g.name} الكامل`
  : `معاينة دليل ${g.name}`;
---
<Base title={title} description={`دليل Testing بالعربي لدراسة ${g.name} — مراجعة تحريرية.`} noindex hideChat>
  <div class="gx" data-guide-view={view} data-guide-kind={kind} data-guide-slug={page?.slug} data-guide-key={g.storageKey(view)}>
    <GuideBar g={g} view={view} kind={kind} chapter={chapterNumber} page={page} buy={buy} />
    {kind === 'home' && <GuideHome g={g} view={view} buy={buy} />}
    {kind === 'chapter' && chapterNumber && <GuideChapterPage g={g} view={view} chapter={chapterNumber} />}
    {kind === 'section' && page && <GuideSection g={g} view={view} page={page} buy={buy} />}
    {kind === 'glossary' && <GuideGlossary g={g} view={view} />}
    <GuideToc g={g} view={view} current={page?.slug} />
  </div>
</Base>

<script>
  import '../../scripts/genai-guide';
</script>
