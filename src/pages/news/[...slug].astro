---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import InlineNewsletter from '../../components/InlineNewsletter.astro';
import Prose from '../../components/Prose.astro';
import OptimizedImage from '../../components/OptimizedImage.astro';
import { getSite } from '../../lib/site';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const news = (await getCollection('news')).filter((n) => !n.data.draft);
  return news.map((item) => ({
    params: { slug: item.id },
    props: {
      item,
      more: news
        .filter((n) => n.id !== item.id)
        .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
        .slice(0, 2),
    },
  }));
}

const { item, more } = Astro.props;
const { data } = item;
const { Content } = await render(item);
const bodyHtml = (item as any).rendered?.html ?? '';
const site = await getSite();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'NewsArticle',
    headline: data.title,
    description: data.description,
    inLanguage: 'ar',
    datePublished: data.publishDate.toISOString(),
    author: { '@type': 'Person', name: site.author },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    mainEntityOfPage: `${site.url}/news/${item.id}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'آخر الأخبار', item: `${site.url}/news/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/news/${item.id}/` },
    ],
  },
];
---
<Base
  title={data.title}
  description={data.description}
  type="article"
  publishDate={data.publishDate}
  image={data.cover}
  jsonLd={jsonLd}
>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span><a href="/news/">آخر الأخبار</a><span>›</span>
    <span class="now">{data.title}</span>
  </div>

  <article class="wrap body">
    <header class="head">
      <h1>{data.title}</h1>
      {data.description && <p class="standfirst">{data.description}</p>}
      <div class="byline">
        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
      </div>
    </header>

    {data.cover && (
      <OptimizedImage
        class="cover"
        src={data.cover}
        alt=""
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        sizes="(max-width: 900px) 100vw, 900px"
      />
    )}

    {bodyHtml ? <Prose html={bodyHtml} /> : <div class="prose"><Content /></div>}
  </article>

  {more.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>أخبار أخرى</h2></div>
        <div class="grid grid-2">{more.map((n) => <NewsCard item={n} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .crumbs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding-block: 18px; font-size: 14px; color: var(--muted); }
  .crumbs .now { color: var(--ink); }
  .body { padding-bottom: 24px; }
  .head { display: grid; gap: 14px; margin-bottom: 26px; }
  .standfirst { font-size: 19px; line-height: 1.85; color: var(--ink-3); max-width: var(--read); }
  .byline {
    font-size: 14px; color: var(--muted);
    padding-block: 14px; border-block: 1px solid var(--line);
  }
  .cover { border-radius: var(--r-lg); border: 1px solid var(--line); margin-bottom: 28px; }
</style>
