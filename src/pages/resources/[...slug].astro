---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import InlineNewsletter from '../../components/InlineNewsletter.astro';
import { getSite } from '../../lib/site';
import { formatDate } from '../../lib/utils';

export async function getStaticPaths() {
  const resources = (await getCollection('resources')).filter((r) => !r.data.draft);
  return resources.map((resource) => ({
    params: { slug: resource.id },
    props: {
      resource,
      more: resources.filter((r) => r.id !== resource.id).slice(0, 3),
    },
  }));
}

const { resource, more } = Astro.props;
const { data } = resource;
const { Content } = await render(resource);
const site = await getSite();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: data.title,
    description: data.description,
    inLanguage: 'ar',
    datePublished: data.publishDate.toISOString(),
    isAccessibleForFree: true,
    learningResourceType: data.category,
    author: { '@type': 'Person', name: site.author },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    url: `${site.url}/resources/${resource.id}/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'الموارد والقوالب', item: `${site.url}/resources/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/resources/${resource.id}/` },
    ],
  },
];
---
<Base
  title={data.title}
  description={data.description}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  jsonLd={jsonLd}
>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span><a href="/resources/">الموارد والقوالب</a><span>›</span>
    <span class="now">{data.category}</span>
  </div>

  <div class="wrap layout">
    <article class="main">
      <header class="head">
        <h1>{data.title}</h1>
        <p class="standfirst">{data.description}</p>
        <div class="meta">
          <span class="badge">{data.category}</span>
          {data.format && <span class="badge badge-outline mono">{data.format}</span>}
          <span>·</span>
          <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        </div>
        {data.tags.length > 0 && (
          <div class="tags">{data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        )}
      </header>

      <div class="prose"><Content /></div>

      <InlineNewsletter text="اشترك بالنشرة وبيوصلك كل قالب جديد أول ما ينزل." />
    </article>

    <aside class="side">
      <section class="box dl">
        <h2 class="box-ttl">تحميل</h2>
        <div class="files">
          {data.files.map((f) => (
            <a class="file" href={f.url} download>
              <Icon name="file" size={17} />
              <span class="mono">{f.label}</span>
              <Icon name="download" size={16} />
            </a>
          ))}
        </div>
        {data.files.length === 0 && <p class="none">الملف قيد التجهيز.</p>}
        <p class="free">مجاني · بدون تسجيل · استعمله بشغلك بحرية</p>
      </section>

      {data.audience && (
        <section class="box">
          <h2 class="box-ttl">لمين هذا المورد</h2>
          <p class="aud">{data.audience}</p>
        </section>
      )}
    </aside>
  </div>

  {more.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>موارد أخرى</h2></div>
        <div class="grid grid-3">{more.map((r) => <ResourceCard resource={r} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .crumbs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding-block: 18px; font-size: 14px; color: var(--muted); }
  .crumbs .now { color: var(--orange); font-weight: 600; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 44px; align-items: start; padding-bottom: 24px; }
  @media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } }
  .head { display: grid; gap: 14px; margin-bottom: 28px; }
  .standfirst { font-size: 19px; line-height: 1.85; color: var(--ink-3); max-width: var(--read); }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag { font-size: 12.5px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px; }

  .side { display: grid; gap: 18px; position: sticky; top: 84px; }
  @media (max-width: 1000px) { .side { position: static; } }
  .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 22px; display: grid; gap: 12px; }
  .dl { border-color: rgba(246, 130, 59, 0.3); }
  .box-ttl { font-size: 17px; margin: 0; }
  .files { display: grid; gap: 9px; }
  .file {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 10px;
    background: var(--orange-soft); border: 1px solid rgba(246, 130, 59, 0.3);
    border-radius: var(--r-sm); padding: 13px 15px;
    font-size: 13px; color: var(--orange); min-height: 46px; font-weight: 600;
  }
  .file:hover { background: rgba(246, 130, 59, 0.18); color: var(--orange); }
  .free { font-size: 13px; color: var(--faint); margin: 0; }
  .none { font-size: 14px; color: var(--muted); margin: 0; }
  .aud { font-size: 15px; color: var(--ink-2); margin: 0; line-height: 1.85; }
</style>
