---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getSite } from '../../lib/site';

const site = await getSite();

const lessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
const countFor = (id: string) =>
  lessons.filter((l) => (l.data.course ?? l.data.track) === id).length;

// الدورات الجاهزة أولاً، والقادمة بآخر القائمة
const courses = (await getCollection('courses'))
  .filter((c) => !c.data.draft)
  .sort((a, b) => {
    const ea = countFor(a.id) === 0 ? 1 : 0;
    const eb = countFor(b.id) === 0 ? 1 : 0;
    return ea - eb || a.data.order - b.data.order;
  });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'الدورات',
  itemListElement: courses.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.data.title,
    url: `${site.url}/courses/${c.id}/`,
  })),
};
---
<Base
  title="الدورات"
  description="دورات مرتّبة لتعلّم اختبار البرمجيات بالعربي: الأساسيات، أدوات إدارة الاختبار، وأتمتة الاختبار خطوة بخطوة."
  jsonLd={jsonLd}
>
  <section class="page-head dots">
    <div class="wrap">
      <h1>الدورات</h1>
      <p class="lead">كل دورة مرتّبة من أول درس لآخر واحد. اختر وين حابب توصل وابدأ من هناك.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        {courses.map((c) => <CourseCard course={c} count={countFor(c.id)} />)}
      </div>
      {courses.length === 0 && <p class="lead">ما في دورات منشورة بعد.</p>}
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 52px 44px; }
  .page-head h1 { margin-bottom: 12px; }
</style>
