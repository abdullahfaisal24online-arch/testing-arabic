---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Prose from '../../components/Prose.astro';
import { getSite } from '../../lib/site';

export async function getStaticPaths() {
  const courses = (await getCollection('courses')).filter((c) => !c.data.draft);
  const lessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
  return courses.map((course) => ({
    params: { slug: course.id },
    props: {
      course,
      lessons: lessons
        .filter((l) => (l.data.course ?? l.data.track) === course.id)
        .sort((a, b) => a.data.order - b.data.order),
    },
  }));
}

const { course, lessons } = Astro.props;
const { data } = course;
const { Content } = await render(course);
const bodyHtml = (course as any).rendered?.html ?? '';
const site = await getSite();

const totalSeconds = lessons.reduce((sum, l) => {
  const p = l.data.duration.split(':').map((n) => parseInt(n, 10) || 0);
  const s = p.length === 3 ? p[0] * 3600 + p[1] * 60 + p[2] : p.length === 2 ? p[0] * 60 + p[1] : p[0];
  return sum + s;
}, 0);
const hours = Math.floor(totalSeconds / 3600);
const mins = Math.round((totalSeconds % 3600) / 60);
const totalLabel = hours > 0 ? `${hours} ساعة و${mins} دقيقة` : `${mins} دقيقة`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: data.title,
    description: data.description,
    inLanguage: 'ar',
    url: `${site.url}/courses/${course.id}/`,
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    isAccessibleForFree: true,
    hasCourseInstance: {
      '@type': 'CourseInstance',
      courseMode: 'online',
      courseWorkload: `PT${Math.max(1, Math.round(totalSeconds / 60))}M`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'الدورات', item: `${site.url}/courses/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/courses/${course.id}/` },
    ],
  },
];
---
<Base title={data.title} description={data.description} jsonLd={jsonLd}>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span><a href="/courses/">الدورات</a><span>›</span>
    <span class="now">{data.title}</span>
  </div>

  <section class="hero dots">
    <div class="wrap hero-in">
      <div class="txt">
        {data.recommended && <span class="badge badge-orange">الدورة الموصى فيها للبداية</span>}
        <h1>{data.title}</h1>
        <p class="lead">{data.description}</p>
        <div class="stats">
          <div><b>{lessons.length}</b><span>عدد الدروس</span></div>
          <i></i>
          <div><b>{totalLabel}</b><span>مدة المشاهدة</span></div>
          <i></i>
          <div><b>{data.level}</b><span>المستوى</span></div>
        </div>
        {lessons.length > 0 && (
          <a class="btn btn-primary" href={`/lessons/${lessons[0].id}/`}>
            ابدأ الدورة <Icon name="arrow" size={19} />
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-wrap">
      <div>
        {data.outcomes.length > 0 && (
          <section class="panel out">
            <h2 class="mini-ttl">شو رح تتعلّم</h2>
            <ul class="mini-list">
              {data.outcomes.map((o) => <li>{o}</li>)}
            </ul>
          </section>
        )}

        {data.prerequisites.length > 0 && (
          <section class="panel pre">
            <h2 class="mini-ttl">متطلبات سابقة</h2>
            <ul class="mini-list">
              {data.prerequisites.map((p) => <li>{p}</li>)}
            </ul>
          </section>
        )}

        <div class="curr-head">
          <h2 class="ttl">محتوى الدورة</h2>
          <div class="prog" id="prog" hidden>
            <div class="bar"><span id="bar-fill"></span></div>
            <span class="prog-txt" id="prog-txt"></span>
            <button class="reset" type="button" id="reset-prog">تصفير</button>
          </div>
        </div>
        <ol class="curr">
          {lessons.map((l, i) => (
            <li>
              <a class="row-item" href={`/lessons/${l.id}/`} data-lesson={l.id}>
                <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="name">{l.data.title}</span>
                <span class="dur mono">{l.data.duration}</span>
                <span class="badge">مجاني</span>
              </a>
            </li>
          ))}
        </ol>
        {lessons.length === 0 && <p class="lead">دروس هذه الدورة قيد الإضافة.</p>}
      </div>

      <div class="notes">
        {bodyHtml ? <Prose html={bodyHtml} /> : <div class="prose"><Content /></div>}
      </div>
    </div>
  </section>
</Base>

<style>
  .crumbs { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding-block: 18px; font-size: 14px; color: var(--muted); }
  .crumbs .now { color: var(--ink); }
  .hero { background: var(--navy); border-block: 1px solid var(--line); }
  .hero-in { padding-block: 48px 54px; }
  .txt { display: grid; gap: 18px; justify-items: start; max-width: 760px; }
  .stats { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .stats div { display: grid; gap: 2px; }
  .stats b { font-size: 22px; }
  .stats span { font-size: 13px; color: var(--muted); }
  .stats i { width: 1px; height: 32px; background: var(--line); }

  .grid-wrap { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 44px; align-items: start; }
  @media (max-width: 940px) { .grid-wrap { grid-template-columns: minmax(0, 1fr); } }
  .curr-head { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-bottom: 16px; }
  .ttl { font-size: 22px; margin: 0; }
  .prog { display: flex; align-items: center; gap: 12px; margin-inline-start: auto; }
  .bar { width: 150px; height: 6px; border-radius: 999px; background: var(--surface-2); overflow: hidden; }
  .bar span { display: block; height: 100%; width: 0; background: var(--cyan); border-radius: 999px; transition: width .25s ease; }
  .prog-txt { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .reset {
    font: inherit; font-size: 12.5px; color: var(--faint); background: none;
    border: 0; cursor: pointer; text-decoration: underline; padding: 4px;
  }
  .reset:hover { color: var(--orange); }
  .row-item.done { border-color: var(--line-strong); }
  .row-item.done .name { color: var(--muted); }
  .row-item.done .num::after { content: ' ✓'; color: var(--cyan); }
  .panel {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 20px 22px; margin-bottom: 20px;
  }
  .panel.out { border-inline-start: 3px solid var(--cyan); }
  .panel.pre { border-inline-start: 3px solid var(--orange); }
  .mini-ttl { font-size: 16px; margin: 0 0 10px; }
  .mini-list { margin: 0; padding-inline-start: 20px; display: grid; gap: 8px; color: var(--ink-2); font-size: 16px; line-height: 1.85; }
  .mini-list li::marker { color: var(--cyan); }
  .panel.pre .mini-list li::marker { color: var(--orange); }
  .curr { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .row-item {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 14px;
    background: var(--navy);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 15px 18px;
    color: inherit;
    min-height: 48px;
  }
  .row-item:hover { border-color: var(--line-strong); }
  .num { font-size: 13px; color: var(--cyan); }
  .name { font-size: 16px; font-weight: 500; }
  .dur { font-size: 13px; color: var(--muted); }
  .notes .prose { font-size: 16px; }
</style>

<script>
  // ===== شريط تقدّم الدورة — من تخزين المتصفّح =====
  const DONE_KEY = 'ta-done';
  const rows = document.querySelectorAll<HTMLElement>('.row-item[data-lesson]');
  const wrap = document.getElementById('prog');
  const fill = document.getElementById('bar-fill');
  const txt = document.getElementById('prog-txt');

  const readDone = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(DONE_KEY) ?? '[]');
    } catch {
      return [];
    }
  };

  function paint() {
    const done = readDone();
    let n = 0;
    rows.forEach((r) => {
      const isDone = done.includes(r.dataset.lesson ?? '');
      r.classList.toggle('done', isDone);
      if (isDone) n++;
    });
    if (rows.length === 0) return;
    if (wrap) wrap.hidden = n === 0;
    if (fill) fill.style.width = `${Math.round((n / rows.length) * 100)}%`;
    if (txt) txt.textContent = `${n} من ${rows.length}`;
  }

  document.getElementById('reset-prog')?.addEventListener('click', () => {
    try {
      const done = readDone().filter(
        (id) => ![...rows].some((r) => r.dataset.lesson === id),
      );
      localStorage.setItem(DONE_KEY, JSON.stringify(done));
    } catch {
      /* لا شي */
    }
    paint();
  });

  paint();
</script>
