---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getSite } from '../../lib/site';
import { BUG_HUNTER_CASES } from '../../data/bug-hunter-cases';

const site = await getSite();
const entry = await getEntry('bugHunter', 'bug-hunter');
const game = entry?.data;

if (!game?.enabled) return Astro.redirect('/');

// الأسئلة والفخاخ من الكود (src/data/bug-hunter-cases.ts)، والعناوين والنصوص العامة من لوحة التحكم
const extraCases = (await getCollection('bugCases').catch(() => []))
  .filter((c) => c.data.enabled)
  .sort((a, b) => a.data.order - b.data.order);

const content = (id: string) => BUG_HUNTER_CASES[id];
const case01 = content('broken-shop');
const cases = [
  {
    id: 'broken-shop', scene: case01.scene, comingSoon: false, badge: game.caseBadge || '',
    cover: game.caseCover || '/games/bug-hunter-cover.webp', kicker: game.caseKicker,
    caseLabel: game.caseLabel, caseTitle: game.caseTitle, caseText: game.caseText,
    durationSeconds: game.durationSeconds, bugs: case01.bugs, traps: case01.traps,
    storageKey: 'testing-arabic:bug-hunter:best',
  },
  ...extraCases.map((c) => {
    const cc = content(c.id);
    return {
      id: c.id, scene: cc?.scene || 'none', comingSoon: c.data.comingSoon || !cc?.bugs.length, badge: c.data.badge || '',
      cover: c.data.cover || '', kicker: c.data.kicker, caseLabel: c.data.caseLabel, caseTitle: c.data.caseTitle,
      caseText: c.data.caseText, durationSeconds: c.data.durationSeconds, bugs: cc?.bugs || [], traps: cc?.traps || [],
      storageKey: `testing-arabic:bug-hunter:best:${c.id}`,
    };
  }),
];
const settings = {
  pickerTitle: game.pickerTitle, pickerText: game.pickerText, trapPenalty: game.trapPenalty,
  challengeLabel: game.challengeLabel, practiceLabel: game.practiceLabel, oneAttemptNote: game.oneAttemptNote,
  resultTitle: game.resultTitle, resultText: game.resultText, ranks: game.ranks, cases,
};
const first = cases[0];
const showPicker = cases.length > 1;
const serializedGame = JSON.stringify(settings).replace(/</g, '\\u003c');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Bug Hunter',
  description: game.caseText,
  url: `${site.url}/bug-hunter/`,
  inLanguage: 'ar',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base title="Bug Hunter — اصطاد الـ bugs بنفسك" description={game.caseText} jsonLd={jsonLd}>
  <main class="hunter-page dots" id="bug-hunter-app">
    {showPicker && (
      <section class="picker-screen" id="picker-screen">
        <div class="picker-head">
          <span class="case-label"><span aria-hidden="true">●</span> BUG HUNTER</span>
          <h1>{game.pickerTitle}</h1>
          <p>{game.pickerText}</p>
        </div>
        <div class="case-grid">
          {cases.map((c) => (
            <article class:list={['case-card', { soon: c.comingSoon, 'tri-cursor': !c.comingSoon }]} data-case-card={c.id} {...(!c.comingSoon ? { role: 'button', tabindex: 0, 'aria-label': `ابدأ ${c.caseTitle}` } : {})}>
              <div class="case-thumb">
                {c.cover ? <img src={c.cover} alt="" width="640" height="360" loading="lazy" decoding="async" /> : <div class="case-thumb-ph" aria-hidden="true"><img src="/brand/ladybug.webp" alt="" width="64" height="70" /></div>}
                {c.comingSoon && <span class="case-lock" aria-hidden="true">🔒</span>}
                <span class="case-badge" data-case-badge hidden></span>
                {c.badge && !c.comingSoon && <span class="case-badge new" data-case-new>{c.badge}</span>}
              </div>
              <div class="case-body">
                <small class="case-kicker">{c.kicker}</small>
                <h2>{c.caseTitle}</h2>
                <p>{c.caseText}</p>
                {!c.comingSoon && (
                  <div class="case-meta"><span>{c.bugs.length} Bugs</span>{c.traps.length > 0 && <span>{c.traps.length} Not a Bug</span>}<span>{c.durationSeconds} ثانية</span></div>
                )}
                <div class="case-cta">
                  <span class="case-progress" data-case-progress>{c.comingSoon ? '🔔 جاية قريب… تابعنا عشان تكون أول واحد يلعبها' : 'لسا ما لعبتها'}</span>
                  {!c.comingSoon && <button type="button" class="btn btn-primary case-go" data-pick-case={c.id}>ابدأ <Icon name="arrow" size={17} /></button>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="mission-screen" id="mission-screen" hidden={showPicker}>
      <div class="mission-card">
        {showPicker && <button type="button" class="back-cases" id="back-cases">→ كل الـ Cases</button>}
        <span class="case-label"><span aria-hidden="true">●</span> <b id="m-label">{first.caseLabel}</b></span>
        <div class="mission-icon" aria-hidden="true"><img src="/brand/ladybug.webp" alt="" width="62" height="68" decoding="async" /></div>
        <h1 id="m-title">{first.caseTitle}</h1>
        <p class="mission-copy" id="m-text">{first.caseText}</p>

        <div class="mission-facts">
          <span><img class="lb-mini" src="/brand/ladybug.webp" alt="" width="18" height="20" decoding="async" /><b id="m-bugs">{first.bugs.length}</b> أخطاء مخفية</span>
          <span id="m-traps-wrap"><span aria-hidden="true">🧐</span><b id="m-traps">{first.traps.length}</b> فخ Not a Bug</span>
          <span><Icon name="clock" size={18} /><b id="m-time">{first.durationSeconds}</b> ثانية بالتحدي</span>
          <span><Icon name="check" size={18} /> محاولة واحدة لكل Bug</span>
        </div>

        <div class="mode-grid">
          <button class="mode-card mode-challenge" type="button" data-start-mode="challenge">
            <span class="mode-tag">اختبر نفسك</span>
            <strong>{game.challengeLabel}</strong>
            <small>اصطد أكبر عدد قبل انتهاء الوقت</small>
            <span class="mode-action">ابدأ العد التنازلي <Icon name="arrow" size={17} /></span>
          </button>
          <button class="mode-card" type="button" data-start-mode="practice">
            <span class="mode-tag cyan">تعلّم بهدوء</span>
            <strong>{game.practiceLabel}</strong>
            <small>نفس الأسئلة بدون مؤقّت</small>
            <span class="mode-action">ابدأ التدريب <Icon name="arrow" size={17} /></span>
          </button>
        </div>
        <p class="attempt-note">{game.oneAttemptNote} <span class="trap-note">وانتبه: مش كل علامة Bug حقيقي — البلاغ الغلط بيخصم {game.trapPenalty} نقطة.</span></p>
      </div>
    </section>

    <section class="game-screen" id="game-screen" hidden aria-label="Bug Hunter">
      <div class="game-hud">
        <div class="game-toolbar">
          <div class="toolbar-brand"><img class="lb-mini" src="/brand/ladybug.webp" alt="" width="22" height="24" decoding="async" /><span>BUG HUNTER</span><small id="hud-case">CASE 01</small></div>
          <div class="toolbar-stats">
            <span class="stat"><small>SCORE</small><b id="score-value">0000</b></span>
            <span class="stat"><small>FOUND</small><b><i id="found-value">0</i>/<i id="found-total">{first.bugs.length}</i></b></span>
            <span class="stat timer-stat" id="timer-stat"><small>TIME</small><b id="time-value">01:30</b></span>
            <button class="sound-toggle" id="sound-toggle" type="button" aria-label="إيقاف الصوت والموسيقى" aria-pressed="false" title="كتم الصوت والموسيقى">♪</button>
          </div>
        </div>
        <div class="progress-track">
          <span id="game-progress" aria-hidden="true"></span>
          <button class="end-game" id="end-game" type="button" aria-label="إنهاء اللعبة" title="إنهاء اللعبة وعرض النتيجة">إنهاء</button>
        </div>
      </div>

      <!-- ===== Scene: shop (Case 01) ===== -->
      <div class="shop-window scene" data-scene="shop">
        <header class="shop-header">
          <a href="#" tabindex="-1" class="shop-logo">BROKEN<span>SHOP</span></a>
          <label class="shop-search">⌕ <input tabindex="-1" value="Search products..." readonly /></label>
          <span class="shop-cart">CART <b>0</b></span>
        </header>

        <div class="shop-notice">FREE SHIPPING ON ORDERS OVER $50</div>

        <div class="shop-layout">
          <section class="catalog" aria-label="المنتجات">
            <div class="shop-heading"><div><small>NEW ARRIVALS</small><h2>Featured products</h2></div><span>12 products</span></div>
            <div class="product-grid">
              <article class="product-card issue-box">
                <div class="broken-image"><span>▧</span><small>IMG_404.JPG</small></div>
                <div class="product-copy"><small>AUDIO</small><h3>Wireless Headphones</h3><b>$29.00</b></div>
                <button class="fake-cart low-contrast" tabindex="-1">ADD TO CART</button>
                <button class="bug-marker marker-image" type="button" data-bug="broken-image" aria-label="افحص الصورة المكسورة"><span>🐞</span></button>
                <button class="bug-marker marker-contrast" type="button" data-bug="low-contrast" aria-label="افحص تباين الزر"><span>🐞</span></button>
              </article>

              <article class="product-card issue-box">
                <span class="sale-tag">SALE −17%</span>
                <div class="product-art keyboard">⌨</div>
                <div class="product-copy"><small>ACCESSORIES</small><h3>Mechanical Keyboard</h3><b>$49.00 <s>$59.00</s></b></div>
                <button class="fake-cart dead-button" tabindex="-1">ADD TO CART</button>
                <button class="bug-marker marker-cart" type="button" data-bug="add-to-cart" aria-label="افحص زر الإضافة"><span>🐞</span></button>
                <button class="bug-marker marker-sale" type="button" data-trap="sale-price" aria-label="افحص السعر"><span>🐞</span></button>
              </article>

              <article class="product-card soldout-card issue-box">
                <span class="stock-tag">OUT OF STOCK</span>
                <div class="product-art">▱</div>
                <div class="product-copy"><small>DESK</small><h3>Minimal Desk Lamp</h3><b>$36.00</b></div>
                <button class="fake-cart soldout" tabindex="-1" disabled>SOLD OUT</button>
                <button class="bug-marker marker-soldout" type="button" data-trap="sold-out" aria-label="افحص زر المنتج"><span>🐞</span></button>
              </article>
            </div>

            <div class="mobile-preview issue-box">
              <span class="device-label">360 PX VIEWPORT</span>
              <div><b>Ready to checkout?</b><small>Your cart has 1 item</small></div>
              <button tabindex="-1">PROCEED TO CHECKOUT →</button>
              <button class="bug-marker marker-mobile" type="button" data-bug="mobile-overflow" aria-label="افحص عرض الموبايل"><span>🐞</span></button>
            </div>
          </section>

          <aside class="checkout-panel" aria-label="Checkout">
            <div class="panel-title"><div><small>SECURE CHECKOUT</small><h2>Your order</h2></div><span>🔒</span></div>

            <div class="order-line"><span>Wireless Headphones</span><b>$29.00</b></div>
            <div class="order-line"><span>Shipping</span><b>$4.00</b></div>
            <div class="order-line"><span>Discount</span><b>−$5.80</b></div>
            <div class="order-line order-total issue-box"><span>Total</span><b>$42.80</b>
              <button class="bug-marker marker-total" type="button" data-bug="wrong-total" aria-label="افحص إجمالي السلة"><span>🐞</span></button>
            </div>

            <label class="field issue-box"><span>Email address</span><input tabindex="-1" value="ahmad@" readonly />
              <small class="accepted">✓ Looks good</small>
              <button class="bug-marker marker-email" type="button" data-bug="invalid-email" aria-label="افحص البريد الإلكتروني"><span>🐞</span></button>
            </label>

            <div class="coupon issue-box"><input tabindex="-1" value="EXPIRED20" readonly /><button tabindex="-1">APPLY</button>
              <small>✓ Coupon applied successfully!</small>
              <button class="bug-marker marker-coupon" type="button" data-bug="expired-coupon" aria-label="افحص الكوبون"><span>🐞</span></button>
            </div>

            <div class="payment-status issue-box"><span>✓</span><div><b>Payment successful</b><small>POST /payments → 500</small></div>
              <button class="bug-marker marker-api" type="button" data-bug="false-payment-success" aria-label="افحص حالة الدفع"><span>🐞</span></button>
            </div>

            <div class="place-wrap issue-box">
              <button class="place-order" tabindex="-1">PLACE ORDER</button>
              <span class="double-click">Double-click registered: 2 orders</span>
              <button class="bug-marker marker-duplicate" type="button" data-bug="duplicate-order" aria-label="افحص تكرار الطلب"><span>🐞</span></button>
              <button class="bug-marker marker-keyboard" type="button" data-bug="keyboard-skip" aria-label="افحص الوصول بالكيبورد"><span>🐞</span></button>
            </div>
          </aside>
        </div>
      </div>

      <!-- ===== Scene: login (Case 02) ===== -->
      <div class="auth-window scene" data-scene="login" hidden>
        <header class="auth-top">
          <span class="auth-logo">SECURE<span>APP</span></span>
          <span class="auth-links"><span>Help</span><span>EN ▾</span></span>
        </header>
        <div class="auth-grid">
          <section class="auth-card">
            <small class="auth-kicker">WELCOME BACK</small>
            <h2>Sign in</h2>
            <label class="a-field issue-box"><span>Email</span>
              <input class="a-input bad" tabindex="-1" value=" ahmad@mail.com" readonly />
              <small class="a-err">✕ Invalid email address</small>
              <button class="bug-marker m-email-trim" type="button" data-bug="email-trim" aria-label="افحص حقل الإيميل"><span>🐞</span></button>
            </label>
            <label class="a-field issue-box"><span>Password</span>
              <input class="a-input" tabindex="-1" value="Ahmad@2026" readonly />
              <button class="bug-marker m-pass-visible" type="button" data-bug="password-visible" aria-label="افحص حقل الباسورد"><span>🐞</span></button>
            </label>
            <div class="a-row"><label class="a-check"><span class="box"></span> Remember me</label><span class="a-link">Forgot password?</span></div>
            <div class="a-alert issue-box"><b>Error 0x80040E14</b><small>NullReferenceException at AuthService.Login()</small>
              <button class="bug-marker m-error" type="button" data-bug="error-technical" aria-label="افحص رسالة الخطأ"><span>🐞</span></button>
            </div>
            <button class="a-btn" tabindex="-1">SIGN IN</button>
          </section>

          <section class="auth-card">
            <small class="auth-kicker">NEW HERE?</small>
            <h2>Create account</h2>
            <label class="a-field issue-box"><span>Full name</span>
              <input class="a-input bad" tabindex="-1" value="عبدالله" readonly dir="rtl" />
              <small class="a-err">✕ Name contains invalid characters</small>
              <button class="bug-marker m-arabic" type="button" data-bug="arabic-name" aria-label="افحص حقل الاسم"><span>🐞</span></button>
            </label>
            <label class="a-field issue-box"><span>Password <em>Min. 8 characters</em></span>
              <span class="a-pass"><input class="a-input" tabindex="-1" value="Ab1!" readonly /><span class="eye on" title="Hide password">👁</span></span>
              <small class="a-ok">✓ Strong password</small>
              <button class="bug-marker m-length" type="button" data-bug="password-length" aria-label="افحص طول الباسورد"><span>🐞</span></button>
              <button class="bug-marker m-toggle" type="button" data-trap="show-password-toggle" aria-label="افحص إظهار الباسورد"><span>🐞</span></button>
            </label>
            <label class="a-field issue-box"><span>Confirm password</span>
              <span class="a-pass"><input class="a-input" tabindex="-1" value="Ab1?" readonly /><span class="eye on">👁</span></span>
              <small class="a-ok">✓ Passwords match</small>
              <button class="bug-marker m-confirm" type="button" data-bug="confirm-mismatch" aria-label="افحص تأكيد الباسورد"><span>🐞</span></button>
            </label>
            <div class="a-terms issue-box"><label class="a-check"><span class="box"></span> I agree to the <u>Terms</u> <i>*</i></label>
              <div class="a-success">✓ Account created</div>
              <button class="bug-marker m-terms" type="button" data-bug="terms-unchecked" aria-label="افحص الموافقة على الشروط"><span>🐞</span></button>
            </div>
            <button class="a-btn orange" tabindex="-1">CREATE ACCOUNT</button>
          </section>

          <aside class="auth-side">
            <div class="auth-card mini issue-box">
              <small class="auth-kicker">VERIFY EMAIL</small>
              <b class="mini-t">Enter the 6-digit code</b>
              <small class="mini-s">Sent to ahmad.new@mail.com</small>
              <div class="otp"><span>4</span><span>8</span><span>1</span><span></span><span></span><span></span></div>
              <button class="a-btn ghost" tabindex="-1" disabled>Resend code (0:45)</button>
              <button class="bug-marker m-resend" type="button" data-trap="resend-cooldown" aria-label="افحص زر إعادة الإرسال"><span>🐞</span></button>
            </div>
            <div class="auth-card mini dash issue-box">
              <small class="auth-kicker">DASHBOARD</small>
              <small class="mini-s">Logged in as <b>ahmad@mail.com</b></small>
              <div class="dash-user"><span class="av">S</span><div><b>Welcome back, Sara Khalil 👋</b><small>sara.k@mail.com</small></div></div>
              <button class="bug-marker m-user" type="button" data-bug="wrong-user" aria-label="افحص بيانات المستخدم"><span>🐞</span></button>
            </div>
          </aside>
        </div>
      </div>
      <p class="game-tip">دوّر على علامات الـ Bug الحمراء واضغط عليها. كل إجابة صحيحة = 100 نقطة — بس انتبه، في علامات على أشياء مش Bugs.</p>
    </section>

    <section class="result-screen" id="result-screen" hidden>
      <div class="result-card">
        <span class="result-kicker" id="r-kicker">CASE 01 • CLOSED</span>
        <h2>{game.resultTitle}</h2>
        <p>{game.resultText}</p>
        <strong class="result-rank" id="result-rank">QA Intern</strong>
        <div class="result-grid">
          <div><small>SCORE</small><b><span id="result-score">0</span><i>/<span id="result-max">1000</span></i></b></div>
          <div><small>CORRECT</small><b><span id="result-correct">0</span><i>/<span id="result-total">10</span></i></b></div>
          <div><small>NOT A BUG</small><b class="tr"><span id="result-traps">0</span></b></div>
          <div><small>BEST</small><b><span id="result-best">0</span></b></div>
        </div>

        <div class="report-wrap">
          <div class="jira">
            <div class="jira-head"><div><b id="j-title">Bug Report</b><small id="j-meta"></small></div></div>
            <div class="jira-table-wrap"><table class="jira-table"><thead><tr><th>Key</th><th>Summary</th><th>Severity</th><th>Status</th></tr></thead><tbody id="j-rows"></tbody></table></div>
            <div class="jira-foot">
              <label class="tester"><span>اسمك على التقرير</span><input id="tester-name" type="text" maxlength="40" placeholder="Your name" dir="auto" /></label>
              <button class="btn btn-primary" id="download-pdf" type="button">⬇ حمّل PDF</button>
            </div>
          </div>
          <figure class="share-card">
            <img id="share-card-img" alt="بطاقة نتيجتك" width="540" height="540" />
            <figcaption><button class="btn btn-ghost" id="share-result" type="button">شارك النتيجة</button><button class="btn btn-ghost" id="download-card" type="button">حمّل البطاقة</button></figcaption>
          </figure>
        </div>

        <div class="result-actions">
          <button class="btn btn-primary" id="play-again" type="button">العب مرة ثانية <Icon name="arrow" size={18} /></button>
          {showPicker && <button class="btn btn-ghost" id="other-cases" type="button">العب Case ثانية</button>}
          <a class="btn btn-ghost" href="/">العودة للرئيسية</a>
        </div>
        <p class="share-status" id="share-status" aria-live="polite"></p>
        <div class="learning-list" id="learning-list">
          <div class="learning-head"><span>خطوتك التالية</span><h2>قوّي النقاط اللي فاتتك</h2></div>
          <div id="resource-links"></div>
        </div>
      </div>
    </section>

    <div class="question-layer" id="question-layer" hidden>
      <div class="question-modal" id="question-modal" role="dialog" aria-modal="true" aria-labelledby="question-title">
        <button class="modal-close" id="modal-close" type="button" aria-label="إغلاق السؤال">×</button>
        <span class="question-count" id="question-count">BUG 01 / 10</span>
        <div class="question-icon" id="question-icon" aria-hidden="true">🐞</div>
        <p class="question-bug" id="question-bug"></p>
        <h2 id="question-title"></h2>
        <div class="answer-list" id="answer-list"></div>
        <div class="answer-feedback" id="answer-feedback" hidden>
          <strong id="feedback-title"></strong>
          <p id="feedback-copy"></p>
          <div id="trap-rule" hidden>💡 <b>قبل ما تبلّغ:</b> ارجع للـ requirements أو الـ acceptance criteria. مش كل إشي غريب Bug، والتقارير الغلط بتضيّع وقت الفريق.</div>
          <div id="expected-result" hidden><small>EXPECTED RESULT</small><span></span></div>
          <button class="btn btn-primary" id="continue-game" type="button">كمّل الصيد <Icon name="arrow" size={17} /></button>
        </div>
      </div>
    </div>

    <div class="swarm-layer" id="swarm-layer" aria-hidden="true"></div>
    <div class="game-toast" id="game-toast" role="status" aria-live="polite"></div>
  </main>

  <!-- تقرير الطباعة / PDF (بيظهر بس وقت الطباعة) -->
  <div id="print-report" aria-hidden="true"></div>

  <script type="application/json" id="bug-hunter-data" set:html={serializedGame}></script>
</Base>

<script is:inline>
  (() => {
    const dataNode = document.getElementById('bug-hunter-data');
    if (!dataNode) return;
    const settings = JSON.parse(dataNode.textContent || '{}');
    const byId = (id) => document.getElementById(id);
    const picker = byId('picker-screen');
    const mission = byId('mission-screen');
    const gameScreen = byId('game-screen');
    const results = byId('result-screen');
    const layer = byId('question-layer');
    const modal = byId('question-modal');
    const answersEl = byId('answer-list');
    const feedback = byId('answer-feedback');
    const swarm = byId('swarm-layer');
    const soundStorageKey = 'testing-arabic:bug-hunter:muted';
    const PENALTY = Number(settings.trapPenalty) || 30;
    const cases = settings.cases || [];
    let C = cases.find((c) => !c.comingSoon) || cases[0];
    let mode = 'challenge';
    let active = false;
    let remaining = Number(C?.durationSeconds) || 90;
    let timer = null;
    let currentBug = null;
    let score = 0;
    let correct = 0;
    let answered = new Map();
    let trapped = new Set();
    let muted = false;
    try { muted = localStorage.getItem(soundStorageKey) === '1'; } catch (_) {}
    let audioContext = null;
    let musicTimer = null;
    let musicStep = 0;
    let musicGain = null;
    const store = {
      get(k) { try { return JSON.parse(localStorage.getItem(k) || 'null'); } catch (_) { try { return Number(localStorage.getItem(k)) || null; } catch (e) { return null; } } },
      set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (_) {} },
    };
    // أحسن نتيجة لكل Case: {score, correct}. النسخة القديمة كانت تخزّن السكور كرقم بس (100 لكل Bug)،
    // وكل Bug صح = 100 والفخ بيخصم، فـ floor(score/100) دايماً ≤ عدد الـ bugs الصح — منستعمله لنصلّح الأرقام القديمة.
    const bestOf = (c) => {
      const v = store.get(c.storageKey); if (v == null || typeof v !== 'object' && typeof v !== 'number') return null;
      const score = Math.max(0, Number(typeof v === 'number' ? v : v.score) || 0);
      const saved = typeof v === 'number' ? 0 : Number(v.correct) || 0;
      return { score, correct: Math.min(c.bugs.length, Math.max(saved, Math.floor(score / 100))) };
    };
    const caseNum = (c) => (c.caseLabel.match(/CASE\s*\d+/i) || ['CASE'])[0].toUpperCase();

    const scene = () => document.querySelector(`.scene[data-scene="${C.scene}"]`);
    const markers = () => [...(scene()?.querySelectorAll('.bug-marker') || [])];

    const shuffle = (items) => {
      const copy = [...items];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    };

    const ensureAudio = () => {
      audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
      if (audioContext.state === 'suspended') audioContext.resume();
      return audioContext;
    };
    // بعض متصفحات الموبايل تحتاج صوتًا قصيرًا من نفس ضغطة المستخدم حتى تسمح بالموسيقى.
    const unlockAudio = () => {
      try {
        const context = ensureAudio();
        const buffer = context.createBuffer(1, 1, 22050);
        const source = context.createBufferSource();
        source.buffer = buffer; source.connect(context.destination); source.start(0);
      } catch (_) {}
    };
    const playTone = (kind) => {
      if (muted) return;
      try {
        const context = ensureAudio();
        const now = context.currentTime;
        const osc = context.createOscillator();
        const gain = context.createGain();
        const ok = kind === 'correct', trap = kind === 'trap';
        osc.type = ok ? 'sine' : trap ? 'triangle' : 'sawtooth';
        osc.frequency.setValueAtTime(ok ? 520 : trap ? 440 : 170, now);
        if (ok) osc.frequency.exponentialRampToValueAtTime(780, now + .22);
        if (trap) osc.frequency.exponentialRampToValueAtTime(220, now + .3);
        gain.gain.setValueAtTime(.0001, now);
        gain.gain.exponentialRampToValueAtTime(.1, now + .015);
        gain.gain.exponentialRampToValueAtTime(.0001, now + .32);
        osc.connect(gain).connect(context.destination);
        osc.start(now); osc.stop(now + .34);
      } catch (_) {}
    };
    const stopMusic = () => {
      clearInterval(musicTimer); musicTimer = null;
      if (musicGain && audioContext) { const now = audioContext.currentTime; musicGain.gain.cancelScheduledValues(now); musicGain.gain.setTargetAtTime(0, now, .035); }
      musicGain = null;
    };
    // مقطوعة Spy Jazz أصلية ومولّدة مباشرة داخل المتصفح — بدون ملف صوت خارجي.
    const startMusic = () => {
      if (muted || mode !== 'challenge' || !active || musicTimer) return;
      try {
        const context = ensureAudio();
        musicGain = context.createGain();
        musicGain.gain.setValueAtTime(.045, context.currentTime);
        musicGain.connect(context.destination);
        musicStep = 0;
        const bass = [82.41, 0, 98, 0, 87.31, 0, 110, 0, 82.41, 0, 116.54, 0, 98, 0, 73.42, 0];
        const lead = [0, 329.63, 0, 392, 349.23, 0, 293.66, 0, 0, 440, 0, 369.99, 0, 311.13, 0, 261.63];
        const scheduleNote = (frequency, type, volume, duration) => {
          if (!frequency || !musicGain) return;
          const now = context.currentTime;
          const osc = context.createOscillator();
          const gain = context.createGain();
          osc.type = type; osc.frequency.setValueAtTime(frequency, now);
          gain.gain.setValueAtTime(.0001, now);
          gain.gain.exponentialRampToValueAtTime(volume, now + .012);
          gain.gain.exponentialRampToValueAtTime(.0001, now + duration);
          osc.connect(gain).connect(musicGain);
          osc.start(now); osc.stop(now + duration + .02);
        };
        const tick = () => {
          scheduleNote(bass[musicStep], 'triangle', .72, .19);
          scheduleNote(lead[musicStep], 'sine', .34, .12);
          if (musicStep % 4 === 2) scheduleNote(880, 'square', .055, .035);
          musicStep = (musicStep + 1) % bass.length;
        };
        tick(); musicTimer = setInterval(tick, 245);
      } catch (_) {}
    };
    const updateSoundButton = () => {
      const button = byId('sound-toggle');
      button.setAttribute('aria-pressed', String(muted));
      button.setAttribute('aria-label', muted ? 'تشغيل الصوت والموسيقى' : 'إيقاف الصوت والموسيقى');
      button.setAttribute('title', muted ? 'تشغيل الصوت والموسيقى' : 'كتم الصوت والموسيقى');
      button.textContent = muted ? '×♪' : '♪';
    };

    const formatTime = (seconds) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;
    const updateHud = () => {
      byId('score-value').textContent = String(score).padStart(4, '0');
      byId('found-value').textContent = String(answered.size);
      byId('found-total').textContent = String(C.bugs.length);
      byId('time-value').textContent = formatTime(Math.max(0, remaining));
      byId('game-progress').style.width = `${(answered.size / Math.max(1, C.bugs.length)) * 100}%`;
      byId('timer-stat').classList.toggle('urgent', mode === 'challenge' && remaining <= 15);
    };

    /* ---------- اختيار الـ Case ---------- */
    const paintPicker = () => {
      if (!picker) return;
      cases.forEach((c) => {
        const card = picker.querySelector(`[data-case-card="${CSS.escape(c.id)}"]`); if (!card || c.comingSoon) return;
        const best = bestOf(c), badge = card.querySelector('[data-case-badge]'), prog = card.querySelector('[data-case-progress]'), go = card.querySelector('[data-pick-case]');
        const isNew = card.querySelector('[data-case-new]');
        if (best) {
          const full = best.correct >= c.bugs.length;
          badge.hidden = false; badge.className = 'case-badge done'; badge.textContent = full ? '✓ مكتملة' : '✓ لعبتها';
          if (isNew) isNew.hidden = true;
          prog.innerHTML = `أحسن نتيجة: <b>${best.correct} / ${c.bugs.length}</b>`;
          if (go) go.innerHTML = 'العب مرة ثانية <span aria-hidden="true">←</span>';
        }
      });
    };
    const openCase = (id) => {
      const c = cases.find((x) => x.id === id && !x.comingSoon); if (!c) return;
      C = c;
      byId('m-label').textContent = c.caseLabel; byId('m-title').textContent = c.caseTitle; byId('m-text').textContent = c.caseText;
      byId('m-bugs').textContent = String(c.bugs.length); byId('m-traps').textContent = String(c.traps.length); byId('m-time').textContent = String(c.durationSeconds);
      byId('m-traps-wrap').hidden = !c.traps.length;
      if (picker) picker.hidden = true; results.hidden = true; mission.hidden = false;
      try { history.replaceState(null, '', `?case=${encodeURIComponent(c.id)}`); } catch (_) {}
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };
    const showPicker = () => {
      if (!picker) { mission.hidden = false; results.hidden = true; return; }
