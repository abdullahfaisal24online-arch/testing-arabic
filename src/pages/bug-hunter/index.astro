---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getSite } from '../../lib/site';

const site = await getSite();
const entry = await getEntry('bugHunter', 'bug-hunter');
const game = entry?.data;

if (!game?.enabled) return Astro.redirect('/');

const serializedGame = JSON.stringify(game).replace(/</g, '\\u003c');
---

<Base title={`${game.caseTitle} | ${site.name}`} description={game.caseText}>
  <main class="hunter-page dots" id="bug-hunter-app">
    <section class="mission-screen" id="mission-screen">
      <div class="mission-card">
        <span class="case-label"><span aria-hidden="true">●</span> {game.caseLabel}</span>
        <div class="mission-icon" aria-hidden="true"><Icon name="bug" size={42} /></div>
        <h1>{game.caseTitle}</h1>
        <p class="mission-copy">{game.caseText}</p>

        <div class="mission-facts">
          <span><Icon name="bug" size={18} /><b>{game.bugs.length}</b> أخطاء مخفية</span>
          <span><Icon name="clock" size={18} /><b>{game.durationSeconds}</b> ثانية بالتحدي</span>
          <span><Icon name="check" size={18} /> محاولة واحدة لكل Bug</span>
        </div>

        <div class="mode-grid">
          <button class="mode-card mode-challenge" type="button" data-start-mode="challenge">
            <span class="mode-tag">اختبر نفسك</span>
            <strong>{game.challengeLabel}</strong>
            <small>اصطد أكبر عدد قبل انتهاء الوقت</small>
            <span class="mode-action">ابدأ العد التنازلي <Icon name="arrow" size={17} /></span>
          </button>
          <button class="mode-card" type="button" data-start-mode="practice">
            <span class="mode-tag cyan">تعلّم بهدوء</span>
            <strong>{game.practiceLabel}</strong>
            <small>نفس الأسئلة بدون مؤقّت</small>
            <span class="mode-action">ابدأ التدريب <Icon name="arrow" size={17} /></span>
          </button>
        </div>
        <p class="attempt-note">{game.oneAttemptNote}</p>
      </div>
    </section>

    <section class="game-screen" id="game-screen" hidden aria-label="متجر The Broken Shop">
      <div class="game-toolbar">
        <div class="toolbar-brand"><Icon name="bug" size={22} /><span>BUG HUNTER</span><small>CASE 01</small></div>
        <div class="toolbar-stats">
          <span class="stat"><small>SCORE</small><b id="score-value">0000</b></span>
          <span class="stat"><small>FOUND</small><b><i id="found-value">0</i>/{game.bugs.length}</b></span>
          <span class="stat timer-stat" id="timer-stat"><small>TIME</small><b id="time-value">01:30</b></span>
          <button class="sound-toggle" id="sound-toggle" type="button" aria-label="إيقاف الصوت" aria-pressed="false">♪</button>
        </div>
      </div>

      <div class="progress-track" aria-hidden="true"><span id="game-progress"></span></div>

      <div class="shop-window">
        <header class="shop-header">
          <a href="#" tabindex="-1" class="shop-logo">BROKEN<span>SHOP</span></a>
          <label class="shop-search">⌕ <input tabindex="-1" value="Search products..." readonly /></label>
          <span class="shop-cart">CART <b>0</b></span>
        </header>

        <div class="shop-notice">FREE SHIPPING ON ORDERS OVER $50</div>

        <div class="shop-layout">
          <section class="catalog" aria-label="المنتجات">
            <div class="shop-heading"><div><small>NEW ARRIVALS</small><h2>Featured products</h2></div><span>12 products</span></div>
            <div class="product-grid">
              <article class="product-card issue-box">
                <div class="broken-image"><span>▧</span><small>IMG_404.JPG</small></div>
                <div class="product-copy"><small>AUDIO</small><h3>Wireless Headphones</h3><b>$29.00</b></div>
                <button class="fake-cart low-contrast" tabindex="-1">ADD TO CART</button>
                <button class="bug-marker marker-image" type="button" data-bug="broken-image" aria-label="افحص الصورة المكسورة"><span>🐞</span></button>
                <button class="bug-marker marker-contrast" type="button" data-bug="low-contrast" aria-label="افحص تباين الزر"><span>🐞</span></button>
              </article>

              <article class="product-card issue-box">
                <div class="product-art keyboard">⌨</div>
                <div class="product-copy"><small>ACCESSORIES</small><h3>Mechanical Keyboard</h3><b>$49.00</b></div>
                <button class="fake-cart dead-button" tabindex="-1">ADD TO CART</button>
                <button class="bug-marker marker-cart" type="button" data-bug="add-to-cart" aria-label="افحص زر الإضافة"><span>🐞</span></button>
              </article>

              <article class="product-card faded-card">
                <div class="product-art">▱</div>
                <div class="product-copy"><small>DESK</small><h3>Minimal Desk Lamp</h3><b>$36.00</b></div>
                <button class="fake-cart" tabindex="-1">ADD TO CART</button>
              </article>
            </div>

            <div class="mobile-preview issue-box">
              <span class="device-label">360 PX VIEWPORT</span>
              <div><b>Ready to checkout?</b><small>Your cart has 1 item</small></div>
              <button tabindex="-1">PROCEED TO CHECKOUT →</button>
              <button class="bug-marker marker-mobile" type="button" data-bug="mobile-overflow" aria-label="افحص عرض الموبايل"><span>🐞</span></button>
            </div>
          </section>

          <aside class="checkout-panel" aria-label="Checkout">
            <div class="panel-title"><div><small>SECURE CHECKOUT</small><h2>Your order</h2></div><span>🔒</span></div>

            <div class="order-line"><span>Wireless Headphones</span><b>$29.00</b></div>
            <div class="order-line"><span>Shipping</span><b>$4.00</b></div>
            <div class="order-line"><span>Discount</span><b>−$5.80</b></div>
            <div class="order-line order-total issue-box"><span>Total</span><b>$42.80</b>
              <button class="bug-marker marker-total" type="button" data-bug="wrong-total" aria-label="افحص إجمالي السلة"><span>🐞</span></button>
            </div>

            <label class="field issue-box"><span>Email address</span><input tabindex="-1" value="ahmad@" readonly />
              <small class="accepted">✓ Looks good</small>
              <button class="bug-marker marker-email" type="button" data-bug="invalid-email" aria-label="افحص البريد الإلكتروني"><span>🐞</span></button>
            </label>

            <div class="coupon issue-box"><input tabindex="-1" value="EXPIRED20" readonly /><button tabindex="-1">APPLY</button>
              <small>✓ Coupon applied successfully!</small>
              <button class="bug-marker marker-coupon" type="button" data-bug="expired-coupon" aria-label="افحص الكوبون"><span>🐞</span></button>
            </div>

            <div class="payment-status issue-box"><span>✓</span><div><b>Payment successful</b><small>POST /payments → 500</small></div>
              <button class="bug-marker marker-api" type="button" data-bug="false-payment-success" aria-label="افحص حالة الدفع"><span>🐞</span></button>
            </div>

            <div class="place-wrap issue-box">
              <button class="place-order" tabindex="-1">PLACE ORDER</button>
              <span class="double-click">Double-click registered: 2 orders</span>
              <button class="bug-marker marker-duplicate" type="button" data-bug="duplicate-order" aria-label="افحص تكرار الطلب"><span>🐞</span></button>
              <button class="bug-marker marker-keyboard" type="button" data-bug="keyboard-skip" aria-label="افحص الوصول بالكيبورد"><span>🐞</span></button>
            </div>
          </aside>
        </div>
      </div>
      <p class="game-tip">دور على علامات الـBug الحمراء واضغط عليها. كل إجابة صحيحة = 100 نقطة.</p>
    </section>

    <section class="result-screen" id="result-screen" hidden>
      <div class="result-card">
        <span class="result-kicker">CASE 01 • CLOSED</span>
        <div class="result-trophy" aria-hidden="true">🏆</div>
        <h1>{game.resultTitle}</h1>
        <p>{game.resultText}</p>
        <strong class="result-rank" id="result-rank">QA Intern</strong>
        <div class="result-grid">
          <div><small>SCORE</small><b><span id="result-score">0</span><i>/1000</i></b></div>
          <div><small>CORRECT</small><b><span id="result-correct">0</span><i>/{game.bugs.length}</i></b></div>
          <div><small>BEST</small><b><span id="result-best">0</span><i>/1000</i></b></div>
        </div>
        <div class="result-actions">
          <button class="btn btn-primary" id="play-again" type="button">العب مرة ثانية <Icon name="arrow" size={18} /></button>
          <button class="btn btn-ghost" id="share-result" type="button">شارك نتيجتك</button>
        </div>
        <p class="share-status" id="share-status" aria-live="polite"></p>
        <div class="learning-list" id="learning-list">
          <div class="learning-head"><span>خطوتك التالية</span><h2>قوّي النقاط اللي فاتتك</h2></div>
          <div id="resource-links"></div>
        </div>
      </div>
    </section>

    <div class="question-layer" id="question-layer" hidden>
      <div class="question-modal" role="dialog" aria-modal="true" aria-labelledby="question-title">
        <button class="modal-close" id="modal-close" type="button" aria-label="إغلاق السؤال">×</button>
        <span class="question-count" id="question-count">BUG 01 / 10</span>
        <div class="question-icon" aria-hidden="true">🐞</div>
        <p class="question-bug" id="question-bug"></p>
        <h2 id="question-title"></h2>
        <div class="answer-list" id="answer-list"></div>
        <div class="answer-feedback" id="answer-feedback" hidden>
          <strong id="feedback-title"></strong>
          <p id="feedback-copy"></p>
          <div id="expected-result" hidden><small>EXPECTED RESULT</small><span></span></div>
          <button class="btn btn-primary" id="continue-game" type="button">كمّل الصيد <Icon name="arrow" size={17} /></button>
        </div>
      </div>
    </div>

    <div class="swarm-layer" id="swarm-layer" aria-hidden="true"></div>
    <div class="game-toast" id="game-toast" role="status" aria-live="polite"></div>
  </main>

  <script type="application/json" id="bug-hunter-data" set:html={serializedGame}></script>
</Base>

<script is:inline>
  (() => {
    const dataNode = document.getElementById('bug-hunter-data');
    if (!dataNode) return;
    const settings = JSON.parse(dataNode.textContent || '{}');
    const byId = (id) => document.getElementById(id);
    const mission = byId('mission-screen');
    const gameScreen = byId('game-screen');
    const results = byId('result-screen');
    const layer = byId('question-layer');
    const answersEl = byId('answer-list');
    const feedback = byId('answer-feedback');
    const swarm = byId('swarm-layer');
    const toast = byId('game-toast');
    const markers = [...document.querySelectorAll('.bug-marker')];
    const storageKey = 'testing-arabic:bug-hunter:best';
    let mode = 'challenge';
    let active = false;
    let remaining = Number(settings.durationSeconds) || 90;
    let timer = null;
    let currentBug = null;
    let score = 0;
    let correct = 0;
    let answered = new Map();
    let muted = false;
    let audioContext = null;

    const shuffle = (items) => {
      const copy = [...items];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    };

    const playTone = (kind) => {
      if (muted) return;
      try {
        audioContext ||= new (window.AudioContext || window.webkitAudioContext)();
        const now = audioContext.currentTime;
        const osc = audioContext.createOscillator();
        const gain = audioContext.createGain();
        osc.type = kind === 'correct' ? 'sine' : 'sawtooth';
        osc.frequency.setValueAtTime(kind === 'correct' ? 520 : 170, now);
        if (kind === 'correct') osc.frequency.exponentialRampToValueAtTime(780, now + .22);
        gain.gain.setValueAtTime(.0001, now);
        gain.gain.exponentialRampToValueAtTime(.1, now + .015);
        gain.gain.exponentialRampToValueAtTime(.0001, now + .28);
        osc.connect(gain).connect(audioContext.destination);
        osc.start(now); osc.stop(now + .3);
      } catch (_) {}
    };

    const formatTime = (seconds) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(seconds % 60).padStart(2, '0')}`;

    const updateHud = () => {
      byId('score-value').textContent = String(score).padStart(4, '0');
      byId('found-value').textContent = String(answered.size);
      byId('time-value').textContent = formatTime(Math.max(0, remaining));
      byId('game-progress').style.width = `${(answered.size / settings.bugs.length) * 100}%`;
      byId('timer-stat').classList.toggle('urgent', mode === 'challenge' && remaining <= 15);
    };

    const resetGame = () => {
      score = 0; correct = 0; answered = new Map(); currentBug = null;
      remaining = Number(settings.durationSeconds) || 90;
      markers.forEach((marker) => {
        marker.disabled = false;
        marker.classList.remove('is-correct', 'is-wrong');
        marker.querySelector('span').textContent = '🐞';
      });
      feedback.hidden = true;
      answersEl.hidden = false;
      updateHud();
    };

    const startGame = (selectedMode) => {
      mode = selectedMode;
      resetGame();
      active = true;
      mission.hidden = true; results.hidden = true; gameScreen.hidden = false;
      byId('timer-stat').hidden = mode !== 'challenge';
      window.scrollTo({ top: 0, behavior: 'smooth' });
      clearInterval(timer);
      if (mode === 'challenge') {
        timer = setInterval(() => {
          remaining -= 1; updateHud();
          if (remaining <= 0) finishGame();
        }, 1000);
      }
    };

    const openQuestion = (bugId) => {
      if (!active || answered.has(bugId)) return;
      currentBug = settings.bugs.find((bug) => bug.id === bugId);
      if (!currentBug) return;
      const bugNumber = settings.bugs.findIndex((bug) => bug.id === bugId) + 1;
      byId('question-count').textContent = `BUG ${String(bugNumber).padStart(2, '0')} / ${settings.bugs.length}`;
      byId('question-bug').textContent = currentBug.title;
      byId('question-title').textContent = currentBug.question;
      answersEl.innerHTML = '';
      shuffle(currentBug.answers).forEach((answer, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'answer-option';
        button.innerHTML = `<span>${String.fromCharCode(65 + index)}</span><b></b>`;
        button.querySelector('b').textContent = answer;
        button.addEventListener('click', () => answerBug(answer, button));
        answersEl.append(button);
      });
      answersEl.hidden = false; feedback.hidden = true; layer.hidden = false;
      document.body.classList.add('modal-open');
      setTimeout(() => answersEl.querySelector('button')?.focus(), 30);
    };

    const localBurst = (marker) => {
      const rect = marker.getBoundingClientRect();
      for (let i = 0; i < 8; i++) {
        const bug = document.createElement('span');
        bug.className = 'falling-bug'; bug.textContent = '🐞';
        bug.style.left = `${rect.left + rect.width / 2 + (Math.random() * 30 - 15)}px`;
        bug.style.top = `${rect.top + rect.height / 2}px`;
        bug.style.setProperty('--drift', `${Math.random() * 100 - 50}px`);
        bug.style.animationDelay = `${Math.random() * .16}s`;
        document.body.append(bug);
        setTimeout(() => bug.remove(), 1300);
      }
    };

    const wrongSwarm = () => {
      swarm.innerHTML = '';
      for (let i = 0; i < 46; i++) {
        const bug = document.createElement('span');
        bug.textContent = '🐞';
        bug.style.left = `${Math.random() * 96}%`;
        bug.style.top = `${-15 - Math.random() * 80}px`;
        bug.style.animationDelay = `${Math.random() * .45}s`;
        bug.style.animationDuration = `${1.1 + Math.random() * .75}s`;
        bug.style.fontSize = `${18 + Math.random() * 26}px`;
        swarm.append(bug);
      }
      swarm.classList.add('show');
      setTimeout(() => swarm.classList.remove('show'), 2050);
    };

    const answerBug = (choice, button) => {
      if (!currentBug || answered.has(currentBug.id)) return;
      const isCorrect = choice === currentBug.correctAnswer;
      answered.set(currentBug.id, isCorrect);
      const marker = document.querySelector(`[data-bug="${CSS.escape(currentBug.id)}"]`);
      [...answersEl.children].forEach((option) => {
        option.disabled = true;
        const text = option.querySelector('b')?.textContent;
        if (text === currentBug.correctAnswer) option.classList.add('answer-correct');
      });
      if (isCorrect) {
        score += 100; correct += 1;
        button.classList.add('answer-correct');
        marker?.classList.add('is-correct');
        if (marker) { marker.querySelector('span').textContent = '✓'; localBurst(marker); }
        byId('feedback-title').textContent = currentBug.correctMessage;
        byId('feedback-title').className = 'correct-title';
        playTone('correct');
      } else {
        button.classList.add('answer-wrong');
        marker?.classList.add('is-wrong');
        if (marker) marker.querySelector('span').textContent = '×';
        byId('feedback-title').textContent = `مش هاي — الجواب الصحيح: ${currentBug.correctAnswer}`;
        byId('feedback-title').className = 'wrong-title';
        wrongSwarm(); playTone('wrong');
      }
      marker.disabled = true;
      // بعد اختيار الإجابة منعرض النتيجة لحالها حتى يظل الصندوق كامل داخل الشاشة.
      answersEl.hidden = true;
      byId('feedback-copy').textContent = currentBug.explanation;
      const expected = byId('expected-result');
      expected.hidden = !currentBug.expectedResult;
      expected.querySelector('span').textContent = currentBug.expectedResult || '';
      feedback.hidden = false;
      updateHud();
    };

    const closeQuestion = () => {
      if (layer.hidden) return;
      layer.hidden = true; document.body.classList.remove('modal-open');
      if (answered.size === settings.bugs.length) finishGame();
      else currentBug = null;
    };

    const finishGame = () => {
      if (!active) return;
      active = false; clearInterval(timer); layer.hidden = true;
      document.body.classList.remove('modal-open');
      const previousBest = Number(localStorage.getItem(storageKey) || 0);
      const best = Math.max(previousBest, score);
      localStorage.setItem(storageKey, String(best));
      const ranks = [...settings.ranks].sort((a, b) => a.min - b.min);
      const rank = ranks.filter((item) => correct >= item.min).at(-1)?.label || 'QA Intern';
      byId('result-rank').textContent = rank;
      byId('result-score').textContent = String(score);
      byId('result-correct').textContent = String(correct);
      byId('result-best').textContent = String(best);
      const missedIds = settings.bugs.filter((bug) => answered.get(bug.id) !== true).map((bug) => bug.id);
      const learningBugs = missedIds.length ? settings.bugs.filter((bug) => missedIds.includes(bug.id)) : settings.bugs.slice(0, 2);
      const resourceMap = new Map();
      learningBugs.flatMap((bug) => bug.resources || []).forEach((resource) => resourceMap.set(resource.href, resource));
      const resources = [...resourceMap.values()].slice(0, 6);
      byId('resource-links').innerHTML = '';
      resources.forEach((resource) => {
        const link = document.createElement('a');
        link.href = resource.href; link.target = '_blank'; link.rel = 'noopener';
        link.innerHTML = `<span><small></small><b></b></span><i>←</i>`;
        link.querySelector('small').textContent = resource.kind;
        link.querySelector('b').textContent = resource.label;
        byId('resource-links').append(link);
      });
      gameScreen.hidden = true; results.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    document.querySelectorAll('[data-start-mode]').forEach((button) => button.addEventListener('click', () => startGame(button.dataset.startMode)));
    markers.forEach((marker) => marker.addEventListener('click', () => openQuestion(marker.dataset.bug)));
    byId('continue-game').addEventListener('click', closeQuestion);
    byId('modal-close').addEventListener('click', closeQuestion);
    layer.addEventListener('click', (event) => { if (event.target === layer) closeQuestion(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !layer.hidden) closeQuestion(); });
    byId('play-again').addEventListener('click', () => { results.hidden = true; mission.hidden = false; window.scrollTo({top: 0, behavior: 'smooth'}); });
    byId('sound-toggle').addEventListener('click', (event) => {
      muted = !muted; event.currentTarget.setAttribute('aria-pressed', String(muted));
      event.currentTarget.setAttribute('aria-label', muted ? 'تشغيل الصوت' : 'إيقاف الصوت');
      event.currentTarget.textContent = muted ? '×♪' : '♪';
    });
    byId('share-result').addEventListener('click', async () => {
      const rank = byId('result-rank').textContent;
      const text = `اصطدت ${correct}/${settings.bugs.length} Bugs وجبت ${score}/1000 في Bug Hunter — رتبتي ${rank}! جرّب تتفوق عليّ:`;
      try {
        if (navigator.share) await navigator.share({ title: settings.caseTitle, text, url: location.href });
        else { await navigator.clipboard.writeText(`${text} ${location.href}`); byId('share-status').textContent = 'تم نسخ النتيجة والرابط ✓'; }
      } catch (_) {}
    });
  })();
</script>

<style>
  :global(body.modal-open) { overflow: hidden; }
  .hunter-page { min-height: calc(100vh - 80px); padding: 38px 24px 80px; background-color: var(--bg); }
  .mission-screen, .result-screen { max-width: 980px; margin: 0 auto; }
  .mission-card, .result-card { position: relative; overflow: hidden; padding: clamp(34px, 6vw, 66px); border: 1px solid var(--line-strong); border-radius: 24px; background: linear-gradient(145deg, var(--surface), color-mix(in srgb, var(--surface) 86%, #061022)); box-shadow: var(--shadow-lg); text-align: center; }
  .mission-card::after, .result-card::after { content: ''; position: absolute; width: 330px; height: 330px; top: -180px; left: -150px; border-radius: 50%; background: rgba(56,189,248,.12); filter: blur(8px); pointer-events: none; }
  .case-label, .result-kicker { display: inline-flex; align-items: center; gap: 9px; color: var(--orange); font: 600 13px 'IBM Plex Mono', monospace; letter-spacing: .8px; }
  .case-label span { color: #ef4444; text-shadow: 0 0 10px #ef4444; }
  .mission-icon { width: 86px; height: 86px; margin: 25px auto 16px; display: grid; place-items: center; border: 1px solid rgba(56,189,248,.4); border-radius: 22px; color: var(--cyan); background: var(--cyan-soft); box-shadow: var(--glow); transform: rotate(-5deg); }
  .mission-card h1, .result-card h1 { font-size: clamp(35px, 6vw, 60px); direction: ltr; }
  .mission-copy, .result-card > p { max-width: 720px; margin: 12px auto 0; color: var(--ink-3); font-size: 18px; }
  .mission-facts { display: flex; justify-content: center; flex-wrap: wrap; gap: 14px 26px; margin-top: 28px; color: var(--ink-2); }
  .mission-facts span { display: flex; align-items: center; gap: 7px; }
  .mission-facts :global(svg) { color: var(--cyan); }
  .mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 36px; text-align: right; }
  .mode-card { position: relative; min-height: 190px; padding: 25px; display: flex; flex-direction: column; align-items: flex-start; border: 1px solid var(--line-strong); border-radius: 17px; background: color-mix(in srgb, var(--surface-2) 72%, transparent); color: var(--ink); cursor: pointer; transition: .18s ease; }
