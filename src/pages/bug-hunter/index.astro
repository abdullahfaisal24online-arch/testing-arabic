  #expected-result { margin-top: 13px; padding: 11px 13px; display: flex; flex-direction: column; border-right: 3px solid #38bdf8; background: rgba(56,189,248,.07); }
  #expected-result[hidden] { display: none; }
  #expected-result small { color: #38bdf8; font: 8px 'IBM Plex Mono', monospace; }
  #expected-result span { color: #cfdaea; font-size: 13px; }
  .answer-feedback .btn { margin-top: 14px; min-height: 43px; padding-block: 9px; }
  .swarm-layer { position: fixed; z-index: 1200; inset: 0; overflow: hidden; pointer-events: none; visibility: hidden; background: rgba(190,18,60,0); transition: background .2s; }
  .swarm-layer.show { visibility: visible; background: rgba(190,18,60,.18); }
  .swarm-layer :global(span) { position: absolute; animation: swarm-fall 1.5s cubic-bezier(.18,.7,.3,1) forwards; filter: saturate(1.8) hue-rotate(-15deg) drop-shadow(0 5px 3px rgba(80,0,0,.25)); }
  :global(.falling-bug) { position: fixed; z-index: 1400; pointer-events: none; font-size: 21px; animation: local-fall 1.15s ease-in forwards; }
  .game-toast { position: fixed; z-index: 1500; left: 50%; bottom: 28px; translate: -50% 20px; opacity: 0; pointer-events: none; }
  .result-card { max-width: 900px; margin: 0 auto; }
  .result-trophy { margin: 20px 0 4px; font-size: 67px; filter: drop-shadow(0 13px 20px rgba(246,130,59,.24)); }
  .result-rank { display: inline-block; margin-top: 16px; padding: 7px 17px; border: 1px solid rgba(56,189,248,.35); border-radius: 999px; background: var(--cyan-soft); color: var(--cyan); font: 700 15px 'IBM Plex Mono', monospace; }
  .result-grid { max-width: 650px; margin: 30px auto 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .result-grid > div { padding: 18px 10px; border: 1px solid var(--line); border-radius: 13px; background: color-mix(in srgb, var(--surface-2) 65%, transparent); }
  .result-grid small { display: block; color: var(--muted); font: 9px 'IBM Plex Mono', monospace; }
  .result-grid b { color: var(--ink); font: 700 28px 'IBM Plex Mono', monospace; }
  .result-grid i { color: var(--faint); font-size: 12px; font-style: normal; }
  .result-actions { margin-top: 25px; display: flex; justify-content: center; flex-wrap: wrap; gap: 11px; }
  .share-status { min-height: 24px; margin-top: 5px; color: #4ade80; font-size: 13px; }
  .learning-list { margin-top: 30px; padding-top: 28px; border-top: 1px solid var(--line); text-align: right; }
  .learning-head span { color: var(--orange); font-size: 12px; }
  .learning-head h2 { font-size: 24px; }
  #resource-links { margin-top: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  #resource-links :global(a) { padding: 13px 15px; display: flex; justify-content: space-between; align-items: center; gap: 10px; border: 1px solid var(--line); border-radius: 10px; color: var(--ink); background: color-mix(in srgb, var(--surface-2) 55%, transparent); }
  #resource-links :global(a:hover) { border-color: var(--cyan); }
  #resource-links :global(a span) { display: flex; flex-direction: column; }
  #resource-links :global(a small) { color: var(--cyan); font-size: 10px; }
  #resource-links :global(a b) { font-size: 13px; }
  #resource-links :global(a i) { color: var(--orange); font-style: normal; }
  @keyframes marker-pulse { 50% { transform: scale(1.1); box-shadow: 0 0 0 11px rgba(239,68,68,0), 0 8px 14px rgba(127,29,29,.25); } }
  @keyframes urgent-pulse { to { opacity: .45; } }
  @keyframes swarm-fall { to { transform: translate3d(calc(var(--drift, 0px)), 115vh, 0) rotate(720deg); } }
  @keyframes local-fall { to { transform: translate3d(var(--drift), 180px, 0) rotate(450deg); opacity: 0; } }
  @media (max-width: 1000px) {
    .shop-layout { grid-template-columns: 1fr; }
    .checkout-panel { border: 0; border-top: 1px solid #dce3ec; }
  }
  @media (max-width: 720px) {
    .hunter-page { padding: 18px 12px 55px; }
    .mode-grid { grid-template-columns: 1fr; }
    .game-hud { top: 72px; }
    .game-toolbar { min-height: 58px; padding: 8px 9px; gap: 8px; border-radius: 12px 12px 0 0; }
    .toolbar-brand { display: none; }
    .toolbar-stats { width: 100%; margin: 0; }
    .stat { min-width: 0; min-height: 40px; flex: 1; padding: 5px 3px; }
    .stat b { font-size: 14px; }
    .sound-toggle { flex: 0 0 38px; width: 38px; height: 38px; }
    .end-game { inset-inline-end: 6px; min-width: 64px; font-size: 9px; padding-inline: 7px; }
    .product-grid { grid-template-columns: 1fr 1fr; }
