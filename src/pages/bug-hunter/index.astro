    .product-grid { grid-template-columns: 1fr; }
    .toolbar-brand small { display: none; }
    .stat { padding-block: 6px; }
    .question-modal { padding-inline: 14px; }
  }

  /* ===== اختيار الـ Case ===== */
  .picker-screen { max-width: 1180px; margin: 0 auto; }
  .picker-head { text-align: center; }
  .picker-head h1 { margin-top: 12px; font-size: clamp(32px, 5vw, 52px); }
  .picker-head p { max-width: 640px; margin: 10px auto 0; color: var(--ink-3); font-size: 17px; }
  .case-grid { margin-top: 34px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .case-card { position: relative; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line-strong); border-radius: 20px; background: linear-gradient(160deg, var(--surface), color-mix(in srgb, var(--surface) 86%, #061022)); box-shadow: var(--shadow-lg); transition: transform .18s ease, border-color .18s ease; }
  .case-card:not(.soon) { cursor: pointer; }
  .case-card:not(.soon):hover, .case-card:not(.soon):focus-visible { transform: translateY(-4px); border-color: var(--orange-line); outline: none; box-shadow: var(--shadow-lg), 0 0 0 1px var(--orange-line); }
  .case-card:not(.soon):hover .case-thumb > img { transform: scale(1.04); }
  .case-thumb > img { transition: transform .35s ease; }
  .case-thumb { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #081226; }
  .case-thumb > img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .case-thumb-ph { position: absolute; inset: 0; display: grid; place-items: center; background: radial-gradient(260px 160px at 50% 60%, rgba(246,130,59,.18), transparent 70%), linear-gradient(160deg, #0b1729, #0e1f3a); }
  .case-thumb-ph img { width: 64px; height: auto; opacity: .55; transform: rotate(18deg); }
  .soon .case-thumb { filter: grayscale(.6) brightness(.6); }
  .case-lock { position: absolute; inset: 0; display: grid; place-items: center; font-size: 46px; }
  .case-badge { position: absolute; top: 12px; left: 12px; padding: 5px 14px; border-radius: 999px; font-size: 13px; font-weight: 800; box-shadow: 0 6px 16px rgba(0,0,0,.35); }
  .case-badge[hidden] { display: none; }
  .case-badge.done { background: #047857; border: 1px solid #34d399; color: #ecfdf5; }
  .case-badge.new { background: #f6823b; border: 1px solid #ffb07c; color: #1a0d04; }
  .case-body { flex: 1; display: flex; flex-direction: column; padding: 18px 20px 20px; }
  .case-kicker { color: var(--orange); font: 700 12px 'IBM Plex Mono', monospace; letter-spacing: .5px; direction: ltr; text-align: right; }
  .case-body h2 { margin: 6px 0 4px; font-size: 24px; direction: ltr; text-align: right; }
  .case-body p { color: var(--ink-3); font-size: 14.5px; line-height: 1.75; }
  .case-meta { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px; }
  .case-meta span { padding: 3px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--cyan-soft); color: var(--ink-2); font-size: 12.5px; font-weight: 600; }
  .case-cta { margin-top: auto; padding-top: 16px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .case-progress { color: var(--muted); font-size: 13px; }
  .case-progress :global(b) { color: #34d399; }
  .case-go { min-height: 42px; padding: 8px 16px; }
  .back-cases { position: absolute; top: 18px; right: 20px; z-index: 2; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink-3); font: inherit; font-size: 13px; cursor: pointer; }
  .back-cases:hover { border-color: var(--cyan); color: var(--cyan); }
  .trap-note { display: block; margin-top: 6px; color: #6ee7b7; }
  .mission-facts span[hidden] { display: none; }

  /* ===== عناصر الفخاخ بالمتجر ===== */
  .sale-tag { position: absolute; top: 18px; left: 18px; z-index: 2; padding: 3px 8px; border-radius: 5px; background: #ef4444; color: #fff; font: 700 10px 'IBM Plex Mono', monospace; }
  .product-copy b s { margin-left: 6px; color: #94a3b8; font-size: 11px; font-weight: 600; }
  .soldout-card .product-art { opacity: .55; }
  .stock-tag { position: absolute; top: 18px; left: 18px; z-index: 2; padding: 3px 8px; border-radius: 5px; background: #64748b; color: #fff; font: 700 9px 'IBM Plex Mono', monospace; }
  .fake-cart.soldout { background: #cbd5e1; color: #64748b; cursor: not-allowed; }
  .marker-sale { top: 176px; right: 8px; animation-delay: -1.1s; }
  .marker-soldout { bottom: 8px; left: 44%; animation-delay: -.3s; }
  .bug-marker[hidden] { display: none; }
  .bug-marker.is-trap { border-color: #10b981; background: #d1fae5; box-shadow: 0 0 0 7px rgba(16,185,129,.14); animation: none; }

  /* ===== Scene: Login ===== */
  .auth-window { overflow: hidden; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 18px 18px; background: linear-gradient(160deg, #eef2f7, #e3eaf3); color: #152039; direction: ltr; box-shadow: var(--shadow-lg); }
  .auth-window[hidden], .shop-window[hidden] { display: none; }
  .auth-top { min-height: 62px; padding: 14px 28px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #d8e0ea; background: #fff; }
  .auth-logo { font: 800 17px 'IBM Plex Mono', monospace; color: #0e1c34; }
  .auth-logo span { color: #2563eb; }
  .auth-links { display: flex; gap: 18px; color: #64748b; font-size: 12px; }
  .auth-grid { padding: clamp(18px, 3vw, 34px); display: grid; grid-template-columns: 1fr 1fr 290px; gap: 18px; align-items: start; }
  .auth-card { position: relative; padding: 22px 20px; border: 1px solid #dfe5ee; border-radius: 14px; background: #fff; box-shadow: 0 12px 30px rgba(15,29,54,.07); }
  .auth-card h2 { margin: 2px 0 14px; font: 800 22px system-ui, sans-serif; }
  .auth-kicker { color: #2563eb; font: 700 8px 'IBM Plex Mono', monospace; letter-spacing: 1px; }
  .a-field { position: relative; display: flex; flex-direction: column; margin-top: 12px; }
  .a-field > span { margin-bottom: 5px; font-size: 10.5px; font-weight: 700; color: #334155; display: flex; justify-content: space-between; }
  .a-field > span em { font-style: normal; font-weight: 500; color: #64748b; }
  .a-input { width: 100%; padding: 10px 11px; border: 1px solid #cfd8e3; border-radius: 7px; background: #fff; color: #152039; font: 13px 'IBM Plex Mono', monospace; white-space: pre; }
  .a-input.bad { border-color: #ef4444; background: #fff5f5; }
  .a-err { margin-top: 4px; color: #dc2626; font-size: 10px; }
  .a-ok { margin-top: 4px; color: #16a34a; font-size: 10px; }
  .a-pass { position: relative; display: block; }
  .a-pass .eye { position: absolute; right: 9px; top: 50%; translate: 0 -50%; font-size: 13px; opacity: .45; }
  .a-pass .eye.on { opacity: 1; filter: drop-shadow(0 0 4px rgba(37,99,235,.6)); }
  .a-row { margin-top: 12px; display: flex; justify-content: space-between; align-items: center; font-size: 11px; }
  .a-check { display: flex; align-items: center; gap: 7px; color: #334155; }
  .a-check .box { width: 14px; height: 14px; border: 1.5px solid #94a3b8; border-radius: 4px; background: #fff; }
  .a-check i { color: #dc2626; font-style: normal; }
  .a-link { color: #2563eb; }
  .a-alert { position: relative; margin-top: 14px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; border: 1px solid #fecaca; border-radius: 8px; background: #fef2f2; color: #b91c1c; }
  .a-alert b { font: 700 11.5px 'IBM Plex Mono', monospace; }
  .a-alert small { font: 9px 'IBM Plex Mono', monospace; color: #dc2626; }
  .a-terms { position: relative; margin-top: 14px; font-size: 11px; }
  .a-success { margin-top: 8px; padding: 7px 10px; border: 1px solid #86efac; border-radius: 7px; background: #f0fdf4; color: #15803d; font-size: 11px; font-weight: 700; }
  .a-btn { width: 100%; margin-top: 14px; padding: 12px; border: 0; border-radius: 7px; background: #0f1d36; color: #fff; font: 800 10px 'IBM Plex Mono', monospace; letter-spacing: .5px; }
  .a-btn.orange { background: #f06e37; }
  .a-btn.ghost { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }
  .auth-side { display: flex; flex-direction: column; gap: 18px; }
  .auth-card.mini { padding: 18px 16px; }
  .mini-t { display: block; margin-top: 4px; font-size: 14px; }
  .mini-s { display: block; margin-top: 3px; color: #64748b; font-size: 10.5px; }
  .otp { margin-top: 10px; display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; }
  .otp span { height: 32px; display: grid; place-items: center; border: 1px solid #cfd8e3; border-radius: 6px; font: 700 14px 'IBM Plex Mono', monospace; }
  .dash-user { margin-top: 10px; display: flex; gap: 10px; align-items: center; }
  .dash-user .av { flex: 0 0 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: #fce7f3; color: #be185d; font-weight: 800; }
  .dash-user b { display: block; font-size: 12.5px; }
  .dash-user small { color: #64748b; font-size: 10.5px; }
  .m-email-trim { top: 18px; right: -14px; }
  .m-pass-visible { top: 18px; right: -14px; animation-delay: -.5s; }
  .m-error { top: -14px; right: -12px; animation-delay: -.9s; }
  .m-arabic { top: 18px; left: -14px; animation-delay: -.3s; }
  .m-length { top: 44px; right: -14px; animation-delay: -1.2s; }
  .m-toggle { top: 20px; right: 34px; animation-delay: -.7s; }
  .m-confirm { top: 44px; right: -14px; animation-delay: -.2s; }
  .m-terms { top: 18px; right: -14px; animation-delay: -1s; }
  .m-resend { bottom: 14px; right: 14px; animation-delay: -.6s; }
  .m-user { top: 12px; right: 12px; animation-delay: -.4s; }

  /* ===== مودال الفخ ===== */
  .question-modal.trap-mode { border-color: rgba(52,211,153,.6); }
  .question-modal.trap-mode .question-icon { border-color: rgba(52,211,153,.5); background: rgba(52,211,153,.12); }
  .question-modal.trap-mode .question-count { color: #34d399; }
  .trap-title { color: #6ee7b7; font-size: 22px !important; }
  .trap-title :global(small) { margin-inline-start: 8px; color: #fb7185; font: 700 15px 'IBM Plex Mono', monospace; }
  #trap-rule { margin-top: 12px; padding: 11px 13px; border: 1px dashed rgba(56,189,248,.4); border-radius: 10px; background: rgba(56,189,248,.07); color: #cfe6fb; font-size: 13px; line-height: 1.8; }
  #trap-rule[hidden] { display: none; }
  #trap-rule b { color: #38bdf8; }

  /* ===== تقرير النهاية ===== */
  .result-card { max-width: 1120px; }
  .result-grid { max-width: 820px; grid-template-columns: repeat(4, 1fr); }
  .result-grid b.tr { color: #fb7185; }
  .report-wrap { margin-top: 30px; display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 22px; text-align: right; }
  .jira { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: color-mix(in srgb, var(--surface-2) 70%, transparent); }
  .jira-head { padding: 14px 18px; border-bottom: 1px solid var(--line); background: rgba(3,10,24,.25); direction: ltr; text-align: left; }
  .jira-head b { display: block; font-size: 17px; }
  .jira-head small { color: var(--muted); font-size: 12px; }
  .jira-table-wrap { overflow-x: auto; }
  .jira-table { width: 100%; border-collapse: collapse; direction: ltr; text-align: left; font-size: 13px; }
  .jira-table th { padding: 9px 14px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 11px; font-weight: 600; white-space: nowrap; }
  .jira-table :global(td) { padding: 10px 14px; border-bottom: 1px solid color-mix(in srgb, var(--line) 50%, transparent); vertical-align: middle; }
  .jira-table :global(td.k) { color: var(--cyan); font: 600 12px 'IBM Plex Mono', monospace; white-space: nowrap; }
  .jira-table :global(td.t) { font-weight: 600; color: var(--ink); }
  .jira-table :global(td.s) { font-size: 12px; font-weight: 700; white-space: nowrap; }
  .jira-table :global(tr.st-found td.s) { color: #34d399; }
  .jira-table :global(tr.st-wrong td.s) { color: #fb7185; }
  .jira-table :global(tr.st-missed td) { opacity: .5; }
  .jira-table :global(.sev), #print-report :global(.sev) { display: inline-block; padding: 2px 9px; border-radius: 5px; font: 700 10.5px 'IBM Plex Mono', monospace; }
  .jira-table :global(.sev-critical) { background: rgba(239,68,68,.16); color: #fca5a5; }
  .jira-table :global(.sev-high) { background: rgba(246,130,59,.16); color: #fdba74; }
  .jira-table :global(.sev-medium) { background: rgba(247,201,72,.14); color: #fde68a; }
  .jira-table :global(.sev-low) { background: rgba(56,189,248,.12); color: #7dd3fc; }
  .jira-foot { padding: 14px 18px; display: flex; flex-wrap: wrap; align-items: end; gap: 12px; justify-content: space-between; background: rgba(3,10,24,.2); }
  .tester { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--muted); }
  .tester input { min-width: 200px; padding: 9px 11px; border: 1px solid var(--line-strong); border-radius: 9px; background: var(--surface); color: var(--ink); font: inherit; }
  .share-card { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .share-card img { width: 100%; height: auto; aspect-ratio: 1 / 1; border-radius: 16px; border: 1px solid var(--line); background: #0b162a; }
  .share-card figcaption { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .share-card .btn { min-height: 42px; padding: 8px 10px; font-size: 14px; }
  .learning-list[hidden] { display: none; }
  #print-report { display: none; }

  @media (max-width: 1100px) {
    .auth-grid { grid-template-columns: 1fr 1fr; }
    .auth-side { grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 1000px) {
    .case-grid { grid-template-columns: 1fr 1fr; }
    .report-wrap { grid-template-columns: 1fr; }
    .share-card { max-width: 420px; margin-inline: auto; width: 100%; }
  }
  @media (max-width: 720px) {
    .case-grid { grid-template-columns: 1fr; }
    .auth-grid, .auth-side { grid-template-columns: 1fr; }
    .auth-top { padding-inline: 16px; }
    .result-grid { grid-template-columns: 1fr 1fr; }
    .back-cases { position: static; margin-bottom: 12px; }
    .jira-foot .btn { width: 100%; }
    .tester, .tester input { width: 100%; }
    .jira-table thead { display: none; }
    .jira-table :global(tr) { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "k sev s" "t t t"; gap: 6px 10px; align-items: center; padding: 11px 14px; border-bottom: 1px solid color-mix(in srgb, var(--line) 50%, transparent); }
    .jira-table :global(td) { padding: 0; border: 0; }
    .jira-table :global(td.k) { grid-area: k; }
    .jira-table :global(td:nth-child(3)) { grid-area: sev; justify-self: start; }
