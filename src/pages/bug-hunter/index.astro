    .shop-cart { margin-left: auto; }
    .mobile-preview { align-items: flex-start; flex-direction: column; }
    .mobile-preview > button:not(.bug-marker) { width: calc(100% + 95px); margin: 0 -95px 0 0; }
    .result-grid { grid-template-columns: 1fr; }
    #resource-links { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .question-layer { padding: 10px; }
    .question-modal { width: 100%; max-height: calc(100dvh - 20px); padding: 20px 16px 16px; border-radius: 15px; }
    .question-icon { width: 38px; height: 38px; margin-top: 8px; font-size: 18px; }
    .question-bug { margin-top: 7px; font-size: 12px; }
    .question-modal h2 { font-size: clamp(17px, 5vw, 21px); line-height: 1.45; }
    .answer-list { grid-template-columns: 1fr; margin-top: 12px; gap: 7px; }
    :global(.answer-option) { min-height: 52px; padding: 9px 11px; }
    :global(.answer-option > span) { flex-basis: 28px; width: 28px; height: 28px; }
    :global(.answer-option b) { font-size: 14.5px; line-height: 1.5; }
    .answer-feedback { margin-top: 11px; padding-top: 11px; }
    #expected-result { margin-top: 9px; padding: 8px 10px; }
    .answer-feedback .btn { width: 100%; margin-top: 11px; }
  }
  @media (max-height: 720px) and (min-width: 641px) {
    .question-layer { padding: 10px; }
    .question-modal { max-height: calc(100dvh - 20px); padding: 19px 25px; }
    .question-icon { width: 36px; height: 36px; margin-top: 6px; font-size: 17px; }
    .question-bug { margin-top: 6px; }
    .question-modal h2 { font-size: 20px; line-height: 1.4; }
    .answer-list { margin-top: 10px; gap: 7px; }
    :global(.answer-option) { min-height: 54px; padding-block: 9px; }
  }
  @media (max-width: 460px) {
