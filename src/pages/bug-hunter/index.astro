      try { history.replaceState(null, '', location.pathname); } catch (_) {}
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const resetGame = () => {
      score = 0; correct = 0; answered = new Map(); trapped = new Set(); currentBug = null;
      remaining = Number(C.durationSeconds) || 90;
      document.querySelectorAll('.scene').forEach((s) => { s.hidden = s.dataset.scene !== C.scene; });
      const bugIds = new Set(C.bugs.map((b) => b.id)), trapIds = new Set(C.traps.map((t) => t.id));
      markers().forEach((marker) => {
        const ok = marker.dataset.bug ? bugIds.has(marker.dataset.bug) : trapIds.has(marker.dataset.trap);
        marker.hidden = !ok; marker.disabled = false;
        marker.classList.remove('is-correct', 'is-wrong', 'is-trap');
        marker.querySelector('span').textContent = '🐞';
      });
      byId('hud-case').textContent = caseNum(C);
      gameScreen.setAttribute('aria-label', C.caseTitle);
      feedback.hidden = true; answersEl.hidden = false;
      updateHud();
    };

    const startGame = (selectedMode) => {
      stopMusic();
      mode = selectedMode;
      if (mode === 'challenge' && !muted) unlockAudio();
      resetGame();
      active = true;
      window.taTrack?.('bug_hunter_start', { mode: selectedMode, bug_count: C.bugs.length, case_id: C.id });
      document.body.classList.add('bug-hunter-active');
      if (picker) picker.hidden = true;
      mission.hidden = true; results.hidden = true; gameScreen.hidden = false;
      byId('timer-stat').hidden = mode !== 'challenge';
      window.scrollTo({ top: 0, behavior: 'smooth' });
      clearInterval(timer);
      if (mode === 'challenge') {
        startMusic();
        timer = setInterval(() => { remaining -= 1; updateHud(); if (remaining <= 0) finishGame('timeout'); }, 1000);
      }
    };

    const openLayer = () => { layer.hidden = false; document.body.classList.add('modal-open'); };
    const openQuestion = (bugId) => {
      if (!active || answered.has(bugId)) return;
      currentBug = C.bugs.find((bug) => bug.id === bugId);
      if (!currentBug) return;
      modal.classList.remove('trap-mode');
      byId('question-icon').textContent = '🐞';
      const bugNumber = C.bugs.findIndex((bug) => bug.id === bugId) + 1;
      byId('question-count').textContent = `BUG ${String(bugNumber).padStart(2, '0')} / ${C.bugs.length}`;
      byId('question-bug').textContent = currentBug.title;
      byId('question-title').textContent = currentBug.question;
      answersEl.innerHTML = '';
      shuffle(currentBug.answers).forEach((answer, index) => {
        const button = document.createElement('button');
        button.type = 'button'; button.className = 'answer-option';
        button.innerHTML = `<span>${String.fromCharCode(65 + index)}</span><b></b>`;
        button.querySelector('b').textContent = answer;
        button.addEventListener('click', () => answerBug(answer, button));
        answersEl.append(button);
      });
      byId('trap-rule').hidden = true;
      answersEl.hidden = false; feedback.hidden = true; openLayer();
      setTimeout(() => answersEl.querySelector('button')?.focus(), 30);
    };

    // فخ Not a Bug: بلاغ غلط = خصم نقاط مع شرح ليش هو سلوك مقصود
    const openTrap = (trapId, marker) => {
      if (!active || trapped.has(trapId)) return;
      const trap = C.traps.find((t) => t.id === trapId); if (!trap) return;
      trapped.add(trapId); currentBug = null;
      score = Math.max(0, score - PENALTY);
      marker.disabled = true; marker.classList.add('is-trap'); marker.querySelector('span').textContent = '🧐';
      modal.classList.add('trap-mode');
      byId('question-icon').textContent = '🟢';
      byId('question-count').textContent = 'NOT A BUG';
      byId('question-bug').textContent = trap.title;
      byId('question-title').textContent = '';
      answersEl.hidden = true; answersEl.innerHTML = '';
      byId('feedback-title').innerHTML = `Not a Bug! <small>−${PENALTY}</small>`;
      byId('feedback-title').className = 'trap-title';
      byId('feedback-copy').textContent = trap.explanation;
      byId('trap-rule').hidden = false;
      byId('expected-result').hidden = true;
      feedback.hidden = false; openLayer(); playTone('trap');
      window.taTrack?.('bug_hunter_trap', { case_id: C.id, trap_id: trapId });
      updateHud();
      setTimeout(() => byId('continue-game')?.focus(), 30);
    };

    const localBurst = (marker) => {
      const rect = marker.getBoundingClientRect();
      for (let i = 0; i < 8; i++) {
        const bug = document.createElement('span');
        bug.className = 'falling-bug'; bug.textContent = '🐞';
        bug.style.left = `${rect.left + rect.width / 2 + (Math.random() * 30 - 15)}px`;
        bug.style.top = `${rect.top + rect.height / 2}px`;
        bug.style.setProperty('--drift', `${Math.random() * 100 - 50}px`);
        bug.style.animationDelay = `${Math.random() * .16}s`;
        document.body.append(bug);
        setTimeout(() => bug.remove(), 1300);
      }
    };
    const wrongSwarm = () => {
      swarm.innerHTML = '';
      for (let i = 0; i < 46; i++) {
        const bug = document.createElement('span');
        bug.textContent = '🐞';
        bug.style.left = `${Math.random() * 96}%`;
        bug.style.top = `${-15 - Math.random() * 80}px`;
        bug.style.animationDelay = `${Math.random() * .45}s`;
        bug.style.animationDuration = `${1.1 + Math.random() * .75}s`;
        bug.style.fontSize = `${18 + Math.random() * 26}px`;
        swarm.append(bug);
      }
      swarm.classList.add('show');
      setTimeout(() => swarm.classList.remove('show'), 2050);
    };

    const answerBug = (choice, button) => {
      if (!currentBug || answered.has(currentBug.id)) return;
      const isCorrect = choice === currentBug.correctAnswer;
      answered.set(currentBug.id, isCorrect);
      const marker = scene()?.querySelector(`[data-bug="${CSS.escape(currentBug.id)}"]`);
      [...answersEl.children].forEach((option) => {
        option.disabled = true;
        if (option.querySelector('b')?.textContent === currentBug.correctAnswer) option.classList.add('answer-correct');
      });
      if (isCorrect) {
        score += 100; correct += 1;
        button.classList.add('answer-correct');
        marker?.classList.add('is-correct');
        if (marker) { marker.querySelector('span').textContent = '✓'; localBurst(marker); }
        byId('feedback-title').textContent = currentBug.correctMessage;
        byId('feedback-title').className = 'correct-title';
        playTone('correct');
      } else {
        button.classList.add('answer-wrong');
        marker?.classList.add('is-wrong');
        if (marker) marker.querySelector('span').textContent = '×';
        byId('feedback-title').textContent = `مش هاي — الجواب الصحيح: ${currentBug.correctAnswer}`;
        byId('feedback-title').className = 'wrong-title';
        wrongSwarm(); playTone('wrong');
      }
      if (marker) marker.disabled = true;
      // بعد اختيار الإجابة منعرض النتيجة لحالها حتى يظل الصندوق كامل داخل الشاشة.
      answersEl.hidden = true;
      byId('feedback-copy').textContent = currentBug.explanation;
      const expected = byId('expected-result');
      expected.hidden = !currentBug.expectedResult;
      expected.querySelector('span').textContent = currentBug.expectedResult || '';
      byId('trap-rule').hidden = true;
      feedback.hidden = false;
      updateHud();
    };

    const closeQuestion = () => {
      if (layer.hidden) return;
      layer.hidden = true; document.body.classList.remove('modal-open');
      if (answered.size === C.bugs.length) finishGame('completed');
      else currentBug = null;
    };

    /* ---------- التقرير (Jira) + البطاقة + PDF ---------- */
    const SEV_ORDER = { CRITICAL: 0, HIGH: 1, MEDIUM: 2, LOW: 3 };
    const keyPrefix = () => `BH${caseNum(C).replace(/\D/g, '') || ''}`;
    let last = null; // آخر نتيجة (للـ PDF والمشاركة)
    const rowsData = () => C.bugs
      .map((b, i) => ({ b, i, st: answered.has(b.id) ? (answered.get(b.id) ? 'found' : 'wrong') : 'missed' }))
      .sort((x, y) => (SEV_ORDER[x.b.severity] ?? 9) - (SEV_ORDER[y.b.severity] ?? 9) || x.i - y.i)
      .map((r, n) => ({ ...r, key: `${keyPrefix()}-${101 + n}` }));
    const statusLabel = { found: '✓ Found', wrong: '✗ Wrong answer', missed: 'Missed' };
    const renderJira = () => {
      const tb = byId('j-rows'); tb.textContent = '';
      rowsData().forEach(({ b, st, key }) => {
        const tr = document.createElement('tr'); tr.className = `st-${st}`;
        tr.innerHTML = '<td class="k"></td><td class="t"></td><td><span class="sev"></span></td><td class="s"></td>';
        tr.querySelector('.k').textContent = key;
        tr.querySelector('.t').textContent = b.reportTitle;
        const sv = tr.querySelector('.sev'); sv.textContent = b.severity; sv.classList.add(`sev-${b.severity.toLowerCase()}`);
        tr.querySelector('.s').textContent = statusLabel[st];
        tb.append(tr);
      });
      byId('j-title').textContent = `Bug Report — ${C.caseTitle}`;
      byId('j-meta').textContent = `${new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })} · ${mode === 'challenge' ? 'Challenge Mode' : 'Practice Mode'} · Found ${correct}/${C.bugs.length} · Not a Bug ${trapped.size}`;
    };

    const loadImg = (src) => new Promise((res) => { const i = new Image(); i.onload = () => res(i); i.onerror = () => res(null); i.src = src; });
    const roundRect = (x, rx, ry, w, h, r) => { x.beginPath(); x.moveTo(rx + r, ry); x.arcTo(rx + w, ry, rx + w, ry + h, r); x.arcTo(rx + w, ry + h, rx, ry + h, r); x.arcTo(rx, ry + h, rx, ry, r); x.arcTo(rx, ry, rx + w, ry, r); x.closePath(); };
    const makeCard = async () => {
      const c = document.createElement('canvas'); c.width = 1080; c.height = 1080; const x = c.getContext('2d');
      const g = x.createLinearGradient(0, 0, 1080, 1080); g.addColorStop(0, '#070f1e'); g.addColorStop(1, '#0f1d37'); x.fillStyle = g; x.fillRect(0, 0, 1080, 1080);
      const r1 = x.createRadialGradient(860, 120, 10, 860, 120, 620); r1.addColorStop(0, 'rgba(56,189,248,.22)'); r1.addColorStop(1, 'rgba(56,189,248,0)'); x.fillStyle = r1; x.fillRect(0, 0, 1080, 1080);
      const r2 = x.createRadialGradient(120, 1000, 10, 120, 1000, 560); r2.addColorStop(0, 'rgba(246,130,59,.2)'); r2.addColorStop(1, 'rgba(246,130,59,0)'); x.fillStyle = r2; x.fillRect(0, 0, 1080, 1080);
      x.fillStyle = 'rgba(56,189,248,.12)'; for (let yy = 22; yy < 1080; yy += 44) for (let xx = 22; xx < 1080; xx += 44) { x.beginPath(); x.arc(xx, yy, 1.6, 0, 7); x.fill(); }
      const lb = await loadImg('/brand/ladybug.webp');
      if (lb) { x.save(); x.translate(880, 190); x.rotate(0.35); x.shadowColor = 'rgba(0,0,0,.5)'; x.shadowBlur = 30; x.drawImage(lb, -95, -105, 190, 210); x.restore(); }
      x.textAlign = 'center'; x.textBaseline = 'alphabetic';
      x.fillStyle = '#f6823b'; x.font = '700 34px "IBM Plex Mono", monospace'; x.fillText(`BUG HUNTER · ${caseNum(C)}`, 540, 250);
      x.fillStyle = '#f0f6ff'; x.font = '700 74px "IBM Plex Sans Arabic", sans-serif'; x.fillText(last.rank, 540, 360);
      x.fillStyle = '#f6823b'; x.font = '700 210px "IBM Plex Mono", monospace'; x.fillText(String(last.score), 540, 580);
      const pills = [`${last.correct} / ${last.total} Bugs`, `Not a Bug ${last.traps}`];
      x.font = '600 34px "IBM Plex Sans Arabic", sans-serif';
      const pw = pills.map((p) => x.measureText(p).width + 60), totalW = pw.reduce((a, b) => a + b, 0) + 24;
      let px0 = 540 - totalW / 2;
      pills.forEach((p, i) => { x.strokeStyle = 'rgba(56,189,248,.45)'; x.lineWidth = 2; roundRect(x, px0, 628, pw[i], 64, 32); x.stroke(); x.fillStyle = '#cfe6fb'; x.fillText(p, px0 + pw[i] / 2, 672); px0 += pw[i] + 24; });
      x.fillStyle = '#f0f6ff'; x.font = '700 60px "IBM Plex Sans Arabic", sans-serif'; x.direction = 'rtl'; x.fillText('بتقدر تلاقي أكثر؟', 540, 810); x.direction = 'ltr';
      x.font = '600 36px "IBM Plex Mono", monospace'; const url = 'testing-arabic.com/bug-hunter', uw = x.measureText(url).width + 70;
      x.fillStyle = '#f6823b'; roundRect(x, 540 - uw / 2, 870, uw, 80, 18); x.fill(); x.fillStyle = '#1a0d04'; x.fillText(url, 540, 923);
      return c;
    };
    const cardBlob = async () => { const c = await makeCard(); return new Promise((res) => c.toBlob(res, 'image/png')); };
    const renderCardPreview = async () => { const c = await makeCard(); byId('share-card-img').src = c.toDataURL('image/png'); };

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
    const buildPrint = () => {
      const name = (byId('tester-name').value || '').trim() || 'Testing بالعربي player';
      try { localStorage.setItem('testing-arabic:bug-hunter:tester', name); } catch (_) {}
      const date = new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
      const rows = rowsData().map(({ b, st, key }) => `<tr class="st-${st}"><td class="k">${esc(key)}</td><td><b>${esc(b.reportTitle)}</b>${b.expectedResult ? `<div class="exp"><span>Expected:</span> <bdi dir="auto">${esc(b.expectedResult)}</bdi></div>` : ''}</td><td><span class="sev sev-${esc(b.severity.toLowerCase())}">${esc(b.severity)}</span></td><td class="s">${esc(statusLabel[st])}</td></tr>`).join('');
      byId('print-report').innerHTML = `
        <div class="pr-head"><div><div class="pr-k">BUG HUNTER · ${esc(caseNum(C))}</div><h1>Bug Report — ${esc(C.caseTitle)}</h1>
          <div class="pr-meta">Tester: <b dir="auto">${esc(name)}</b> · ${esc(date)} · ${mode === 'challenge' ? 'Challenge Mode' : 'Practice Mode'}</div></div>
          <div class="pr-brand"><b>Testing</b> بالعربي</div></div>
        <div class="pr-stats"><div><b>${last.score}</b><span>Score / ${last.max}</span></div><div><b>${last.correct}/${last.total}</b><span>Bugs found</span></div><div><b>${last.traps}</b><span>Not a Bug reports</span></div><div><b>${esc(last.rank)}</b><span>Rank</span></div></div>
        <table><thead><tr><th>Key</th><th>Summary</th><th>Severity</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table>
        <div class="pr-foot">Generated by Bug Hunter · testing-arabic.com/bug-hunter</div>`;
    };

    const finishGame = (reason = 'completed') => {
      if (!active) return;
      active = false; clearInterval(timer); stopMusic(); layer.hidden = true;
      document.body.classList.remove('modal-open', 'bug-hunter-active');
      const prev = bestOf(C);
      const best = { score: Math.max(prev?.score || 0, score), correct: Math.max(prev?.correct || 0, correct) };
      store.set(C.storageKey, best);
      const total = C.bugs.length, max = total * 100;
      const ranks = [...settings.ranks].sort((a, b) => a.min - b.min);
      const scaled = total ? Math.round((correct / total) * 10) : 0; // الرتب مبنية على 10 bugs
      const rank = ranks.filter((item) => scaled >= item.min).at(-1)?.label || 'QA Intern';
      last = { score, correct, total, max, traps: trapped.size, rank };
      window.taTrack?.(reason === 'manual_exit' ? 'bug_hunter_exit' : 'bug_hunter_complete', {
        mode, reason, score, correct, answered: answered.size, bug_count: total, traps: trapped.size, case_id: C.id,
      });
      byId('r-kicker').textContent = `${caseNum(C)} • CLOSED`;
      byId('result-rank').textContent = rank;
      byId('result-score').textContent = String(score); byId('result-max').textContent = String(max);
      byId('result-correct').textContent = String(correct); byId('result-total').textContent = String(total);
      byId('result-traps').textContent = String(trapped.size);
      byId('result-best').textContent = String(best.score);
      renderJira(); renderCardPreview();
      const missedIds = C.bugs.filter((bug) => answered.get(bug.id) !== true).map((bug) => bug.id);
      const learningBugs = missedIds.length ? C.bugs.filter((bug) => missedIds.includes(bug.id)) : C.bugs.slice(0, 2);
      const resourceMap = new Map();
      learningBugs.flatMap((bug) => bug.resources || []).forEach((resource) => resourceMap.set(resource.href, resource));
      const resources = [...resourceMap.values()].slice(0, 6);
      byId('resource-links').innerHTML = '';
      resources.forEach((resource) => {
        const link = document.createElement('a');
        link.href = resource.href; link.target = '_blank'; link.rel = 'noopener';
        link.innerHTML = `<span><small></small><b></b></span><i>←</i>`;
        link.querySelector('small').textContent = resource.kind;
        link.querySelector('b').textContent = resource.label;
        byId('resource-links').append(link);
      });
      byId('learning-list').hidden = !resources.length;
      gameScreen.hidden = true; results.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    /* ---------- الأحداث ---------- */
    document.querySelectorAll('[data-pick-case]').forEach((b) => b.addEventListener('click', (e) => { e.stopPropagation(); openCase(b.dataset.pickCase); }));
    // الكرت كامل قابل للضغط (مع تأثير 🔻 تبع الماوس)
    document.querySelectorAll('.case-card[role="button"]').forEach((card) => {
      card.addEventListener('click', () => openCase(card.dataset.caseCard));
      card.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCase(card.dataset.caseCard); } });
    });
    byId('back-cases')?.addEventListener('click', showPicker);
    byId('other-cases')?.addEventListener('click', showPicker);
    document.querySelectorAll('[data-start-mode]').forEach((button) => button.addEventListener('click', () => startGame(button.dataset.startMode)));
    document.querySelectorAll('.bug-marker').forEach((marker) => marker.addEventListener('click', () => {
      if (marker.dataset.trap) openTrap(marker.dataset.trap, marker); else openQuestion(marker.dataset.bug);
    }));
    byId('end-game').addEventListener('click', () => finishGame('manual_exit'));
    byId('continue-game').addEventListener('click', closeQuestion);
    byId('modal-close').addEventListener('click', closeQuestion);
    layer.addEventListener('click', (event) => { if (event.target === layer) closeQuestion(); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !layer.hidden) closeQuestion(); });
    byId('play-again').addEventListener('click', () => { results.hidden = true; mission.hidden = false; window.scrollTo({ top: 0, behavior: 'smooth' }); });
    updateSoundButton();
    byId('sound-toggle').addEventListener('click', () => {
      muted = !muted;
      try { localStorage.setItem(soundStorageKey, muted ? '1' : '0'); } catch (_) {}
      updateSoundButton();
      if (muted) stopMusic(); else if (active && mode === 'challenge') startMusic();
    });
    try { byId('tester-name').value = localStorage.getItem('testing-arabic:bug-hunter:tester') || ''; } catch (_) {}
    byId('download-pdf').addEventListener('click', () => {
      if (!last) return;
      buildPrint(); document.body.append(byId('print-report')); document.body.classList.add('bh-printing');
      window.taTrack?.('bug_hunter_pdf', { case_id: C.id });
      setTimeout(() => { window.print(); }, 60);
    });
    window.addEventListener('afterprint', () => document.body.classList.remove('bh-printing'));
    const shareText = () => `اصطدت ${last.correct}/${last.total} Bugs وجبت ${last.score}/${last.max} في Bug Hunter (${C.caseTitle}) — رتبتي ${last.rank}! جرّب تتفوق عليّ:`;
    const shareUrl = () => `${location.origin}/bug-hunter/`;
    byId('share-result').addEventListener('click', async () => {
      if (!last) return;
      const text = shareText();
      try {
        const blob = await cardBlob();
        const file = blob && new File([blob], 'bug-hunter-score.png', { type: 'image/png' });
        if (file && navigator.canShare && navigator.canShare({ files: [file] })) { await navigator.share({ files: [file], text: `${text} ${shareUrl()}` }); window.taTrack?.('bug_hunter_share', { method: 'file', case_id: C.id }); return; }
        if (navigator.share) { await navigator.share({ title: 'Bug Hunter', text, url: shareUrl() }); window.taTrack?.('bug_hunter_share', { method: 'link', case_id: C.id }); return; }
        await navigator.clipboard.writeText(`${text} ${shareUrl()}`); byId('share-status').textContent = 'تم نسخ النتيجة والرابط ✓';
      } catch (e) { if (e && e.name === 'AbortError') return; byId('share-status').textContent = shareUrl(); }
    });
    byId('download-card').addEventListener('click', async () => {
      if (!last) return;
      const blob = await cardBlob(); if (!blob) return;
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'bug-hunter-score.png'; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000); window.taTrack?.('bug_hunter_card', { case_id: C.id });
    });

    // فتح Case مباشرة من الرابط: /bug-hunter/?case=login-lockdown
    const want = new URLSearchParams(location.search).get('case');
    if (want && cases.some((c) => c.id === want && !c.comingSoon)) openCase(want);
    else paintPicker();
  })();
</script>

