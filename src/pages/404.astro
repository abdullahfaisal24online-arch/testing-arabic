---
import Base from '../layouts/Base.astro';
---
<Base title="الصفحة غير موجودة" noindex={true}>
  <section class="nf wrap">
    <span class="code mono">404</span>
    <h1>الصفحة اللي بتدوّر عليها مش موجودة</h1>
    <p class="lead">ممكن يكون الرابط قديم أو فيه خطأ مطبعي. جرّب تبدأ من هون:</p>
    <div class="cta">
      <a class="btn btn-primary" href="/">الرئيسية</a>
      <a class="btn btn-ghost" href="/lessons/">كل الدروس</a>
      <a class="btn btn-ghost" href="/search/">بحث</a>
    </div>
    <a class="nf-game" href="/debug-hunt/">
      <span aria-hidden="true">🐞</span>
      <span>الصفحة مش موجودة… بس لقينا <b>bugs</b> هون! <u>اصطادهم بـ Debug Hunt</u></span>
    </a>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 18px; justify-items: start; padding-block: 90px 110px; }
  .code { font-size: 15px; color: var(--cyan); letter-spacing: 2px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .nf-game { display: inline-flex; align-items: center; gap: 12px; margin-top: 10px; padding: 14px 20px; border-radius: 14px;
    border: 1px dashed rgba(246,130,59,.6); background: rgba(246,130,59,.07); color: var(--ink-2); font-weight: 600; }
  .nf-game b { color: #f6823b; } .nf-game u { color: #38bdf8; text-underline-offset: 4px; }
  .nf-game span:first-child { font-size: 26px; }
</style>
