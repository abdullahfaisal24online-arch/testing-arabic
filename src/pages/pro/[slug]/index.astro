---
/**
 * بنك الأسئلة التفاعلي للمشتري: تدريب حسب الفصل + امتحان تجريبي بوقت.
 * الصفحة نفسها ما فيها ولا سؤال — الأسئلة بتوصل من /api/pro/bank/<slug> بس لجهاز مفعّل.
 *
 * التدريب: جواب وشرح فوري، التقدّم بينحفظ على الجهاز، ودعسوقات بتوقع لما الجواب غلط.
 * الامتحان: ساعة دائرية على الجنب، تعليم الأسئلة 🚩، شاشة مراجعة قبل «إنهاء»،
 *           Testo كمراقب بيحكي جمل قصيرة، ونتيجة احتفالية مع شهادة جاهزية بتنحفظ كصورة.
 * كل النصوص من «إعدادات المتجر» بلوحة التحكم (الخانات اللي بتبلّش بـ bank و proctor).
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { STORE_OPEN, getStoreSettings } from '../../../lib/store';
import { getBank } from '../../../lib/banks';
import ProAsk from '../../../components/pro/ProAsk.astro';

export async function getStaticPaths() {
  if (!STORE_OPEN) return [];
  const products = (await getCollection('products')).filter((p) => !p.data.draft);
  return products.filter((p) => getBank(p.id).length > 0).map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const t = await getStoreSettings();
// bankPracticeTitle ← practiceTitle ، proctorStart بيضل proctorStart
const L = Object.fromEntries(
  Object.entries(t)
    .filter(([k, v]) => /^(bank|proctor)/.test(k) && typeof v === 'string')
    .map(([k, v]) => [k.startsWith('bank') ? k[4].toLowerCase() + k.slice(5) : k, v]),
);
const exam = { count: t.bankExamCount, minutes: t.bankExamMinutes, pass: t.bankExamPass };
---

<Base title={product.data.title} description={product.data.title} noindex hideChat>
  <div class="wrap bpage">
    <a class="backbtn" href="/pro/"><span aria-hidden="true">→</span> {t.mineTitle}</a>
    <h1>{product.data.title}</h1>

    <div id="bank" class="bank" data-slug={product.id} data-title={product.data.title} data-labels={JSON.stringify(L)} data-exam={JSON.stringify(exam)}>
      <p class="dim" id="bload">…</p>
      <div class="blocked" id="blocked" hidden>
        <p>{t.bankLocked}</p>
        <a class="btn btn-primary btn-sm" href="/pro/unlock/">{t.mineUnlock}</a>
      </div>
      <div id="bview"></div>
    </div>
  </div>
  <div class="bk-swarm" id="bk-swarm" aria-hidden="true"></div>
  <ProAsk yes={t.confirmYes} no={t.confirmNo} />
</Base>

<script>
  type Item = { n: number; ch: number; q: string; qAr?: string; o: Record<string, string>; a: string; exEn: string; exAr?: string };
  type Chapter = { n: number; en: string; ar: string };
  type Bank = { items: Item[]; chapters?: Chapter[]; exam?: Record<string, number> };
  type Exam = { ids: number[]; ans: Record<number, string>; flags: number[]; endsAt: number; total: number; said: string[] };
  type Saved = { ans: Record<number, string>; exam?: Exam; last?: { score: number; total: number; at: number } };

  const root = document.getElementById('bank')!;
  const slug = root.dataset.slug!;
  const productTitle = root.dataset.title!;
  const L = JSON.parse(root.dataset.labels!) as Record<string, string>;
  const EX = JSON.parse(root.dataset.exam!) as { count: number; minutes: number; pass: number };
  const view = document.getElementById('bview')!;
  const KEY = `ta-bank:${slug}`;
  const fill = (s: string, v: Record<string, string | number>) => (s || '').replace(/\{(\w+)\}/g, (m, k) => (k in v ? String(v[k]) : m));
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ask = (text: string): Promise<boolean> => (window as any).taAsk(text);

  /* ---------- أدوات DOM ---------- */
  type Kid = Node | string | null | undefined | false;
  function h(tag: string, attrs: Record<string, any> = {}, ...kids: Kid[]) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) {
      if (v == null || v === false) continue;
      if (k === 'class') el.className = v;
      else if (k.startsWith('on')) el.addEventListener(k.slice(2), v);
      else if (k === 'hidden') el.hidden = !!v;
      else el.setAttribute(k, v === true ? '' : String(v));
    }
    for (const c of kids) if (c != null && c !== false) el.append(c);
    return el;
  }
  const SVG = 'http://www.w3.org/2000/svg';
  const s = (tag: string, attrs: Record<string, string | number>) => {
    const el = document.createElementNS(SVG, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
    return el;
  };
  const top = () => window.scrollTo({ top: root.offsetTop - 90, behavior: calm ? 'auto' : 'smooth' });
  const show = (...nodes: Node[]) => { view.replaceChildren(...nodes); top(); };
  const backBtn = (label: string, on: () => void) => h('button', { type: 'button', class: 'backbtn', onclick: on }, h('span', { 'aria-hidden': 'true' }, '→'), ` ${label}`);

  /* ---------- التخزين على الجهاز ---------- */
  const load = (): Saved => { try { return { ans: {}, ...JSON.parse(localStorage.getItem(KEY) || '{}') }; } catch (_) { return { ans: {} }; } };
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (_) {} };
  let S = load();

  let B: Bank;
  let byN = new Map<number, Item>();
  let buyer = '';
  const chName = (n: number) => B.chapters?.find((c) => c.n === n);
  const chLabel = (n: number) => `Chapter ${n}${chName(n) ? ` — ${chName(n)!.ar}` : ''}`;
  const chapters = () => [...new Set(B.items.map((i) => i.ch))].sort((a, b) => a - b);

  /* ---------- دعسوقات لما الجواب غلط (زي Bug Hunter) ---------- */
  const swarm = document.getElementById('bk-swarm')!;
  function bugsFall() {
    if (calm) return;
    swarm.replaceChildren(...Array.from({ length: 30 }, () => {
      const b = h('span', {}, '🐞');
      b.style.left = `${Math.random() * 96}%`;
      b.style.top = `${-20 - Math.random() * 80}px`;
      b.style.animationDelay = `${Math.random() * 0.4}s`;
      b.style.animationDuration = `${1.1 + Math.random() * 0.7}s`;
      b.style.fontSize = `${18 + Math.random() * 24}px`;
      b.style.setProperty('--drift', `${Math.random() * 120 - 60}px`);
      return b;
    }));
    swarm.classList.remove('show');
    void swarm.offsetWidth;
    swarm.classList.add('show');
    setTimeout(() => swarm.classList.remove('show'), 1900);
  }

  /* ---------- سؤال واحد ---------- */
  // mode: practice (جواب فوري) | exam (بدون تصحيح) | review (مصحّح وللقراءة)
  function question(it: Item, mode: 'practice' | 'exam' | 'review', picked: string | undefined, onPick: (k: string) => void, extra?: Node | null) {
    const reveal = mode === 'review' || (mode === 'practice' && !!picked);
    const ch = chName(it.ch);
    const opts = h('div', { class: 'opts', dir: 'ltr' },
      ...Object.entries(it.o).map(([k, v]) => {
        let cls = 'opt';
        if (reveal) { if (k === it.a) cls += ' ok'; else if (k === picked) cls += ' bad'; }
        else if (k === picked) cls += ' sel';
        return h('button', { type: 'button', class: cls, disabled: reveal, onclick: () => onPick(k) }, h('b', {}, k), h('span', {}, v));
      }),
    );
    const ok = picked === it.a;
    const ex = reveal
      ? h('div', { class: 'ex' },
          h('p', { class: 'verdict ' + (ok ? 'ok' : 'bad') }, ok ? L.correct : fill(L.wrong, { a: it.a })),
          it.exAr ? h('p', { class: 'exar' }, it.exAr) : h('p', { class: 'exar', dir: 'ltr' }, it.exEn),
          it.exAr && h('details', {}, h('summary', {}, L.english), h('p', { dir: 'ltr' }, it.exEn)),
        )
      : null;
    return h('article', { class: 'q' },
      h('div', { class: 'qhead' }, h('span', { class: 'ch' }, `Chapter ${it.ch}${ch ? ` · ${ch.en}` : ''}`), extra),
      h('h2', { class: 'en', dir: 'ltr' }, mode === 'exam' ? it.q : `${it.n}. ${it.q}`),
      it.qAr && h('p', { class: 'ar' }, it.qAr),
      opts, ex,
    );
  }

  /* ---------- الرئيسية ---------- */
  function home() {
    stopExamUi();
    const stat = (list: Item[]) => {
      const done = list.filter((i) => S.ans[i.n]);
      return { total: list.length, done: done.length, right: done.filter((i) => S.ans[i.n] === i.a).length };
    };
    const chip = (label: string, list: Item[]) => {
      const st = stat(list);
      return h('button', { type: 'button', class: 'chip', onclick: () => practice(list) },
        h('strong', {}, label), h('small', {}, `${st.right} ✓ · ${st.done} / ${st.total}`),
        h('span', { class: 'meter' }, h('i', { style: `width:${(st.done / st.total) * 100}%` })),
      );
    };
    const all = stat(B.items);
    const wrong = B.items.filter((i) => S.ans[i.n] && S.ans[i.n] !== i.a);
    const pc = h('section', { class: 'card' },
      h('h2', {}, L.practiceTitle),
      h('p', { class: 'dim' }, L.practiceText),
      h('div', { class: 'chips' }, chip(L.all, B.items), ...chapters().map((c) => chip(chLabel(c), B.items.filter((i) => i.ch === c)))),
      h('div', { class: 'row' },
        wrong.length > 0 && h('button', { type: 'button', class: 'btn btn-ghost btn-sm', onclick: () => practice(wrong) }, `${L.wrongOnly} (${wrong.length})`),
        all.done > 0 && h('button', { type: 'button', class: 'linkbtn', onclick: async () => { if (await ask(L.resetConfirm)) { S.ans = {}; save(); home(); } } }, L.reset),
      ),
    );
    const ec = h('section', { class: 'card exam-card' },
      h('div', { class: 'ec-top' },
        testoSvg('ec-testo'),
        h('div', {}, h('h2', {}, L.examTitle), h('p', { class: 'dim' }, fill(L.examText, { count: EX.count, minutes: EX.minutes, pass: EX.pass }))),
      ),
      S.last && h('p', { class: 'last' }, fill(L.score, { score: S.last.score, total: S.last.total })),
      h('button', { type: 'button', class: 'btn btn-primary', onclick: () => startExam() }, L.examButton),
    );
    show(h('div', { class: 'home' }, pc, ec));
  }

  /* ---------- التدريب ---------- */
  function practice(list: Item[]) {
    stopExamUi();
    let i = Math.max(0, list.findIndex((it) => !S.ans[it.n]));
    const box = h('div', { class: 'player' });
    const render = () => {
      const it = list[i];
      const doneN = list.filter((x) => S.ans[x.n]).length;
      const right = list.filter((x) => S.ans[x.n] === x.a).length;
      const last = i === list.length - 1;
      box.replaceChildren(
        h('div', { class: 'top' },
          backBtn(L.back, home),
          h('span', { class: 'num', dir: 'ltr' }, `${i + 1} / ${list.length}`),
          h('div', { class: 'bar' }, h('i', { style: `width:${(doneN / list.length) * 100}%` })),
          h('span', { class: 'score' }, `${right} ✓`),
        ),
        question(it, 'practice', S.ans[it.n], (k) => {
          S.ans[it.n] = k; save(); render();
          if (k !== it.a) bugsFall();
        }),
        h('div', { class: 'nav' },
          h('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: i === 0, onclick: () => { i--; render(); } }, L.prev),
          last
            ? h('button', { type: 'button', class: 'btn btn-primary btn-sm', disabled: !S.ans[it.n], onclick: () => finishPractice(list) }, L.next)
            : h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: () => { i++; render(); } }, L.next),
        ),
      );
    };
    render();
    show(box);
  }
  function finishPractice(list: Item[]) {
    const right = list.filter((x) => S.ans[x.n] === x.a).length;
    show(h('section', { class: 'card result' },
      h('p', { class: 'big' }, fill(L.done, { score: right, total: list.length })),
      h('div', { class: 'row' }, h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: home }, L.back)),
    ));
  }

  /* ---------- Testo (المراقب) ---------- */
  function testoSvg(cls: string) {
    const svg = s('svg', { viewBox: '0 0 48 48', class: cls, 'aria-hidden': 'true' });
    svg.append(
      s('path', { d: 'M24 6v5', stroke: '#f6823b', 'stroke-width': 2.6, 'stroke-linecap': 'round', fill: 'none' }),
      s('circle', { cx: 24, cy: 4.5, r: 2.4, fill: '#ff9a57' }),
      s('rect', { x: 4.5, y: 20, width: 4, height: 10, rx: 2, fill: '#e56b1f' }),
      s('rect', { x: 39.5, y: 20, width: 4, height: 10, rx: 2, fill: '#e56b1f' }),
      s('rect', { x: 9, y: 12, width: 30, height: 26, rx: 9, fill: '#f6823b' }),
      s('rect', { x: 13.5, y: 17.5, width: 21, height: 15, rx: 6.5, fill: '#0a1428' }),
      s('circle', { class: 'eye', cx: 19.5, cy: 24, r: 2.7 }),
      s('circle', { class: 'eye', cx: 28.5, cy: 24, r: 2.7 }),
      s('path', { class: 'mouth', d: 'M19.5 28.6c2.7 2 6.3 2 9 0', 'stroke-width': 1.8, 'stroke-linecap': 'round', fill: 'none' }),
    );
    return svg;
  }

  /* ---------- الامتحان ---------- */
  function pickExam(): number[] {
    const w = B.exam ?? {};
    const chs = chapters();
    const total = Math.min(EX.count, B.items.length);
    const sumW = chs.reduce((acc, c) => acc + (w[c] ?? 1), 0);
    // توزيع حسب الأوزان (أكبر باقي) مع حد عدد أسئلة الفصل
    const take = chs.map((c) => {
      const x = ((w[c] ?? 1) / sumW) * total;
      const size = B.items.filter((i) => i.ch === c).length;
      return { c, x, size, k: Math.min(size, Math.floor(x)) };
    });
    let left = total - take.reduce((acc, r) => acc + r.k, 0);
    for (const r of [...take].sort((a, b) => (b.x % 1) - (a.x % 1))) { if (left <= 0) break; if (r.k < r.size) { r.k++; left--; } }
    for (const r of take) { while (left > 0 && r.k < r.size) { r.k++; left--; } }
    const rnd = (n: number) => crypto.getRandomValues(new Uint32Array(1))[0] % n;
    const ids: number[] = [];
    for (const r of take) {
      const pool = B.items.filter((i) => i.ch === r.c).map((i) => i.n);
      for (let j = pool.length - 1; j > 0; j--) { const k = rnd(j + 1); [pool[j], pool[k]] = [pool[k], pool[j]]; }
      ids.push(...pool.slice(0, r.k));
    }
    return ids;
  }

  let timer = 0;
  const stopExamUi = () => { clearInterval(timer); document.body.classList.remove('bk-exam-on'); };

  function startExam() {
    const total = EX.minutes * 60_000;
    S.exam = { ids: pickExam(), ans: {}, flags: [], endsAt: Date.now() + total, total, said: [] };
    save();
    window.taTrack?.('pro_exam_start', { slug });
    runExam(true);
  }

  function runExam(fresh = false) {
    const E = S.exam!;
    E.flags ??= []; E.said ??= []; E.total ??= EX.minutes * 60_000;
    const items = E.ids.map((n) => byN.get(n)!).filter(Boolean);
    let i = 0;

    // --- الساعة والمراقب (على الجنب) ---
    const R = 52, C = 2 * Math.PI * R;
    const ringFill = s('circle', { class: 'rfill', cx: 60, cy: 60, r: R, 'stroke-dasharray': C.toFixed(1), 'stroke-dashoffset': 0 });
    const ringSvg = s('svg', { viewBox: '0 0 120 120', class: 'ring-svg' });
    ringSvg.append(s('circle', { class: 'rtrack', cx: 60, cy: 60, r: R }), ringFill);
    for (let m = 0; m < 12; m++) {
      const a = (m / 12) * 2 * Math.PI;
      ringSvg.append(s('line', { class: 'tick', x1: 60 + 44 * Math.sin(a), y1: 60 - 44 * Math.cos(a), x2: 60 + 47 * Math.sin(a), y2: 60 - 47 * Math.cos(a) }));
    }
    const time = h('b', { class: 'rtime', dir: 'ltr' }, '');
    const ring = h('div', { class: 'ring' }, ringSvg, h('div', { class: 'rcenter' }, time, h('small', {}, L.timeLeft)));
    const answeredEl = h('span', { class: 'stat' });
    const flaggedEl = h('span', { class: 'stat flagc' });
    const bubble = h('p', { class: 'bubble', 'aria-live': 'polite' });
    const testo = h('div', { class: 'proctor' }, testoSvg('pr-face'), h('div', { class: 'pr-say' }, h('b', {}, L.proctorName), bubble));
    const dots = h('div', { class: 'dots', dir: 'ltr' });
    const finishBtn = h('button', { type: 'button', class: 'btn btn-primary finish', onclick: () => reviewScreen() }, L.submit);
    const aside = h('aside', { class: 'side' },
      h('div', { class: 'side-top' }, ring, h('div', { class: 'stats' }, answeredEl, flaggedEl), finishBtn),
      testo, dots,
    );
    const main = h('div', { class: 'ex-main' });
    const wrap = h('div', { class: 'exam-wrap' }, main, aside);

    const say = (text: string, key?: string) => {
      if (key) { if (E.said.includes(key)) return; E.said.push(key); save(); }
      bubble.textContent = text;
      testo.classList.remove('talk'); void testo.offsetWidth; testo.classList.add('talk');
    };
    const answered = () => items.filter((x) => E.ans[x.n]).length;
    const paintSide = () => {
      answeredEl.textContent = fill(L.answered, { n: answered(), total: items.length });
      flaggedEl.textContent = `🚩 ${fill(L.flaggedCount, { n: E.flags.length })}`;
      flaggedEl.hidden = E.flags.length === 0;
      dots.replaceChildren(...items.map((x, j) =>
        h('button', {
          type: 'button',
          class: 'dot' + (E.ans[x.n] ? ' on' : '') + (E.flags.includes(x.n) ? ' fl' : '') + (j === i && main.dataset.mode === 'q' ? ' cur' : ''),
          'aria-label': String(j + 1),
          onclick: () => { i = j; renderQ(); },
        }, String(j + 1)),
      ));
    };
    const tick = () => {
      const ms = E.endsAt - Date.now();
      if (ms <= 0) { time.textContent = '0:00'; submitExam(true); return; }
      const m = Math.floor(ms / 60000), sec = Math.floor((ms % 60000) / 1000);
      time.textContent = `${m}:${String(sec).padStart(2, '0')}`;
      ringFill.setAttribute('stroke-dashoffset', (C * (1 - ms / E.total)).toFixed(1));
      ring.classList.toggle('warn', ms < 10 * 60_000);
      ring.classList.toggle('danger', ms < 5 * 60_000);
      testo.classList.toggle('worried', ms < 5 * 60_000);
      if (ms < 5 * 60_000) say(L.proctor5, 't5');
      else if (ms < 10 * 60_000) say(L.proctor10, 't10');
      else if (ms < E.total / 2) say(L.proctorHalf, 'half');
    };

    const renderQ = () => {
      main.dataset.mode = 'q';
      const it = items[i];
      const flagged = E.flags.includes(it.n);
      const flagBtn = h('button', {
        type: 'button', class: 'flag' + (flagged ? ' on' : ''), 'aria-pressed': flagged ? 'true' : 'false',
        onclick: () => {
          if (E.flags.includes(it.n)) E.flags = E.flags.filter((n) => n !== it.n);
          else { E.flags.push(it.n); say(L.proctorFlag); }
          save(); renderQ();
        },
      }, '🚩 ', flagged ? L.flagged : L.flag);
      main.replaceChildren(
        h('div', { class: 'player' },
          h('div', { class: 'top' }, h('span', { class: 'num' }, `${i + 1} / ${items.length}`), h('div', { class: 'bar' }, h('i', { style: `width:${(answered() / items.length) * 100}%` }))),
          question(it, 'exam', E.ans[it.n], (k) => {
            const before = answered();
            E.ans[it.n] = k; save();
            const now = answered();
            if (now === items.length && before < now) say(L.proctorAllDone, 'all');
            else if (now > before && now % 10 === 0) say(fill(L.proctorQuarter, { n: now, total: items.length }), `q${now}`);
            renderQ();
          }, flagBtn),
          h('div', { class: 'nav' },
            h('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: i === 0, onclick: () => { i--; renderQ(); } }, L.prev),
            i < items.length - 1
              ? h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: () => { i++; renderQ(); } }, L.next)
              : h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: () => reviewScreen() }, L.next),
          ),
        ),
      );
      paintSide();
    };

    // شاشة المراجعة قبل الإنهاء
    const reviewScreen = () => {
      main.dataset.mode = 'review';
      const blank = items.length - answered();
      main.replaceChildren(
        h('section', { class: 'card rv' },
          h('h2', {}, L.reviewTitle),
          h('p', { class: 'dim' }, fill(L.reviewText, { answered: answered(), total: items.length, blank, flagged: E.flags.length })),
          h('div', { class: 'rv-grid', dir: 'ltr' }, ...items.map((x, j) =>
            h('button', {
              type: 'button', class: 'dot big' + (E.ans[x.n] ? ' on' : ' blank') + (E.flags.includes(x.n) ? ' fl' : ''),
              onclick: () => { i = j; renderQ(); top(); },
            }, String(j + 1)),
          )),
          h('div', { class: 'row' },
            h('button', { type: 'button', class: 'btn btn-primary', onclick: () => submitExam(false) }, L.submit),
            h('button', { type: 'button', class: 'btn btn-ghost', onclick: () => renderQ() }, L.backToQuestions),
          ),
        ),
      );
      paintSide();
      top();
    };

    clearInterval(timer);
    document.body.classList.add('bk-exam-on');
    view.replaceChildren(wrap);
    renderQ();
    if (fresh) say(fill(L.proctorStart, { minutes: EX.minutes }), 'start');
    else say(fill(L.answered, { n: answered(), total: items.length }));
    tick();
    timer = window.setInterval(tick, 1000);
    top();
  }

  async function submitExam(timeUp: boolean) {
    const E = S.exam;
    if (!E) return;
    const items = E.ids.map((n) => byN.get(n)!).filter(Boolean);
    const blank = items.filter((x) => !E.ans[x.n]).length;
    if (!timeUp && blank > 0 && !(await ask(fill(L.submitConfirm, { n: blank })))) return;
    if (S.exam !== E) return;
    stopExamUi();
    const score = items.filter((x) => E.ans[x.n] === x.a).length;
    S.last = { score, total: items.length, at: Date.now() };
    delete S.exam;
    save();
    window.taTrack?.('pro_exam_done', { slug, score });
    result(items, E.ans, score, timeUp);
  }

  /* ---------- النتيجة ---------- */
  function result(items: Item[], ans: Record<number, string>, score: number, timeUp: boolean) {
    const pass = Math.round((EX.pass / EX.count) * items.length);
    const ok = score >= pass;
    const chs = [...new Set(items.map((x) => x.ch))].sort((a, b) => a - b);
    const per = chs.map((c) => {
      const list = items.filter((x) => x.ch === c);
      return { c, list, right: list.filter((x) => ans[x.n] === x.a).length };
    });
    const weakest = [...per].sort((a, b) => a.right / a.list.length - b.right / b.list.length)[0];
    const wrong = items.filter((x) => ans[x.n] !== x.a);

    // حلقة العلامة بتعدّ لفوق
    const R = 52, C = 2 * Math.PI * R;
    const arc = s('circle', { class: 'rfill', cx: 60, cy: 60, r: R, 'stroke-dasharray': C.toFixed(1), 'stroke-dashoffset': C.toFixed(1) });
    const passMark = s('line', { class: 'passmark', x1: 60, y1: 2, x2: 60, y2: 16, transform: `rotate(${(pass / items.length) * 360} 60 60)` });
    const svg = s('svg', { viewBox: '0 0 120 120', class: 'ring-svg' });
    svg.append(s('circle', { class: 'rtrack', cx: 60, cy: 60, r: R }), arc, passMark);
    const num = h('b', { class: 'rtime', dir: 'ltr' }, '0');
    const ring = h('div', { class: 'ring big ' + (ok ? 'pass' : 'fail') }, svg, h('div', { class: 'rcenter' }, num, h('small', { dir: 'ltr' }, `/ ${items.length}`)));

    const head = h('div', { class: 'res-head' },
      ring,
      h('div', {},
        timeUp && h('p', { class: 'dim' }, L.timeUp),
        h('p', { class: 'big ' + (ok ? 'ok' : 'bad') }, ok ? L.passed : L.failed),
        h('p', { class: 'score2' }, fill(L.score, { score, total: items.length })),
        !ok && weakest && h('div', { class: 'weak' },
          h('span', {}, fill(L.weakest, { chapter: chLabel(weakest.c) })),
          h('button', { type: 'button', class: 'btn btn-ghost btn-sm', onclick: () => practice(B.items.filter((x) => x.ch === weakest.c)) }, L.trainWeak),
        ),
      ),
    );

    const table = h('table', { class: 'tbl' }, h('tbody', {}, ...per.map((p) =>
      h('tr', {},
        h('td', {}, chLabel(p.c)),
        h('td', { dir: 'ltr' }, `${p.right} / ${p.list.length}`),
        h('td', {}, h('span', { class: 'meter' }, h('i', { style: `width:${(p.right / p.list.length) * 100}%` }))),
      ),
    )));

    const cert = ok ? certificate(score, items.length) : null;

    show(h('section', { class: 'card result' },
      head,
      cert,
      h('h3', {}, L.byChapter),
      table,
      h('div', { class: 'row' },
        wrong.length > 0 && h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: () => review(wrong, ans) }, `${L.review} (${wrong.length})`),
        h('button', { type: 'button', class: 'btn btn-ghost btn-sm', onclick: () => startExam() }, L.retry),
        backBtn(L.back, home),
      ),
    ));

    // حركة العدّ
    const t0 = performance.now(), dur = calm ? 1 : 1400;
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - k, 3);
      const v = Math.round(score * e);
      num.textContent = String(v);
      arc.setAttribute('stroke-dashoffset', (C * (1 - (score / items.length) * e)).toFixed(1));
      if (k < 1) requestAnimationFrame(step);
      else if (ok) confetti();
    };
    requestAnimationFrame(step);
  }

  function confetti() {
    if (calm) return;
    const colors = ['#f6823b', '#38bdf8', '#34d399', '#fbbf24', '#f472b6'];
    swarm.replaceChildren(...Array.from({ length: 70 }, () => {
      const p = h('i', { class: 'cf' });
      p.style.left = `${Math.random() * 100}%`;
      p.style.top = `${-10 - Math.random() * 60}px`;
      p.style.background = colors[Math.floor(Math.random() * colors.length)];
      p.style.animationDelay = `${Math.random() * 0.6}s`;
      p.style.animationDuration = `${1.8 + Math.random() * 1.2}s`;
      p.style.setProperty('--drift', `${Math.random() * 200 - 100}px`);
      return p;
    }));
    swarm.classList.remove('show'); void swarm.offsetWidth; swarm.classList.add('show', 'party');
    setTimeout(() => swarm.classList.remove('show', 'party'), 3400);
  }

  /* ---------- شهادة الجاهزية (صورة) ---------- */
  function certificate(score: number, total: number) {
    const W = 1200, H = 675;
    const cv = h('canvas', { width: W, height: H, class: 'cert-cv' }) as HTMLCanvasElement;
    const draw = async () => {
      try { await document.fonts.ready; } catch (_) {}
      const x = cv.getContext('2d')!;
      const font = getComputedStyle(document.body).fontFamily;
      const g = x.createLinearGradient(0, 0, W, H);
      g.addColorStop(0, '#0d1b33'); g.addColorStop(1, '#0a1428');
      x.fillStyle = g; x.fillRect(0, 0, W, H);
      x.strokeStyle = '#f6823b'; x.lineWidth = 6; x.strokeRect(28, 28, W - 56, H - 56);
      x.strokeStyle = 'rgba(56,189,248,.35)'; x.lineWidth = 2; x.strokeRect(44, 44, W - 88, H - 88);
      x.direction = 'rtl'; x.textAlign = 'center';
      x.fillStyle = '#f6823b'; x.font = `700 30px ${font}`; x.fillText('Testing بالعربي 🔻', W / 2, 118);
      x.fillStyle = '#e8eef9'; x.font = `800 74px ${font}`; x.fillText(L.certTitle, W / 2, 230);
      x.fillStyle = '#93a4c0'; x.font = `500 30px ${font}`; x.fillText(productTitle, W / 2, 290);
      if (buyer) { x.fillStyle = '#e8eef9'; x.font = `700 46px ${font}`; x.fillText(buyer, W / 2, 380); }
      x.fillStyle = '#34d399'; x.font = `800 64px ${font}`; x.direction = 'ltr'; x.fillText(`${score} / ${total}`, W / 2, buyer ? 470 : 420);
      x.direction = 'rtl';
      x.fillStyle = '#93a4c0'; x.font = `400 24px ${font}`;
      x.fillText(new Date().toLocaleDateString('ar-JO-u-nu-latn', { day: 'numeric', month: 'long', year: 'numeric' }), W / 2, buyer ? 525 : 485);
      x.font = `400 21px ${font}`; x.fillStyle = '#7b8aa5';
      x.fillText(L.certNote, W / 2, H - 92);
      x.fillStyle = '#38bdf8'; x.font = `600 22px ${font}`; x.direction = 'ltr'; x.fillText('testing-arabic.com', W / 2, H - 60);
    };
    draw();
    const saveBtn = h('button', {
      type: 'button', class: 'btn btn-primary btn-sm',
      onclick: () => {
        cv.toBlob((b) => {
          if (!b) return;
          const a = h('a', { href: URL.createObjectURL(b), download: `testing-arabic-${slug}-${score}.png` }) as HTMLAnchorElement;
          document.body.append(a); a.click(); a.remove();
          setTimeout(() => URL.revokeObjectURL(a.href), 4000);
          window.taTrack?.('pro_cert_save', { slug, score });
        }, 'image/png');
      },
    }, L.certSave);
    return h('div', { class: 'cert' }, cv, saveBtn);
  }

  function review(list: Item[], ans: Record<number, string>) {
    let i = 0;
    const box = h('div', { class: 'player' });
    const render = () => {
      box.replaceChildren(
        h('div', { class: 'top' },
          backBtn(L.back, home),
          h('span', { class: 'num', dir: 'ltr' }, `${i + 1} / ${list.length}`),
          h('div', { class: 'bar' }, h('i', { style: `width:${((i + 1) / list.length) * 100}%` })),
        ),
        question(list[i], 'review', ans[list[i].n], () => {}),
        h('div', { class: 'nav' },
          h('button', { type: 'button', class: 'btn btn-ghost btn-sm', disabled: i === 0, onclick: () => { i--; render(); } }, L.prev),
          h('button', { type: 'button', class: 'btn btn-primary btn-sm', onclick: () => { if (i < list.length - 1) { i++; render(); } else home(); } }, i < list.length - 1 ? L.next : L.back),
        ),
      );
    };
    render();
    show(box);
  }

  /* ---------- حماية بسيطة من النسخ ---------- */
  for (const ev of ['copy', 'cut', 'contextmenu', 'dragstart', 'selectstart']) root.addEventListener(ev, (e) => e.preventDefault());
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && ['c', 'x', 'a', 's', 'p'].includes(e.key.toLowerCase())) e.preventDefault();
  });

  /* ---------- البداية ---------- */
  (async () => {
    try {
      const [r, me] = await Promise.all([
        fetch(`/api/pro/bank/${slug}`, { cache: 'no-store' }),
        fetch('/api/pro/me', { cache: 'no-store' }).then((x) => x.json()).catch(() => ({})),
      ]);
      const d = await r.json();
      document.getElementById('bload')!.hidden = true;
      if (!d.ok) { document.getElementById('blocked')!.hidden = false; return; }
      B = d.bank as Bank;
      byN = new Map(B.items.map((i) => [i.n, i]));
      buyer = (me && me.name) || '';
      if (S.exam && S.exam.endsAt > Date.now()) runExam();
      else if (S.exam) submitExam(true);
      else home();
    } catch (_) {
      document.getElementById('bload')!.textContent = 'صار خطأ بالاتصال. حدّث الصفحة.';
    }
  })();
</script>

