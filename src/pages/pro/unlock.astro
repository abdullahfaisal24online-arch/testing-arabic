---
// تفعيل كود الشراء على هاد الجهاز (+ «نسيت الكود؟»). الرابط بالإيميل بيعبّي الكود لحاله: /pro/unlock/?code=TA-XXXX-XXXX
import Base from '../../layouts/Base.astro';
import { STORE_OPEN, getStoreSettings, tpl } from '../../lib/store';

if (!STORE_OPEN) return Astro.redirect('/store/');
const t = await getStoreSettings();
const L = {
  invalid: t.unlockErrInvalid, blocked: t.unlockErrBlocked, devices: t.unlockErrDevices, too_many: t.unlockErrTooMany,
  ok: t.unlockOk, forgotDone: t.forgotDone, bad_email: 'الإيميل مش مكتوب صح.', network: 'صار خطأ بالاتصال. جرّب كمان مرة.',
};
---

<Base title={t.unlockTitle} description={t.unlockText} noindex hideChat>
  <div class="wrap upage">
    <div class="ucard">
      <h1>{t.unlockTitle}</h1>
      <p class="lead">{tpl(t.unlockText, { devices: t.maxDevices })}</p>

      <form id="uform" novalidate data-labels={JSON.stringify(L)}>
        <label>
          <span>{t.unlockField}</span>
          <input name="code" id="code" required maxlength="20" dir="ltr" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="TA-XXXX-XXXX" />
        </label>
        <p class="msg" id="umsg" role="alert" hidden></p>
        <button class="btn btn-primary" type="submit" id="ubtn">{t.unlockButton}</button>
      </form>

      <div class="done" id="udone" hidden>
        <p class="ok">✓ {t.unlockOk}</p>
        <ul id="ulist"></ul>
        <a class="btn btn-primary" href="/pro/">{t.unlockOkButton}</a>
      </div>

      <details class="forgot" id="forgot">
        <summary>{t.forgotLink}</summary>
        <form id="fform" novalidate>
          <p>{t.forgotText}</p>
          <div class="frow">
            <input name="email" type="email" required maxlength="254" dir="ltr" autocomplete="email" />
            <button class="btn btn-ghost btn-sm" type="submit" id="fbtn">{t.forgotButton}</button>
          </div>
          <p class="msg" id="fmsg" role="status" hidden></p>
        </form>
      </details>
    </div>
  </div>
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const form = $('uform') as HTMLFormElement;
  const L = JSON.parse(form.dataset.labels!);
  const input = $('code') as HTMLInputElement;
  const q = new URLSearchParams(location.search).get('code');
  if (q) input.value = q.toUpperCase();

  const say = (el: HTMLElement, text: string, ok = false) => { el.textContent = text; el.className = 'msg ' + (ok ? 'ok' : 'bad'); el.hidden = false; };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = $('umsg');
    msg.hidden = true;
    if (!input.value.trim()) { input.focus(); return; }
    const btn = $('ubtn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const r = await fetch('/api/pro/unlock', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code: input.value }) });
      const d = await r.json();
      if (!d.ok) throw Object.assign(new Error(d.error || 'network'), { devices: d.devices });
      const ul = $('ulist');
      ul.replaceChildren(...d.products.map((p: { slug: string; title: string }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/pro/${p.slug}/`;
        a.textContent = p.title;
        li.append(a);
        return li;
      }));
      form.hidden = true;
      ($('forgot') as HTMLElement).hidden = true;
      $('udone').hidden = false;
      history.replaceState(null, '', location.pathname);
      window.taTrack?.('pro_unlock', {});
    } catch (x) {
      const err = x as Error & { devices?: number };
      say(msg, (L[err.message] || L.network).replace('{devices}', String(err.devices ?? '')));
      btn.disabled = false;
    }
  });

  ($('fform') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = e.currentTarget as HTMLFormElement;
    const email = (f.elements.namedItem('email') as HTMLInputElement).value.trim();
    const msg = $('fmsg');
    const btn = $('fbtn') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const r = await fetch('/api/pro/forgot', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email }) });
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'network');
      say(msg, L.forgotDone, true);
    } catch (x) {
      say(msg, L[(x as Error).message] || L.network);
      btn.disabled = false;
    }
  });
</script>

<style>
  .upage { max-width: 560px; padding-block: 40px 80px; }
  .ucard { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 26px 22px; }
  .ucard h1 { font-size: clamp(24px, 3vw, 30px); margin: 0 0 6px; }
  .lead { color: var(--muted); line-height: 1.9; margin: 0 0 20px; }
  #uform { display: grid; gap: 14px; }
  #uform label { display: grid; gap: 6px; }
  #uform label span { font-weight: 700; font-size: 14.5px; }
  .ucard input { font: inherit; font-size: 17px; background: var(--navy); border: 1.5px solid var(--line-strong); border-radius: 12px; padding: 12px 14px; color: var(--ink); width: 100%; min-width: 0; }
  #code { font-family: ui-monospace, monospace; letter-spacing: 2px; text-align: center; font-size: 20px; }
  .ucard input:focus { outline: none; border-color: var(--cyan); }
  #uform .btn, .done .btn { width: 100%; justify-content: center; }
  .msg { margin: 0; line-height: 1.8; } .msg.ok { color: #34d399; } .msg.bad { color: #f87171; }
  .msg[hidden], .done[hidden], #uform[hidden], .forgot[hidden] { display: none; }
  .done { display: grid; gap: 12px; }
  .done .ok { color: #34d399; font-weight: 700; font-size: 17px; margin: 0; }
  .done ul { margin: 0; padding-inline-start: 20px; line-height: 2; }
  .forgot { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 14px; }
  .forgot summary { cursor: pointer; color: var(--cyan); font-size: 14.5px; }
  .forgot form { display: grid; gap: 10px; margin-top: 10px; }
  .forgot p { margin: 0; color: var(--muted); line-height: 1.8; font-size: 14.5px; }
  .frow { display: flex; gap: 8px; }
  .frow input { flex: 1; font-size: 16px; padding: 10px 12px; }
  .frow .btn { flex: none; }
  @media (max-width: 480px) { .frow { flex-direction: column; } }
</style>
