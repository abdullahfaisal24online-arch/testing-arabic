---
import Base from '../../layouts/Base.astro';
---
<Base
  title="ادخل كود الوصول"
  description="صفحة إدخال كود الوصول للقسم المدفوع على منصة Testing بالعربي."
  noindex={true}
>
  <section class="hero dots">
    <div class="wrap">
      <span class="eyebrow">القسم المدفوع</span>
      <h1>ادخل كود الوصول</h1>
      <p class="intro">
        الكود وصلك بعد ما أكّدنا الحوالة. بتدخّلو مرة وحدة على هاد الجهاز، وبعدها بتفتح
        القسم المدفوع مباشرة بدون حساب ولا كلمة سر.
      </p>

      <form class="form" id="unlock-form" novalidate>
        <label class="sr-only" for="pro-code">كود الوصول</label>
        <input
          id="pro-code"
          name="code"
          type="text"
          inputmode="latin"
          autocomplete="off"
          spellcheck="false"
          placeholder="TA-XXXX-XXXX"
          maxlength="12"
          required
        />
        <button class="btn btn-primary" type="submit" id="unlock-btn">افتح القسم</button>
        <p class="msg" id="unlock-msg" role="status" aria-live="polite"></p>
      </form>

      <p class="muted">
        ما عندك كود؟ الحزمة رح تنفتح للبيع قريباً — <a href="/newsletter/">اشترك بالنشرة</a>
        عشان تكون أول من يعرف.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const form = document.getElementById('unlock-form');
    const input = document.getElementById('pro-code');
    const btn = document.getElementById('unlock-btn');
    const msg = document.getElementById('unlock-msg');
    if (!form || !input || !btn || !msg) return;

    const errors = {
      format: 'شكل الكود غلط. لازم يكون على شكل TA-XXXX-XXXX.',
      unknown: 'ما لقينا هاد الكود. تأكد إنك نسخته صح.',
      blocked: 'هاد الكود موقوف. تواصل معنا إذا بتعتقد إنو في غلط.',
      expired: 'انتهت صلاحية هاد الكود.',
      devices: 'الكود مستعمل على أقصى عدد أجهزة مسموح. تواصل معنا إذا بدك تنقلو لجهاز تاني.',
      origin: 'صار خطأ بالطلب. حدّث الصفحة وجرّب من جديد.',
    };

    // الحروف كلها كبيرة والشرطات تلقائية عشان ما يغلط بالكتابة
    input.addEventListener('input', () => {
      const raw = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '').replace(/^TA/, '');
      let out = 'TA';
      if (raw.length) out += '-' + raw.slice(0, 4);
      if (raw.length > 4) out += '-' + raw.slice(4, 8);
      input.value = out;
    });

    const goto = () => {
      const to = new URLSearchParams(location.search).get('to') || '/pro/';
      location.href = /^\/pro\//.test(to) ? to : '/pro/';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'msg';
      btn.disabled = true;
      try {
        const res = await fetch('/api/pro/unlock', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ code: input.value.trim() }),
        });
        const data = await res.json().catch(() => ({}));
        if (data && data.ok) {
          msg.textContent = 'تم! جاري فتح القسم…';
          msg.className = 'msg ok';
          goto();
          return;
        }
        msg.textContent = errors[data && data.error] || 'ما زبطت. جرّب من جديد.';
        msg.className = 'msg bad';
      } catch (err) {
        msg.textContent = 'ما قدرنا نوصل للسيرفر. شيك على النت وجرّب كمان مرة.';
        msg.className = 'msg bad';
      }
      btn.disabled = false;
    });
  })();
</script>

<style>
  .hero { padding-block: 56px 64px; }
  .hero h1 { margin-top: 12px; }
  .intro { max-width: 58ch; color: var(--muted); margin-top: 12px; }

  .form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    max-width: 460px;
    margin-top: 28px;
  }
  .form input {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: 14px 18px;
    color: var(--ink);
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 17px;
    letter-spacing: 2px;
    text-align: center;
    min-height: 48px;
    direction: ltr;
  }
  .form input::placeholder { color: var(--faint); letter-spacing: 1px; }

  .msg { grid-column: 1 / -1; font-size: 14px; margin: 0; min-height: 20px; }
  .msg.bad { color: #ff8f6b; }
  .msg.ok { color: #5ad19a; }

  .muted { margin-top: 26px; font-size: 14px; color: var(--faint); }

  @media (max-width: 620px) {
    .form { grid-template-columns: 1fr; }
  }
</style>
