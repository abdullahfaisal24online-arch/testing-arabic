---
import Base from '../../layouts/Base.astro';
---
<Base
  title="موادي"
  description="المواد المدفوعة المفتوحة على هاد الجهاز."
  noindex={true}
>
  <section class="hero dots">
    <div class="wrap">
      <span class="eyebrow">القسم المدفوع</span>
      <h1>موادي</h1>
      <p class="intro">
        هون بتلاقي كل مادة مدفوعة مفتوحة على هاد الجهاز. الفتح مربوط بالجهاز نفسه —
        لو فتحت الموقع من جهاز تاني، دخّل الكود مرة وحدة هناك كذلك.
      </p>

      <div id="pro-list" class="list" aria-live="polite">
        <p class="dim">لحظة…</p>
      </div>

      <p class="acts">
        <a class="btn" href="/pro/unlock/">دخّل كود جديد</a>
        <a class="btn" href="/store/">المتجر</a>
        <button class="btn" type="button" id="pro-logout">إغلاق الوصول على هاد الجهاز</button>
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const box = document.getElementById('pro-list');
    const btn = document.getElementById('pro-logout');

    const esc = (s) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);

    const load = async () => {
      if (!box) return;
      try {
        const [statusRes, catRes] = await Promise.all([
          fetch('/api/pro/status'),
          fetch('/store/products.json'),
        ]);
        const status = await statusRes.json().catch(() => ({}));
        const cat = await catRes.json().catch(() => ({ products: [] }));
        const open = Array.isArray(status.products) ? status.products : [];
        const titles = {};
        for (const p of cat.products || []) titles[p.slug] = p.title;

        if (!open.length) {
          box.innerHTML =
            '<p class="dim">ما في مواد مفتوحة على هاد الجهاز. إذا عندك كود، <a href="/pro/unlock/">دخّلو من هون</a>؛ وإذا لأ، شوف <a href="/store/">المتجر</a>.</p>';
          return;
        }

        box.innerHTML =
          '<div class="grid">' +
          open
            .map(
              (slug) =>
                '<a class="item" href="/pro/' +
                encodeURIComponent(slug) +
                '/"><h2>' +
                esc(titles[slug] || slug) +
                '</h2><span>افتح المادة ›</span></a>',
            )
            .join('') +
          '</div>';
      } catch (err) {
        box.innerHTML = '<p class="dim">ما قدرنا نجيب موادك. حدّث الصفحة وجرّب كمان مرة.</p>';
      }
    };

    load();

    if (btn) {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          await fetch('/api/pro/logout', { method: 'POST' });
        } catch (err) {
          /* ما بيهم — رح نرجّعه لصفحة الكود بأي حال */
        }
        location.href = '/pro/unlock/';
      });
    }
  })();
</script>

<style>
  .hero { padding-block: 56px 64px; }
  .hero h1 { margin-top: 12px; }
  .intro { max-width: 62ch; color: var(--muted); margin-top: 12px; }

  .list { margin-top: 28px; max-width: 720px; }
  .dim { color: var(--muted); }

  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .item {
    display: grid;
    gap: 8px;
    background: var(--surface);
    border: 1px solid var(--orange-line);
    border-radius: var(--r-xl);
    padding: 20px;
    text-decoration: none;
    color: inherit;
  }
  .item:hover { border-color: var(--orange); }
  .item h2 { font-size: 18px; margin: 0; }
  .item span { font-size: 13px; color: var(--orange); }

  .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }
</style>
