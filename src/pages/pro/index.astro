---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const products = (await getCollection('products'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="موادي"
  description="المواد المدفوعة المفتوحة على هاد الجهاز."
  noindex={true}
>
  <section class="hero dots">
    <div class="wrap">
      <span class="eyebrow">القسم المدفوع</span>
      <h1>موادي</h1>
      <p class="intro">
        هون بتلاقي كل مادة مدفوعة مفتوحة على هاد الجهاز. الفتح مربوط بالجهاز نفسه —
        لو فتحت الموقع من جهاز تاني، دخّل الكود مرة وحدة هناك كذلك.
      </p>

      <div class="list" id="pro-list" aria-live="polite">
        <p class="dim" id="pro-loading">لحظة…</p>

        <p class="dim" id="pro-empty" hidden>
          ما في مواد مفتوحة على هاد الجهاز. إذا عندك كود <a href="/pro/unlock/">دخّلو من هون</a>،
          وإذا لأ شوف <a href="/store/">المتجر</a>.
        </p>

        <div class="grid" id="pro-grid" hidden>
          {
            products.map((p) => (
              <a class="item" href={`/pro/${p.id}/`} data-slug={p.id} hidden>
                <span class="kind">{p.data.kind}</span>
                <h2>{p.data.title}</h2>
                <span class="go">افتح المادة ›</span>
              </a>
            ))
          }
        </div>
      </div>

      <p class="acts">
        <a class="btn" href="/pro/unlock/">دخّل كود جديد</a>
        <a class="btn" href="/store/">المتجر</a>
        <button class="btn" type="button" id="pro-logout">إغلاق الوصول على هاد الجهاز</button>
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const loading = document.getElementById('pro-loading');
    const empty = document.getElementById('pro-empty');
    const grid = document.getElementById('pro-grid');
    const btn = document.getElementById('pro-logout');

    const show = (open) => {
      if (loading) loading.hidden = true;
      let shown = 0;
      if (grid) {
        for (const card of grid.querySelectorAll('[data-slug]')) {
          const on = open.indexOf(card.getAttribute('data-slug')) !== -1;
          card.hidden = !on;
          if (on) shown++;
        }
        grid.hidden = shown === 0;
      }
      if (empty) empty.hidden = shown > 0;
    };

    fetch('/api/pro/status')
      .then((r) => r.json())
      .then((s) => show(Array.isArray(s.products) ? s.products : []))
      .catch(() => {
        if (loading) loading.textContent = 'ما قدرنا نجيب موادك. حدّث الصفحة وجرّب كمان مرة.';
      });

    if (btn) {
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        try {
          await fetch('/api/pro/logout', { method: 'POST' });
        } catch (err) {
          /* ما بيهم — رح نرجّعه لصفحة الكود بأي حال */
        }
        location.href = '/pro/unlock/';
      });
    }
  })();
</script>

<style>
  .hero { padding-block: 56px 64px; }
  .hero h1 { margin-top: 12px; }
  .intro { max-width: 62ch; color: var(--muted); margin-top: 12px; }

  .list { margin-top: 28px; max-width: 720px; }
  .dim { color: var(--muted); }

  .grid { display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .item {
    display: grid;
    gap: 7px;
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--orange-line);
    border-radius: var(--r-xl);
    padding: 20px;
    text-decoration: none;
    color: inherit;
  }
  .item:hover { border-color: var(--orange); }
  .kind { font-size: 12px; color: var(--faint); }
  .item h2 { font-size: 18px; margin: 0; }
  .go { font-size: 13px; color: var(--orange); }

  .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 32px; }
</style>
