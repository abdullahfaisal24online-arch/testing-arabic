---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LessonCard from '../../components/LessonCard.astro';
import { getSite } from '../../lib/site';

const site = await getSite();

const courses = (await getCollection('courses')).filter((c) => !c.data.draft);
const courseTitle = (id?: string) => courses.find((c) => c.id === id)?.data.title;

/**
 * ترتيب الأرشيف: دروس الدورات أولاً — كل دورة بترتيبها (order)، وفصولها بترتيب الدرس —
 * وبعدها الفيديوهات المتفرقة من الأحدث للأقدم.
 */
const SOLO_RANK = Number.MAX_SAFE_INTEGER;
const courseRank = (id?: string) => {
  const c = id ? courses.find((x) => x.id === id) : undefined;
  return c ? c.data.order : SOLO_RANK;
};

const lessons = (await getCollection('lessons'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => {
    const ca = a.data.course ?? a.data.track;
    const cb = b.data.course ?? b.data.track;
    const ra = courseRank(ca);
    const rb = courseRank(cb);
    if (ra !== rb) return ra - rb;
    if (ra === SOLO_RANK) return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
    if (ca !== cb) return String(ca).localeCompare(String(cb));
    if (a.data.order !== b.data.order) return a.data.order - b.data.order;
    return a.data.publishDate.valueOf() - b.data.publishDate.valueOf();
  });

const rows = lessons.map((l) => {
  const cid = l.data.course ?? l.data.track;
  return { lesson: l, courseId: cid, title: courseTitle(cid) };
});

const categories = [...new Set(lessons.map((l) => l.data.category))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'كل الدروس',
  url: `${site.url}/lessons/`,
  inLanguage: 'ar',
};
---

<Base
  title="كل الدروس"
  description="أرشيف كامل لدروس اختبار البرمجيات بالعربي: دروس الدورات وفيديوهات متفرقة — مجاناً وبترتيب واضح."
  jsonLd={jsonLd}
>
  <section class="page-head dots">
    <div class="wrap">
      <h1>كل الدروس</h1>
      <p class="lead">
        الأرشيف الكامل — {lessons.length} درس، كلها مرتّبة ضمن الدورات.
      </p>

      <div class="filters">
        {categories.length > 1 && (
          <div class="fgroup" role="group" aria-label="تصفية حسب التصنيف">
            <button class="chip cat on" type="button" data-cat="all">كل التصنيفات</button>
            {categories.map((c) => <button class="chip cat" type="button" data-cat={c}>{c}</button>)}
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-4" id="lesson-grid">
        {rows.map((r) => (
          <div data-cat={r.lesson.data.category} data-scope={r.title ? 'course' : 'solo'}>
            <LessonCard lesson={r.lesson} courseTitle={r.title} />
          </div>
        ))}
      </div>
      {lessons.length === 0 && <p class="lead">ما في دروس منشورة بعد.</p>}
      <p class="empty" hidden>ما في دروس مطابقة للتصفية.</p>
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 52px 40px; }
  .page-head h1 { margin-bottom: 12px; }
  .filters { display: grid; gap: 12px; margin-top: 24px; }
  .fgroup { display: flex; gap: 10px; flex-wrap: wrap; }
  .chip {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 18px;
    min-height: 40px;
    cursor: pointer;
  }
  .chip:hover { color: var(--ink); }
  .chip.on { background: var(--cyan-soft); color: var(--cyan); border-color: var(--line-strong); }
  #lesson-grid > [data-cat] { display: contents; }
  .empty { color: var(--muted); }
</style>

<script>
  const catChips = document.querySelectorAll<HTMLButtonElement>('.chip[data-cat]');
  const cells = document.querySelectorAll<HTMLElement>('#lesson-grid > [data-cat]');
  const empty = document.querySelector<HTMLElement>('.empty');

  let cat = 'all';

  function apply() {
    let shown = 0;
    cells.forEach((cell) => {
      const okCat = cat === 'all' || cell.dataset.cat === cat;
      const match = okCat;
      cell.style.display = match ? '' : 'none';
      if (match) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }


  catChips.forEach((chip) =>
    chip.addEventListener('click', () => {
      catChips.forEach((c) => c.classList.toggle('on', c === chip));
      cat = chip.dataset.cat ?? 'all';
      apply();
    }),
  );
</script>
