---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LessonCard from '../../components/LessonCard.astro';
import { getSite } from '../../lib/site';

const site = await getSite();

const lessons = (await getCollection('lessons'))
  .filter((l) => !l.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = [...new Set(lessons.map((l) => l.data.category))];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'كل الدروس',
  url: `${site.url}/lessons/`,
  inLanguage: 'ar',
};
---
<Base
  title="كل الدروس"
  description="مكتبة دروس اختبار البرمجيات بالعربي: الأساسيات، الأدوات، وأتمتة الاختبار — مجاناً وبترتيب واضح."
  jsonLd={jsonLd}
>
  <section class="page-head dots">
    <div class="wrap">
      <h1>كل الدروس</h1>
      <p class="lead">{lessons.length} درس مجاني بالعربي. اختر تصنيف أو ابدأ من الأحدث.</p>
      {categories.length > 1 && (
        <div class="filters" role="group" aria-label="تصفية حسب التصنيف">
          <button class="chip on" type="button" data-cat="all">الكل</button>
          {categories.map((c) => <button class="chip" type="button" data-cat={c}>{c}</button>)}
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-4" id="lesson-grid">
        {lessons.map((l) => (
          <div class="cell" data-cat={l.data.category}><LessonCard lesson={l} /></div>
        ))}
      </div>
      {lessons.length === 0 && <p class="lead">ما في دروس منشورة بعد.</p>}
      <p class="empty" hidden>ما في دروس بهذا التصنيف.</p>
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 52px 40px; }
  .page-head h1 { margin-bottom: 12px; }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  .chip {
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 18px;
    min-height: 40px;
    cursor: pointer;
  }
  .chip:hover { color: var(--ink); }
  .chip.on { background: var(--cyan-soft); color: var(--cyan); border-color: var(--line-strong); }
  .cell { display: contents; }
  .empty { color: var(--muted); }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  const cells = document.querySelectorAll<HTMLElement>('#lesson-grid > [data-cat]');
  const empty = document.querySelector<HTMLElement>('.empty');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.classList.toggle('on', c === chip));
      const cat = chip.dataset.cat;
      let shown = 0;
      cells.forEach((cell) => {
        const match = cat === 'all' || cell.dataset.cat === cat;
        cell.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
