---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import LessonCard from '../../components/LessonCard.astro';
import InlineNewsletter from '../../components/InlineNewsletter.astro';
import Prose from '../../components/Prose.astro';
import Comments from '../../components/Comments.astro';
import { getSite } from '../../lib/site';
import { tagSlug } from '../../lib/tags';
import { formatDate, durationToISO, bunnyEmbed, bunnyThumb } from '../../lib/utils';

export async function getStaticPaths() {
  const lessons = (await getCollection('lessons')).filter((l) => !l.data.draft);
  const courses = await getCollection('courses');
  return lessons.map((lesson) => {
    const courseId = lesson.data.course ?? lesson.data.track;
    const course = courses.find((c) => c.id === courseId);
    const siblings = lessons
      .filter((l) => courseId && (l.data.course ?? l.data.track) === courseId)
      .sort((a, b) => a.data.order - b.data.order);
    const idx = siblings.findIndex((l) => l.id === lesson.id);

    // الدروس المرتبطة يدوياً تتقدّم على الاقتراح التلقائي حسب التصنيف
    const manual = (lesson.data.relatedLessons ?? [])
      .map((slug) => lessons.find((l) => l.id === slug))
      .filter((l): l is (typeof lessons)[number] => Boolean(l) && l!.id !== lesson.id);
    const auto = lessons
      .filter(
        (l) =>
          l.id !== lesson.id &&
          l.data.category === lesson.data.category &&
          !manual.some((m) => m.id === l.id),
      )
      .slice(0, 4);
    const related = manual.length ? [...manual, ...auto].slice(0, 4) : auto;

    // التنقّل: داخل الدورة إن وُجدت، وإلا ضمن نفس التصنيف حسب التاريخ
    let prev = idx > 0 ? siblings[idx - 1] : undefined;
    let next = idx >= 0 && idx < siblings.length - 1 ? siblings[idx + 1] : undefined;
    if (!courseId) {
      const solo = lessons
        .filter((l) => !(l.data.course ?? l.data.track) && l.data.category === lesson.data.category)
        .sort((a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf());
      const si = solo.findIndex((l) => l.id === lesson.id);
      prev = si > 0 ? solo[si - 1] : undefined;
      next = si >= 0 && si < solo.length - 1 ? solo[si + 1] : undefined;
    }

    return {
      params: { slug: lesson.id },
      props: { lesson, course, siblings, prev, next, related },
    };
  });
}

const { lesson, course, siblings, prev, next, related } = Astro.props;
const { data } = lesson;
const { Content } = await render(lesson);
const bodyHtml = (lesson as any).rendered?.html ?? '';
const site = await getSite();

const embed = data.videoId ? bunnyEmbed(data.videoId, site.bunnyLibraryId) : '';
const thumb = bunnyThumb(data.videoId, data.thumbnail, site.bunnyCdnHostname);

// بطاقة الفيديو المنظّمة بتنرسل فقط لما يكون في فيديو فعلاً ومعه صورة ورابط تضمين —
// جوجل بيعتبرها ناقصة وبيسجّل خطأ إذا أرسلناها بدونهم. الدرس بلا فيديو بيتقدّم كمقال.
const hasVideo = Boolean(embed);
const videoThumb = thumb ?? `${site.url}/og-default.png`;

const jsonLd = [
  hasVideo
    ? {
        '@context': 'https://schema.org',
        '@type': 'VideoObject',
        name: data.title,
        description: data.description,
        uploadDate: data.publishDate.toISOString(),
        duration: durationToISO(data.duration),
        thumbnailUrl: [videoThumb],
        embedUrl: embed,
        inLanguage: 'ar',
        publisher: { '@type': 'Organization', name: site.name, url: site.url },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: data.title,
        description: data.description,
        datePublished: data.publishDate.toISOString(),
        dateModified: (data.updatedDate ?? data.publishDate).toISOString(),
        inLanguage: 'ar',
        author: { '@type': 'Person', name: site.author },
        publisher: { '@type': 'Organization', name: site.name, url: site.url },
        mainEntityOfPage: `${site.url}/lessons/${lesson.id}/`,
      },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'الدروس', item: `${site.url}/lessons/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/lessons/${lesson.id}/` },
    ],
  },
];
---
<Base
  title={data.title}
  description={data.description}
  type={hasVideo ? 'video.other' : 'article'}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  image={thumb ?? undefined}
  jsonLd={jsonLd}
>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span>
    {course ? <><a href={`/courses/${course.id}/`}>{course.data.title}</a><span>›</span></> : <><a href="/lessons/">الدروس</a><span>›</span></>}
    <span class="now">{data.title}</span>
  </div>

  <div class="wrap layout">
    <article class="main">
      <div class="player">
        {embed ? (
          <iframe
            src={embed}
            title={data.title}
            loading="lazy"
            allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
            allowfullscreen
          ></iframe>
        ) : (
          <div class="player-empty">
            <span class="play"><Icon name="play" size={26} /></span>
            <p>فيديو هذا الدرس قيد التحضير. الشرح المكتوب تحت كامل وبيغنيك لحد ما ينزل.</p>
          </div>
        )}
      </div>

      <header class="head">
        <h1>{data.title}</h1>
        <div class="meta">
          <span>{formatDate(data.publishDate)}</span><span>·</span>
          <span class="mono">{data.duration}</span><span>·</span>
          <span class="badge badge-orange">{data.level}</span>
          <span class="badge badge-outline">{data.category}</span>
          <span class="badge badge-outline">{data.lessonType}</span>
        </div>
        <p class="lead">{data.description}</p>
        {data.tags.length > 0 && (
          <div class="tags">
            {data.tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
          </div>
        )}
        {data.youtubeUrl && (
          <a class="yt" href={data.youtubeUrl} target="_blank" rel="noopener">
            <Icon name="youtube" size={17} /> شاهد نفس الدرس على يوتيوب
          </a>
        )}
      </header>

      {data.prerequisites.length > 0 && (
        <section class="pre">
          <h2 class="mini-ttl">قبل ما تبدأ</h2>
          <ul class="mini-list">
            {data.prerequisites.map((p) => <li>{p}</li>)}
          </ul>
        </section>
      )}

      {data.summary.length > 0 && (
        <section class="summary">
          <h2 class="mini-ttl">الخلاصة بنقاط</h2>
          <ul class="mini-list">
            {data.summary.map((p) => <li>{p}</li>)}
          </ul>
        </section>
      )}

      {bodyHtml ? <Prose html={bodyHtml} /> : <div class="prose"><Content /></div>}

      {data.exercise.length > 0 && (
        <section class="exercise">
          <div class="ex-head">
            <span class="ex-tag">تمرين</span>
            <h2>{data.exerciseTitle ?? 'طبّق اللي تعلّمته'}</h2>
          </div>
          <ol class="ex-list">
            {data.exercise.map((step) => <li>{step}</li>)}
          </ol>
          {data.exerciseNote && <p class="ex-note">{data.exerciseNote}</p>}

          {(data.solution.length > 0 || data.solutionCode) && (
            <details class="sol">
              <summary>اكشف الحل</summary>
              <div class="sol-body">
                {data.solution.length > 0 && (
                  <ul class="sol-list">
                    {data.solution.map((step) => <li>{step}</li>)}
                  </ul>
                )}
                {data.solutionCode && <pre class="sol-code"><code>{data.solutionCode}</code></pre>}
              </div>
            </details>
          )}
        </section>
      )}

      <div class="progress-row">
        <button class="btn btn-ghost btn-sm done-btn" type="button" id="done-btn" data-lesson={lesson.id} aria-pressed="false">
          <Icon name="check" size={16} /> <span class="done-label">علّم كمنتهي</span>
        </button>
        <span class="done-hint">التتبّع محفوظ بمتصفّحك فقط — بدون حساب ولا تسجيل.</span>
      </div>

      <InlineNewsletter text="اشترك بالنشرة وبيوصلك كل درس جديد على بريدك، بدون ما تعتمد على خوارزمية." />

      <nav class="pager" aria-label="التنقّل بين دروس الدورة">
        {prev ? (
          <a class="pg" href={`/lessons/${prev.id}/`}>
            <span class="pg-lbl">الدرس السابق</span>
            <span class="pg-ttl">{prev.data.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="pg nx" href={`/lessons/${next.id}/`}>
            <span class="pg-lbl">الدرس التالي</span>
            <span class="pg-ttl">{next.data.title}</span>
          </a>
        ) : <span></span>}
      </nav>

      <Comments page={`/lessons/${lesson.id}/`} title={data.title} />
    </article>

    <aside class="side">
      {data.appUsed && (
        <section class="box">
          <h2 class="box-ttl">التطبيق المستخدم</h2>
          <p class="app">{data.appUsed}</p>
        </section>
      )}

      {data.resources.length > 0 && (
        <section class="box">
          <h2 class="box-ttl">ملفات الدرس</h2>
          <div class="files">
            {data.resources.map((r) => (
              <a class="file" href={r.url} target="_blank" rel="noopener">
                <Icon name="file" size={17} /><span class="mono">{r.label}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {course && siblings.length > 0 && (
        <section class="box">
          <span class="eyebrow">محتوى الدورة</span>
          <h2 class="box-ttl">{course.data.title}</h2>
          <ol class="pl">
            {siblings.map((s, i) => (
              <li>
                <a href={`/lessons/${s.id}/`} class:list={['pl-item', { on: s.id === lesson.id }]}
                   aria-current={s.id === lesson.id ? 'true' : undefined}>
                  <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="pl-ttl">{s.data.title}</span>
                  <span class="dur mono">{s.data.duration}</span>
                </a>
              </li>
            ))}
          </ol>
          <a class="btn btn-ghost btn-sm full" href={`/courses/${course.id}/`}>صفحة الدورة</a>
        </section>
      )}
    </aside>
  </div>

  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><h2>دروس متعلّقة</h2></div>
        <div class="grid grid-4">{related.map((l) => <LessonCard lesson={l} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .crumbs {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    padding-block: 18px; font-size: 14px; color: var(--muted);
  }
  .crumbs .now { color: var(--ink); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 40px; align-items: start; padding-bottom: 20px; }
  @media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } }

  .player {
    aspect-ratio: 16 / 9;
    background: var(--player-bg);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .player iframe { width: 100%; height: 100%; border: 0; display: block; }
  .player-empty {
    height: 100%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 16px;
    text-align: center;
    padding: 24px;
    background: linear-gradient(155deg, var(--player-1) 0%, var(--player-2) 100%);
    color: var(--muted);
    font-size: 14px;
  }
  .player-empty .play {
    display: grid; place-items: center;
    width: 74px; height: 74px; border-radius: 999px;
    background: var(--cyan-soft); border: 2px solid var(--cyan); color: var(--cyan);
  }
  .player-empty code { background: var(--cyan-soft); color: var(--cyan-bright); padding: 2px 6px; border-radius: 5px; }

  .head { display: grid; gap: 14px; margin-block: 26px 30px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag {
    font-size: 12.5px; color: var(--muted);
    border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px;
  }
  .tag:hover { color: var(--cyan); border-color: var(--line-strong); }
  .pre, .summary {
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 20px 22px; margin-bottom: 24px;
  }
  .pre { border-inline-start: 3px solid var(--orange); }
  .summary { border-inline-start: 3px solid var(--cyan); }
  .mini-ttl { font-size: 16px; margin: 0 0 10px; }
  .mini-list { margin: 0; padding-inline-start: 20px; display: grid; gap: 8px; color: var(--ink-2); font-size: 16px; line-height: 1.85; }
  .mini-list li::marker { color: var(--cyan); }
  .pre .mini-list li::marker { color: var(--orange); }
  .app { font-size: 15px; color: var(--ink-2); margin: 0; line-height: 1.8; }
  .meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-size: 14px; color: var(--muted); }
  .yt { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; justify-self: start; }

  .exercise {
    background: var(--surface); border: 1px solid var(--orange-line);
    border-radius: var(--r-lg); padding: 24px 26px; margin-top: 36px; max-width: var(--read);
  }
  .ex-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .ex-tag {
    font-size: 12px; font-weight: 700; color: var(--orange);
    background: var(--orange-soft); padding: 5px 12px; border-radius: 999px;
  }
  .exercise h2 { font-size: 20px; margin: 0; }
  .ex-list { margin: 16px 0 0; padding-inline-start: 22px; display: grid; gap: 10px; color: var(--ink-2); font-size: 16px; line-height: 1.85; }
  .ex-list li::marker { color: var(--orange); font-weight: 600; }
  .ex-note { margin: 14px 0 0; font-size: 14.5px; color: var(--muted); line-height: 1.8; }

  .sol { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 16px; }
  .sol summary {
    cursor: pointer; font-size: 15px; font-weight: 600; color: var(--cyan);
    list-style: none; display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 0; min-height: 40px;
  }
  .sol summary::-webkit-details-marker { display: none; }
  .sol summary::before { content: '▸'; transition: transform .15s ease; }
  .sol[open] summary::before { transform: rotate(-90deg); }
  .sol-body { padding-top: 8px; }
  .sol-list { margin: 0; padding-inline-start: 22px; display: grid; gap: 9px; color: var(--ink-2); font-size: 16px; line-height: 1.85; }
  .sol-list li::marker { color: var(--cyan); }
  .sol-code {
    margin: 14px 0 0; padding: 16px 18px; border-radius: var(--r-md);
    border: 1px solid var(--line); background: var(--bg);
    overflow-x: auto; font-size: 14px; line-height: 1.9; text-align: left; direction: ltr;
  }

  .progress-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; margin-top: 30px; }
  .done-btn.on { background: var(--cyan-soft); border-color: var(--cyan); color: var(--cyan); }
  .done-hint { font-size: 13px; color: var(--faint); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 44px; }
  .pg {
    display: grid; gap: 6px;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-md); padding: 16px 18px; color: inherit;
  }
  .pg:hover { border-color: var(--line-strong); }
  .pg.nx { text-align: left; }
  .pg-lbl { font-size: 12px; color: var(--orange); font-weight: 600; }
  .pg-ttl { font-size: 15px; font-weight: 600; }

  .side { display: grid; gap: 18px; position: sticky; top: 84px; }
  @media (max-width: 1000px) { .side { position: static; } }
  .box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 22px; display: grid; gap: 12px; }
  .box-ttl { font-size: 17px; }
  .files { display: grid; gap: 9px; }
  .file {
    display: flex; align-items: center; gap: 10px;
    background: var(--navy); border: 1px solid var(--line);
    border-radius: var(--r-sm); padding: 12px 14px;
    font-size: 13px; color: var(--ink-2); min-height: 44px;
  }
  .file:hover { border-color: var(--line-strong); color: var(--cyan); }

  .pl { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .pl-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border-radius: var(--r-sm);
    color: var(--ink-2);
    font-size: 14.5px;
    min-height: 44px;
  }
  .pl-item:hover { background: var(--surface-2); color: var(--ink); }
  .pl-item.on { background: var(--orange-soft); color: var(--orange); font-weight: 600; }
  .pl-item .num { font-size: 12px; color: var(--cyan); }
  .pl-item.on .num { color: var(--orange); }
  .pl-item .dur { font-size: 12px; color: var(--faint); }
  .full { width: 100%; }
</style>

<script>
  // ===== تتبّع التقدّم — محفوظ بمتصفّح الزائر فقط =====
  const DONE_KEY = 'ta-done';
  const LAST_KEY = 'ta-last';

  const readDone = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(DONE_KEY) ?? '[]');
    } catch {
      return [];
    }
  };
  const writeDone = (list: string[]) => {
    try {
      localStorage.setItem(DONE_KEY, JSON.stringify(list));
    } catch {
      /* المتصفّح مانع التخزين */
    }
  };

  const btn = document.getElementById('done-btn') as HTMLButtonElement | null;
  const label = btn?.querySelector('.done-label');
  const id = btn?.dataset.lesson ?? '';

  function paint(done: boolean) {
    if (!btn || !label) return;
    btn.classList.toggle('on', done);
    btn.setAttribute('aria-pressed', String(done));
    label.textContent = done ? 'خلّصت هذا الدرس' : 'علّم كمنتهي';
  }

  if (btn && id) {
    paint(readDone().includes(id));
    btn.addEventListener('click', () => {
      const list = readDone();
      const i = list.indexOf(id);
      if (i === -1) list.push(id);
      else list.splice(i, 1);
      writeDone(list);
      paint(list.includes(id));
    });
  }

  // حفظ آخر درس مفتوح حتى تظهر بطاقة «كمّل من وين وقفت» بالرئيسية
  try {
    const h1 = document.querySelector('h1');
    localStorage.setItem(
      LAST_KEY,
      JSON.stringify({ href: location.pathname, title: h1?.textContent?.trim() ?? '' }),
    );
  } catch {
    /* لا شي */
  }
</script>
