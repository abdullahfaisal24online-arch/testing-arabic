---
import Base from '../../layouts/Base.astro';
import { getSite } from '../../lib/site';
import { getEntry } from 'astro:content';

const site = await getSite();
const dhEntry = await getEntry('debugHunt', 'debug-hunt').catch(() => undefined);
const dh = dhEntry?.data ?? { trashEnabled: true, trashPhoto: '', trashPhoto2: '', trashPhoto3: '', trashPoints: 50 };
const title = 'Debug Hunt — اصطاد الـ bugs قبل ما توصل Production';
const description = 'لعبة retro خفيفة من Testing بالعربي: اصطاد الـ bugs، انتبه لا تكسر أي feature، وشارك سكورك مع صحابك.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: 'Debug Hunt',
  description,
  url: `${site.url}/debug-hunt/`,
  inLanguage: 'ar',
  genre: 'Arcade',
  gamePlatform: 'Web browser',
  applicationCategory: 'Game',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <main class="dh dots" id="dh-app" data-trash-enabled={String(dh.trashEnabled)} data-trash-photos={JSON.stringify([dh.trashPhoto || '', dh.trashPhoto2 || '', dh.trashPhoto3 || ''])} data-trash-points={String(dh.trashPoints)}>
    <div class="wrap">
      <header class="dh-head">
        <span class="eyebrow">استراحة 60 ثانية</span>
        <h1><span class="px">Debug Hunt</span> <span aria-hidden="true">🐞</span></h1>
        <p class="lead">اصطاد الـ bugs قبل ما توصل Production… وانتبه لا تكسر أي feature.</p>
      </header>

      <div class="dh-cabinet">
        <div class="dh-screen">
          <canvas id="dh-canvas" width="320" height="180" aria-label="شاشة لعبة Debug Hunt" role="img"></canvas>
          <div class="dh-photo" id="dh-photo" hidden aria-hidden="true"><img alt="" decoding="async" /></div>
          <canvas id="dh-fx" width="320" height="180" aria-hidden="true"></canvas>

          <div class="dh-layer dh-title" id="dh-title">
            <div class="dh-logo px">DEBUG HUNT</div>
            <p class="dh-tag">اصطاد الـ bugs قبل ما توصل Production 🐞</p>
            <div class="dh-starts">
              <button class="dh-btn-start px" id="dh-start" type="button">▶ START</button>
              <button class="dh-btn-daily px" id="dh-daily" type="button">📅 DAILY</button>
            </div>
            <small class="dh-daily-note" id="dh-daily-note"></small>
            <div class="dh-legend px" dir="ltr">
              <span><b class="r">●</b> BUG +25</span><span><b class="y">●</b> CRITICAL +100</span><span><b class="c">●</b> FEATURE -50</span>
            </div>
          </div>

          <div class="dh-layer dh-banner" id="dh-banner" hidden><b class="px"></b><span></span></div>

          <div class="dh-layer dh-tip" id="dh-tip" hidden role="dialog" aria-label="QA Tip">
            <div class="tip-card">
              <div class="tip-k px">💡 QA TIP</div>
              <b class="tip-t"></b>
              <p class="tip-p"></p>
              <div class="tip-a">
                <a class="tip-link" href="/glossary/" target="_blank" rel="noopener">اقرأ أكثر ←</a>
                <button type="button" class="tip-go" id="dh-tip-go">كمّل ▶ <span></span></button>
              </div>
            </div>
          </div>

          <div class="dh-layer dh-pause" id="dh-pause" hidden>
            <b class="px">PAUSED</b><span>اضغط لتكمّل</span>
          </div>

          <div class="dh-layer dh-rotate" id="dh-rotate" hidden>
            <div class="rot-ico" aria-hidden="true">📱↻</div>
            <b>لفّ الموبايل بالعرض</b><span>بتلعب أحسن وبتشوف الـ bugs أوضح</span>
            <button type="button" id="dh-rot-ok">كمّل هيك</button>
          </div>

          <div class="dh-layer dh-report" id="dh-report" hidden role="dialog" aria-modal="true" aria-labelledby="rep-title">
            <div class="rep-card">
              <button type="button" class="rep-x" id="dh-exit-x" aria-label="خروج من اللعبة">✕</button>
              <div class="rep-head">
                <div class="rep-title px" id="rep-title">SPRINT REPORT</div>
                <div class="rep-new px dh-newbest" hidden>★ NEW BEST ★</div>
              </div>
              <div class="rep-main">
                <div class="rep-score">
                  <small class="px">SCORE</small>
                  <b class="px" data-r="score">000000</b>
                  <i class="px">BEST <span data-r="best">000000</span> · SPRINT <span data-r="sprint">1</span></i>
                </div>
                <p class="rep-msg" data-r="msg"></p>
              </div>
              <div class="rep-side">
                <div class="rep-grid">
                  <div class="tile"><b class="px" data-r="found">0</b><span>Bugs صدتها</span></div>
                  <div class="tile"><b class="px y" data-r="critical">0</b><span>Critical</span></div>
                  <div class="tile"><b class="px red" data-r="escaped">0</b><span>هربوا على Production</span></div>
                  <div class="tile"><b class="px c" data-r="broken">0</b><span>Features انكسرت</span></div>
                  <div class="tile"><b class="px" data-r="acc">0%</b><span>الدقة</span></div>
                  <div class="tile"><b class="px" data-r="sprint">1</b><span>وصلت Sprint</span></div>
                </div>
                <div class="rep-actions">
                  <button type="button" class="rb rb-primary" id="dh-share">شارك النتيجة</button>
                  <button type="button" class="rb rb-ghost" id="dh-again">العب مرة تانية</button>
                  <div class="rep-links">
                    <button type="button" class="rb rb-link" id="dh-card">حمّل بطاقة السكور</button>
                    <span aria-hidden="true">·</span>
                    <button type="button" class="rb rb-link" id="dh-exit">خروج</button>
                  </div>
                </div>
                <p class="dh-note" hidden></p>
              </div>
            </div>
          </div>
        </div>

        <div class="dh-controls">
          <button type="button" class="ctl" id="dh-sfx" aria-pressed="true"><i>🔈</i> <span>المؤثرات</span></button>
          <button type="button" class="ctl" id="dh-music" aria-pressed="true"><i>🎵</i> <span>الموسيقى</span></button>
          <button type="button" class="ctl" id="dh-fs" aria-pressed="false"><i>⛶</i> <span>ملء الشاشة</span></button>
          <button type="button" class="ctl ctl-quit" id="dh-quit" hidden><i>⏹</i> <span>إنهاء اللعبة</span></button>
          <a class="ctl ctl-home" href="/"><i>🏠</i> <span>الرئيسية</span></a>
          <span class="best px" dir="ltr">BEST <b data-best>000000</b></span>
        </div>
      </div>

      <section class="how" aria-labelledby="how-title">
        <h2 id="how-title">كيف تلعب؟</h2>
        <div class="how-grid">
          <div class="how-card"><i aria-hidden="true">🎯</i><b>صوّب واضغط</b><p>بالماوس أو اللمس. عندك 3 test runs لكل موجة bugs.</p></div>
          <div class="how-card"><i aria-hidden="true">🐞</i><b>الـ bugs نقاط</b><p>الحمرا +25، والذهبية Critical <span class="g">+100</span> بس أسرع بكثير.</p></div>
          <div class="how-card"><i aria-hidden="true">🦋</i><b>ممنوع الـ features</b><p>إذا صبت فراشة بتخسر 50 نقطة… Regression 😅</p></div>
          <div class="how-card"><i aria-hidden="true">🚨</i><b>عدّي الـ Sprint</b><p>كل Sprint فيه 10 bugs. لازم تصيد 6 على الأقل عشان تكمّل، وكل Sprint أسرع من اللي قبله.</p></div>
          <div class="how-card"><i aria-hidden="true">👻</i><b>bugs بأنواعها</b><p><b class="k">Flaky</b> بيختفي وبيرجع، <b class="k">Duplicate</b> بينقسم لاثنين، واللي بيهرب منك بيرجع <b class="k">Regression</b> بالـ Sprint الجاي.</p></div>
          <div class="how-card"><i aria-hidden="true">🔥</i><b>Production Incident</b><p>كل رابع Sprint بيطلعلك Boss ضخم. طلقات مفتوحة، بس لازم تخلّصه قبل ما يخلص الوقت.</p></div>
          <div class="how-card"><i aria-hidden="true">⚡</i><b>Power-ups</b><p>اطخّها لما تمرق: <b class="k">Hotfix</b> بيجمّد الـ bugs، <b class="k">Automation</b> طلقات مفتوحة، <b class="k">Code Review</b> بيبطّئ كل إشي.</p></div>
          <div class="how-card"><i aria-hidden="true">📅</i><b>Daily Challenge</b><p>كل يوم نفس الـ bugs لكل اللاعبين، ومحاولة وحدة. شارك نتيجتك وشوف مين أحسن.</p></div>
        </div>
      </section>

      <a class="cross" href="/bug-hunter/">
        <span>بدك تحدّي أعمق؟ جرّب <b>Bug Hunter</b> — اكتشف أخطاء حقيقية بمتجر كامل</span><span class="arr" aria-hidden="true">←</span>
      </a>
    </div>
  </main>
</Base>

<script>
  import { initDebugHunt } from '../../scripts/debug-hunt.js';
  const root = document.getElementById('dh-app');
  if (root) initDebugHunt(root);
</script>

<style>
  .dh { padding-block: 40px 70px; }
  .px { font-family: 'Press Start 2P', monospace; letter-spacing: 0; }
  .dh-head { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .dh-head h1 { font-size: clamp(24px, 4vw, 42px); margin: 16px 0 10px; line-height: 1.5; }
  .dh-head h1 .px { direction: ltr; unicode-bidi: isolate; }
  .dh-head .lead { margin-inline: auto; text-align: center; }

  .dh-cabinet { margin: 30px auto 0; max-width: 1100px; padding: 16px; border-radius: 22px;
    background: linear-gradient(180deg, #15223b, #0c1629); border: 2px solid rgba(56,189,248,.45);
    box-shadow: 0 30px 70px rgba(0,0,0,.45), 0 0 0 6px #060b16, 0 0 60px rgba(56,189,248,.15); }
  .dh-screen { position: relative; border-radius: 10px; overflow: hidden; border: 4px solid #060b16; aspect-ratio: 16/9; background: #070f1e; user-select: none; -webkit-user-select: none; }
  #dh-canvas { display: block; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; image-rendering: crisp-edges; touch-action: none; cursor: none; }
  #dh-fx { position: absolute; inset: 0; z-index: 1; width: 100%; height: 100%; object-fit: contain; image-rendering: pixelated; image-rendering: crisp-edges; pointer-events: none; }
  .dh-layer { position: absolute; inset: 0; z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; color: #f0f6ff; }
  .dh-layer[hidden] { display: none; }

  /* الصورة المعلّقة على الحاوية — بدقتها الكاملة فوق الـ canvas */
  .dh-photo { position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none; box-sizing: border-box;
    padding: calc(var(--u, 3px) * 1.6); background: #efe6d2; box-shadow: 0 calc(var(--u, 3px) * .8) calc(var(--u, 3px) * 1.6) rgba(0,0,0,.55);
    transform-origin: 50% 50%; will-change: transform; }
  .dh-photo[hidden] { display: none; }
  .dh-photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; filter: sepia(.15) contrast(1.05); }
  .dh-photo.is-pixel img { image-rendering: pixelated; filter: none; }
  .dh-photo::after { content: ''; position: absolute; top: calc(var(--u, 3px) * -1.4); right: calc(var(--u, 3px) * 1.2); width: calc(var(--u, 3px) * 8); height: calc(var(--u, 3px) * 2.6);
    background: rgba(240,246,255,.72); transform: rotate(12deg); }
  .dh-photo.is-falling::after { display: none; }

  /* شاشة البداية */
  .dh-title { background: radial-gradient(ellipse at center, rgba(5,10,20,.55), rgba(5,10,20,.15) 70%); gap: clamp(8px, 2vw, 22px); padding-bottom: 18%; }
  .dh-logo { font-size: clamp(22px, 6.2vw, 72px); color: #f0f6ff; text-shadow: .08em .08em 0 #000, 0 0 30px rgba(56,189,248,.5); direction: ltr; }
  .dh-tag { font-weight: 700; font-size: clamp(13px, 2.3vw, 26px); color: #38bdf8; text-shadow: 0 3px 14px #000; margin: 0; padding-inline: 12px; }
  .dh-btn-start { font-size: clamp(12px, 2.2vw, 24px); background: #f6823b; color: #1a0d04; border: 4px solid #000; box-shadow: 6px 6px 0 #000; padding: .8em 1.4em; cursor: pointer; animation: dh-blink 1.1s steps(2) infinite; }
  .dh-btn-start:hover { background: #ff9d5c; }
  .dh-btn-start:active { transform: translate(3px, 3px); box-shadow: 3px 3px 0 #000; }
  @keyframes dh-blink { 50% { filter: brightness(1.25); } }
  .dh-starts { display: flex; gap: clamp(8px, 1.6vw, 18px); flex-wrap: wrap; justify-content: center; }
  .dh-btn-daily { font-size: clamp(10px, 1.6vw, 18px); background: #0b162a; color: #38bdf8; border: 4px solid #000; box-shadow: 6px 6px 0 #000, inset 0 0 0 2px #38bdf8; padding: .95em 1.1em; cursor: pointer; direction: ltr; }
  .dh-btn-daily:hover { background: #13284a; }
  .dh-btn-daily:active { transform: translate(3px, 3px); box-shadow: 3px 3px 0 #000, inset 0 0 0 2px #38bdf8; }
  .dh-btn-daily.is-done { color: #34d399; box-shadow: 6px 6px 0 #000, inset 0 0 0 2px #34d399; cursor: default; }
  .dh-daily-note { margin-top: -4px; font-size: clamp(11px, 1.4vw, 15px); font-weight: 700; color: #b9c9df; text-shadow: 0 2px 8px #000; padding-inline: 12px; }
  .dh-legend { display: flex; gap: clamp(8px, 2vw, 26px); flex-wrap: wrap; justify-content: center; font-size: clamp(7px, 1.1vw, 13px); text-shadow: 2px 2px 0 #000; }
  .dh-legend .r { color: #e8412f; } .dh-legend .y { color: #f7c948; } .dh-legend .c { color: #38bdf8; }

  .dh-banner { background: rgba(5,10,20,.55); gap: 12px; pointer-events: none; }
  .dh-banner b { font-size: clamp(16px, 4vw, 44px); color: #38bdf8; text-shadow: 4px 4px 0 #000; direction: ltr; }
  .dh-banner span { font-weight: 700; font-size: clamp(13px, 2.2vw, 26px); text-shadow: 0 3px 12px #000; padding-inline: 12px; }

  /* QA Tip بين الـ Sprints */
  .dh-tip { background: rgba(5,10,20,.72); padding: 3%; }
  .tip-card { width: min(92%, 620px); background: #0b162a; border: 4px solid #f7c948; box-shadow: 8px 8px 0 #000; padding: clamp(12px, 2.2vw, 26px); text-align: start; max-height: 100%; overflow-y: auto; }
  .tip-k { font-size: clamp(9px, 1.2vw, 13px); color: #f7c948; direction: ltr; text-align: right; }
  .tip-t { display: block; margin-top: clamp(6px, 1vw, 12px); font-size: clamp(16px, 2.3vw, 26px); color: #f0f6ff; }
  .tip-p { margin: clamp(6px, 1vw, 10px) 0 0; font-size: clamp(13px, 1.7vw, 18px); line-height: 1.75; color: #cfdcef; }
  .tip-a { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: clamp(10px, 1.6vw, 18px); flex-wrap: wrap; }
  .tip-link { color: #38bdf8; font-weight: 700; font-size: clamp(13px, 1.5vw, 16px); text-decoration: none; border-bottom: 2px solid rgba(56,189,248,.4); }
  .tip-link:hover { color: #7dd3fc; }
  .tip-go { font: inherit; font-weight: 700; font-size: clamp(13px, 1.5vw, 16px); background: #f6823b; color: #1a0d04; border: 3px solid #000; box-shadow: 4px 4px 0 #000; padding: 8px 16px; cursor: pointer; }
  .tip-go span { font-weight: 400; opacity: .75; }
  .how-card .k { color: #38bdf8; font-weight: 700; }

  .dh-pause, .dh-rotate { background: rgba(5,10,20,.8); gap: 10px; cursor: pointer; padding: 16px; }
  .dh-pause b { font-size: clamp(16px, 3.5vw, 36px); color: #f6823b; }
  .dh-rotate { cursor: default; }
  .dh-rotate .rot-ico { font-size: 34px; }
  .dh-rotate b { font-size: 18px; } .dh-rotate span { color: #b9c9df; font-size: 14px; }
  .dh-rotate button { margin-top: 6px; font: inherit; font-weight: 700; font-size: 14px; background: #0b162a; color: #38bdf8; border: 2px solid #38bdf8; border-radius: 10px; padding: 6px 16px; cursor: pointer; }

  /* التقرير */
  /* تقرير النهاية — عمودين جوّا شاشة اللعبة عالكمبيوتر، ونافذة كاملة عالموبايل */
  .dh-report { background: rgba(5,10,20,.74); padding: 2%; overflow-y: auto; }
  .rep-card { width: min(96%, 900px); background: #0b162a; border: 5px solid #38bdf8; box-shadow: 10px 10px 0 #000;
    padding: clamp(14px, 2.2vw, 28px) clamp(16px, 2.6vw, 32px); display: grid; gap: clamp(8px, 1.4vw, 16px) clamp(16px, 2.4vw, 30px);
    grid-template-columns: 1fr 1.15fr; grid-template-areas: "head head" "main side"; align-items: center; }
  .rep-head { grid-area: head; text-align: center; }
  .rep-main { grid-area: main; text-align: center; }
  .rep-side { grid-area: side; }
  .rep-title { font-size: clamp(14px, 2vw, 24px); color: #38bdf8; direction: ltr; }
  .rep-new { margin-top: 8px; font-size: clamp(9px, 1.1vw, 13px); color: #f7c948; animation: dh-blink .8s steps(2) infinite; direction: ltr; }
  .rep-score small { display: block; font-size: clamp(9px, 1.1vw, 13px); color: #8a9ebd; direction: ltr; }
  .rep-score b { display: block; margin-top: 8px; font-size: clamp(28px, 4.2vw, 50px); font-weight: 400; color: #f6823b; text-shadow: 4px 4px 0 #000; direction: ltr; }
  .rep-score i { display: block; margin-top: 10px; font-style: normal; font-size: clamp(8px, 1vw, 12px); color: #8a9ebd; direction: ltr; }
  .rep-msg { margin: clamp(10px, 1.4vw, 16px) 0 0; font-weight: 700; font-size: clamp(15px, 1.7vw, 20px); line-height: 1.7; }
  .rep-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .tile { background: #0f1f38; border: 2px solid #1f4b73; border-radius: 10px; padding: clamp(7px, 1vw, 12px) 6px; text-align: center; }
  .tile b { display: block; font-weight: 400; font-size: clamp(14px, 1.7vw, 20px); color: #f0f6ff; direction: ltr; }
  .tile span { display: block; margin-top: 6px; font-size: clamp(12px, 1.2vw, 14px); line-height: 1.4; color: #9fb4d4; }
  .tile .y { color: #f7c948; } .tile .red { color: #ff6b6b; } .tile .c { color: #38bdf8; }
  .rep-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: clamp(10px, 1.4vw, 16px); }
  .rep-links { grid-column: 1 / -1; display: flex; justify-content: center; align-items: center; gap: 12px; color: #5f7292; }
  .rep-card { position: relative; }
  .rep-x { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; display: grid; place-items: center; font: inherit; font-size: 18px; line-height: 1;
    color: #cfe6fb; background: #0f1f38; border: 2px solid #1f4b73; border-radius: 10px; cursor: pointer; }
  .rep-x:hover { border-color: #38bdf8; color: #fff; }
  .rb { font: inherit; font-weight: 700; font-size: clamp(14px, 1.5vw, 18px); padding: .6em 1em; cursor: pointer; border: 3px solid #000; box-shadow: 5px 5px 0 #000; }
  .rb:active { transform: translate(2px, 2px); box-shadow: 3px 3px 0 #000; }
  .rb-primary { background: #f6823b; color: #1a0d04; }
  .rb-ghost { background: #0b162a; color: #38bdf8; border-color: #38bdf8; }
  .rb-link { background: transparent; color: #b9c9df; border: 0; box-shadow: none; text-decoration: underline; padding-inline: .4em; font-size: 14px; }

  /* الموبايل: التقرير نافذة فوق الشاشة كلها بدل ما ينحشر جوّا اللعبة */
  @media (max-width: 900px), (max-height: 560px) {
    .dh-tip { position: fixed; inset: 0; z-index: 10050; padding: 14px; }
    .dh-tip[hidden] { display: none; }
    .tip-card { width: min(100%, 520px); }
    .dh-report { position: fixed; inset: 0; z-index: 10050; padding: 14px; padding-top: max(14px, env(safe-area-inset-top)); padding-bottom: max(14px, env(safe-area-inset-bottom));
      background: rgba(5, 10, 20, .82); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); justify-content: flex-start; }
    .dh-report[hidden] { display: none; }
    .rep-card { width: min(100%, 520px); margin: auto; grid-template-columns: 1fr; grid-template-areas: "head" "main" "side"; padding: 18px; }
    .rep-title { font-size: 17px; } .rep-new { font-size: 10px; }
    .rep-score small { font-size: 10px; } .rep-score b { font-size: 38px; } .rep-score i { font-size: 10px; }
    .rep-msg { font-size: 17px; }
    .tile b { font-size: 16px; } .tile span { font-size: 12.5px; }
    .rep-actions { grid-template-columns: 1fr; }
    .rb { font-size: 17px; padding: 12px; } .rb-link { font-size: 14px; padding: 4px; box-shadow: none; }
  }
  @media (orientation: landscape) and (max-height: 560px) {
    .dh-report { padding: 8px 14px; padding-left: max(14px, env(safe-area-inset-left)); padding-right: max(14px, env(safe-area-inset-right)); }
    .rep-card { width: min(100%, 780px); grid-template-columns: 1fr 1.15fr; grid-template-areas: "head head" "main side"; padding: 10px 16px 12px; gap: 4px 16px; border-width: 4px; }
    .rep-head { display: flex; justify-content: center; align-items: baseline; gap: 14px; }
    .rep-title { font-size: 14px; } .rep-new { margin-top: 0; font-size: 9px; }
