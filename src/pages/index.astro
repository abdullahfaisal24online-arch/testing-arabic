---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LessonCard from '../components/LessonCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CourseCard from '../components/CourseCard.astro';
import NewsCard from '../components/NewsCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import Newsletter from '../components/Newsletter.astro';
import BugHunterCard from '../components/BugHunterCard.astro';
import { getSite, getHome, splitHighlight } from '../lib/site';
import { bunnyThumb, bunnyEmbed } from '../lib/utils';

const site = await getSite();
const home = await getHome();
const bugHunterEntry = await getEntry('bugHunter', 'bug-hunter');
const bugHunter = bugHunterEntry?.data;
const heading = splitHighlight(home.heroTitle, home.heroHighlight);

const live = <T extends { data: { draft: boolean } }>(e: T) => !e.data.draft;

const lessons = (await getCollection('lessons'))
  .filter(live)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const courses = (await getCollection('courses'))
  .filter(live)
  .sort((a, b) => a.data.order - b.data.order);

const resources = (await getCollection('resources'))
  .filter(live)
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  });

const news = (await getCollection('news'))
  .filter(live)
  .sort((a, b) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
  });

const articles = (await getCollection('articles'))
  .filter(live)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const featured = lessons.find((l) => l.data.featured) ?? lessons[0];
const featuredThumb = featured
  ? bunnyThumb(featured.data.videoId, featured.data.thumbnail, site.bunnyCdnHostname)
  : null;
const latest = lessons.filter((l) => l.id !== featured?.id).slice(0, 4);

// بطاقة البطل: فيديو ترحيبي ثابت، أو آخر درس
const welcomeEmbed = home.welcomeVideoId ? bunnyEmbed(home.welcomeVideoId, site.bunnyLibraryId) : '';

const countFor = (courseId: string) =>
  lessons.filter((l) => (l.data.course ?? l.data.track) === courseId).length;

const courseTitles = Object.fromEntries(courses.map((c) => [c.id, c.data.title]));

const courseTitleOf = (l: (typeof lessons)[number]) =>
  courseTitles[(l.data.course ?? l.data.track) ?? ''];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: 'ar',
    description: site.description,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${site.url}/search/?q={search_term_string}`,
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'EducationalOrganization',
    name: site.name,
    url: site.url,
    sameAs: [site.youtube, site.linkedin].filter(Boolean),
  },
];
---
<Base title={site.name} description={site.description} jsonLd={jsonLd}>
  <!-- ===== البطل ===== -->
  <section class="hero dots">
    <div class="wrap hero-in">
      <div class="hero-txt">
        {home.heroEyebrow && (
          <span class="pill"><span class="dot"></span> {home.heroEyebrow}</span>
        )}
        <h1>{heading.before}<span class="cy">{heading.mark}</span>{heading.after}</h1>
        {home.heroSubtitle && <p class="lead">{home.heroSubtitle}</p>}

        <div class="cta">
          {home.primaryCtaLabel && (
            <a class="btn btn-primary" href={home.primaryCtaHref}>
              {home.primaryCtaLabel} <Icon name="arrow" size={19} />
            </a>
          )}
          {home.secondaryCtaLabel && (
            <a class="btn btn-ghost" href={home.secondaryCtaHref}>
              <Icon name="play" size={17} /> {home.secondaryCtaLabel}
            </a>
          )}
        </div>

        {home.showStats && home.statsStyle === 'أرقام' && (
          <div class="stats">
            <div><b>{lessons.length}</b><span>{home.statLessonsLabel}</span></div>
            <i></i>
            <div><b>{courses.length}</b><span>{home.statCoursesLabel}</span></div>
            <i></i>
            <div><b>{articles.length}</b><span>{home.statArticlesLabel}</span></div>
          </div>
        )}

        {home.showStats && home.statsStyle === 'قيم' && home.values.length > 0 && (
          <div class="values">
            {home.values.map((v) => (
              <div class="val">
                <span class="v-ttl">{v.title}</span>
                <span class="v-txt">{v.text}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      {home.showWelcome ? (
        <div class="feat card welcome">
          <div class="thumb">
            {welcomeEmbed ? (
              <iframe
                src={welcomeEmbed}
                title={home.welcomeTitle || 'فيديو ترحيبي'}
                loading="lazy"
                allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen"
                allowfullscreen
              ></iframe>
            ) : (
              <>
                {home.welcomeThumbnail ? (
                  <img src={home.welcomeThumbnail} alt="" width="960" height="540" />
                ) : null}
                <span class="play"><Icon name="play" size={22} /></span>
              </>
            )}
            {home.welcomeBadge && !welcomeEmbed && (
              <span class="badge badge-orange feat-tag">{home.welcomeBadge}</span>
            )}
          </div>
          {(home.welcomeTitle || home.welcomeText) && (
            <div class="card-body">
              {home.welcomeTitle && <span class="feat-ttl">{home.welcomeTitle}</span>}
              {home.welcomeText && <span class="w-text">{home.welcomeText}</span>}
            </div>
          )}
        </div>
      ) : home.showFeatured && featured ? (
        <a class="feat card" href={`/lessons/${featured.id}/`}>
          <div class="thumb">
            {featuredThumb ? <img src={featuredThumb} alt="" width="960" height="540" /> : null}
            <span class="play"><Icon name="play" size={22} /></span>
            {home.featuredBadge && <span class="badge badge-orange feat-tag">{home.featuredBadge}</span>}
          </div>
          <div class="card-body">
            <span class="feat-ttl">{featured.data.title}</span>
            <span class="card-meta">
              <Icon name="clock" size={14} /> {featured.data.duration}
              <span>·</span>
              <span>{featured.data.category}</span>
              <span class="grow"></span>
              <span class="go">{home.featuredCta}</span>
            </span>
          </div>
        </a>
      ) : null}
    </div>
  </section>

  <!-- ===== كمّل من وين وقفت ===== -->
  <section class="section resume-wrap" id="resume" hidden>
    <div class="wrap">
      <a class="resume" id="resume-link" href="/lessons/">
        <span class="r-ic"><Icon name="play" size={20} /></span>
        <span class="r-txt">
          <span class="r-lbl">كمّل من وين وقفت</span>
          <span class="r-ttl" id="resume-title"></span>
        </span>
        <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>

  <!-- ===== لعبة Bug Hunter ===== -->
  {bugHunter?.enabled && bugHunter.showHomeCard && <BugHunterCard settings={bugHunter} />}

  <!-- ===== الدورات ===== -->
  {home.showCourses && courses.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            {home.coursesEyebrow && <span class="eyebrow">{home.coursesEyebrow}</span>}
            <h2>{home.coursesTitle}</h2>
            {home.coursesSubtitle && <p class="lead">{home.coursesSubtitle}</p>}
          </div>
          <span class="grow"></span>
          <a href="/courses/" class="more">كل الدورات ←</a>
        </div>
        <div class="grid grid-3">
          {courses
            .slice()
            .sort((a, b) => {
              const ea = countFor(a.id) === 0 ? 1 : 0;
              const eb = countFor(b.id) === 0 ? 1 : 0;
              return ea - eb || a.data.order - b.data.order;
            })
            .slice(0, 3)
            .map((c) => <CourseCard course={c} count={countFor(c.id)} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ===== أحدث الدروس ===== -->
  {home.showLessons && latest.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>{home.lessonsTitle}</h2>
          <span class="grow"></span>
          <a href="/lessons/" class="more">كل الدروس ←</a>
        </div>
        <div class="grid grid-4">
          {latest.map((l) => <LessonCard lesson={l} courseTitle={courseTitleOf(l)} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ===== المقالات ===== -->
  {home.showArticles && articles.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>{home.articlesTitle}</h2>
          <span class="grow"></span>
          <a href="/articles/" class="more">كل المقالات ←</a>
        </div>
        <div class="grid grid-3">
          {articles.slice(0, 3).map((a) => <ArticleCard article={a} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ===== الموارد ===== -->
  {home.showResources && resources.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            {home.resourcesEyebrow && <span class="eyebrow">{home.resourcesEyebrow}</span>}
            <h2>{home.resourcesTitle}</h2>
            {home.resourcesSubtitle && <p class="lead">{home.resourcesSubtitle}</p>}
          </div>
          <span class="grow"></span>
          <a href="/resources/" class="more">كل الموارد ←</a>
        </div>
        <div class="grid grid-3">
          {resources.slice(0, 3).map((r) => <ResourceCard resource={r} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ===== آخر الأخبار ===== -->
  {home.showNews && news.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <h2>{home.newsTitle}</h2>
          <span class="grow"></span>
          <a href="/news/" class="more">كل الأخبار ←</a>
        </div>
        <div class="grid grid-2">
          {news.slice(0, 2).map((n) => <NewsCard item={n} />)}
        </div>
      </div>
    </section>
  )}

  <Newsletter />
</Base>

<style>
  .hero { background: var(--navy); border-bottom: 1px solid var(--line); }
  .hero-in {
    display: flex;
    gap: 52px;
    align-items: center;
    flex-wrap: wrap;
    padding-block: 66px 74px;
  }
  .hero-txt { flex: 1 1 520px; display: grid; gap: 22px; align-content: start; }
  .pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--cyan-soft);
    border: 1px solid var(--line-strong);
    color: var(--cyan);
    font-size: 13px;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 999px;
  }
  .dot { width: 7px; height: 7px; border-radius: 999px; background: var(--cyan); }
  .cy { color: var(--cyan); }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .stats {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .stats div { display: grid; gap: 2px; }
  .stats b { font-size: 26px; font-variant-numeric: tabular-nums; }
  .stats span { font-size: 14px; color: var(--muted); }
  .stats i { width: 1px; height: 34px; background: var(--line); }

  .feat { flex: 1 1 440px; max-width: 560px; color: inherit; box-shadow: var(--shadow-lg); }
  .feat .card-body { padding: 20px 22px 24px; }
  .feat-tag { position: absolute; inset-block-start: 14px; inset-inline-start: 14px; }
  .feat-ttl { font-size: 20px; font-weight: 700; line-height: 1.6; }
  .welcome .thumb iframe { width: 100%; height: 100%; border: 0; display: block; }
  .welcome .card-body { gap: 8px; }
  .w-text { font-size: 15px; color: var(--ink-3); line-height: 1.85; }
  .go { color: var(--cyan); font-weight: 600; }

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .val { display: grid; gap: 5px; }
  .v-ttl { font-size: 16px; font-weight: 700; color: var(--ink); }
  .v-txt { font-size: 14.5px; color: var(--muted); line-height: 1.8; }
  @media (max-width: 760px) { .values { grid-template-columns: 1fr; gap: 14px; } }

  .resume-wrap { padding-block: 30px 0; }
  .resume {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px;
    background: var(--surface); border: 1px solid var(--orange-line);
    border-radius: var(--r-lg); padding: 18px 22px; color: var(--ink);
  }
  .resume:hover { border-color: var(--orange); color: var(--ink); }
  .r-ic {
    display: grid; place-items: center; width: 44px; height: 44px;
    border-radius: var(--r-md); background: var(--orange-soft); color: var(--orange);
  }
  .r-txt { display: grid; gap: 3px; min-width: 0; }
  .r-lbl { font-size: 12.5px; font-weight: 600; color: var(--orange); }
  .r-ttl { font-size: 17px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .more { font-size: 15px; font-weight: 600; }
  .section-head h2 + .lead { margin-top: 10px; }
  .eyebrow + h2 { margin-top: 10px; }

  @media (max-width: 560px) {
    .cta { display: grid; grid-template-columns: 1fr; }
    .hero-in { padding-block: 44px 52px; }
  }
</style>

<script>
  // بطاقة «كمّل من وين وقفت» — بتظهر فقط لو الزائر فتح درس قبل
  try {
    const raw = localStorage.getItem('ta-last');
    if (raw) {
      const last = JSON.parse(raw) as { href?: string; title?: string };
      if (last?.href && last?.title) {
        const box = document.getElementById('resume');
        const link = document.getElementById('resume-link') as HTMLAnchorElement | null;
        const ttl = document.getElementById('resume-title');
        if (box && link && ttl) {
          link.href = last.href;
          ttl.textContent = last.title;
          box.hidden = false;
        }
      }
    }
  } catch {
    /* المتصفّح مانع التخزين — البطاقة بتضل مخفية */
  }
</script>
