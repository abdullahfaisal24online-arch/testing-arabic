---
import Base from '../../../layouts/Base.astro';
import GenAIReader from '../../../components/readers/GenAIReader.astro';

// Both editorial routes are omitted from production builds.
export function getStaticPaths() {
  return process.env.CMS_BRANCH === 'staging'
    ? ['preview', 'full'].map(view => ({ params: { view } }))
    : [];
}
const isFull = Astro.params.view === 'full';
---
<Base title={isFull ? "مسودة دليل CT-GenAI الكامل" : "معاينة دليل CT-GenAI — تجربة القراءة"} description="دليل Testing بالعربي لدراسة CT-GenAI — مراجعة تحريرية." noindex hideChat>
  <GenAIReader mode={isFull ? 'full' : 'preview'} />
</Base>
