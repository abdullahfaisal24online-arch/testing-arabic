---
// المتجر مسكّر مؤقتاً قبل الإطلاق — بيعرض رسالة "قريباً" بدل المنتجات.
// الضغط على "المتجر" من القائمة بيطلّع Popup (src/components/StoreSoon.astro)،
// وهاي الصفحة هي البديل لو حدا فتح الرابط مباشرة أو من نتائج البحث (noindex).
// للرجوع لمتجر شغّال: استرجع النسخة السابقة من git history.
import Base from '../../layouts/Base.astro';
---

<Base
  title="المتجر — قريباً"
  description="القسم المدفوع قيد الإطلاق: دورات متقدمة، بنوك أسئلة وملخّصات احترافية. اشترك بالنشرة عشان تكون متابع معنا."
  noindex
>
  <section class="store-soon dots">
    <div class="wrap">
      <span class="badge"><span class="dot"></span>قريباً</span>
      <h1>المتجر <span class="tri">🔻</span></h1>
      <p>دورات متقدمة، بنوك أسئلة، ملخّصات احترافية.<br />اشترك بالنشرة عشان تكون متابع معنا.</p>
      <a class="cta" href="/newsletter/">اشترك بالنشرة ←</a>
    </div>
  </section>
</Base>

<style>
  .store-soon {
    min-height: 62vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    text-align: center;
  }
  .store-soon .wrap { width: min(92vw, 560px); }
  .store-soon .badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 700;
    color: #f6823b;
    background: rgba(246, 130, 59, 0.12);
    border: 1px solid rgba(246, 130, 59, 0.3);
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .store-soon .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #f6823b;
    animation: ssPulse 1.8s infinite;
  }
  @keyframes ssPulse {
    0% { box-shadow: 0 0 0 0 rgba(246, 130, 59, 0.5); }
    70% { box-shadow: 0 0 0 12px rgba(246, 130, 59, 0); }
    100% { box-shadow: 0 0 0 0 rgba(246, 130, 59, 0); }
  }
  .store-soon h1 {
    margin: 0 0 18px;
    font-size: clamp(30px, 6vw, 46px);
    font-weight: 800;
  }
  .store-soon .tri { color: #e5484d; }
  .store-soon p {
    margin: 0 0 30px;
    font-size: 17px;
    line-height: 2;
    color: var(--muted, #aeb9cc);
  }
  .store-soon .cta {
    display: inline-block;
    background: #f6823b;
    color: #0a1428;
    font-weight: 800;
    font-size: 16px;
    text-decoration: none;
    padding: 14px 30px;
    border-radius: 12px;
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .store-soon .cta:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(246, 130, 59, 0.35); }
  @media (prefers-reduced-motion: reduce) {
    .store-soon .dot { animation: none; }
  }
</style>
