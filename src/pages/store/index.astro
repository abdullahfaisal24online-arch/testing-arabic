---
// المتجر. بيظهر بس لما STORE_OPEN=1 وقت البناء (النسخة التجريبية حالياً).
// بالموقع الحقيقي بيضل يعرض «قريباً» لحد يوم الإطلاق — شوف src/lib/store.ts
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { STORE_OPEN, STORE_GROUPS, usd, getStoreSettings } from '../../lib/store';

const showCtflPreview = process.env.CMS_BRANCH === 'staging';
const products = STORE_OPEN
  ? (await getCollection('products')).filter((p) => !p.data.draft).sort((a, b) => a.data.order - b.data.order)
  : [];
const t = STORE_OPEN ? await getStoreSettings() : undefined;
const groups = STORE_GROUPS.map((g) => ({ ...g, title: t ? t[g.title] : '', items: products.filter((p) => (g.kinds as readonly string[]).includes(p.data.kind)) })).filter(
  (g) => g.items.length > 0 || (showCtflPreview && g.key === 'summaries'),
);
---

{!STORE_OPEN ? (
  <Base
    title="المتجر — قريباً"
    description="القسم المدفوع قيد الإطلاق: دورات متقدمة، بنوك أسئلة وملخّصات احترافية. اشترك بالنشرة عشان تكون متابع معنا."
    noindex
  >
    <section class="store-soon dots">
      <div class="wrap">
        <span class="soon-badge"><span class="dot"></span>قريباً</span>
        <h1>المتجر <span class="tri">🔻</span></h1>
        <p>دورات متقدمة، بنوك أسئلة، ملخّصات احترافية.<br />اشترك بالنشرة عشان تكون متابع معنا.</p>
        <a class="btn btn-primary" href="/newsletter/">اشترك بالنشرة ←</a>
      </div>
    </section>
  </Base>
) : (
  <Base title={t!.heroEyebrow} description={t!.heroText}>
    <!-- شريط «موادي»: بيتغيّر حسب إذا الجهاز مفعّل عليه مواد -->
    <div class="mybar" id="mybar">
      <div class="wrap mybar-in">
        <span class="mb-ic" aria-hidden="true">📚</span>
        <span class="mb-text" data-none>{t!.haveCodeText}</span>
        <span class="mb-text" data-has hidden>{t!.myBarText}</span>
        <a class="mb-btn" href="/pro/unlock/" data-none>{t!.haveCodeLink}</a>
        <a class="mb-btn on" href="/pro/" data-has hidden>{t!.myBarButton} ←</a>
      </div>
    </div>

    <section class="store-head dots">
      <div class="wrap">
        <span class="eyebrow">{t!.heroEyebrow}</span>
        <h1>{t!.heroTitle}</h1>
        <p class="lead">{t!.heroText}</p>
        {groups.length > 1 && (
          <div class="chips" role="tablist" aria-label="التصنيفات">
            <button type="button" class="chip on" data-f="all">{t!.allLabel}</button>
            {groups.map((g) => <button type="button" class="chip" data-f={g.key}>{g.title}</button>)}
          </div>
        )}
      </div>
    </section>

    <div class="wrap store-body">
      {groups.length === 0 && <p class="empty">{t!.emptyText}</p>}
      {groups.map((g) => (
        <section class="group" data-g={g.key}>
          <h2>{g.title}</h2>
          <div class="grid">
            {g.items.map((p) => (
              <a class="pcard" href={`/store/${p.id}/`}>
                <div class="thumb">
                  {p.data.cover ? <img src={p.data.cover} alt="" width="1280" height="720" loading="lazy" decoding="async" /> : <span class="ph">🔻</span>}
                </div>
                <div class="body">
                  <span class="kind">{p.data.kind}</span>
                  <h3>{p.data.cardTitle || p.data.title}</h3>
                  {(p.data.cardText || p.data.pitch) && <p>{p.data.cardText || p.data.pitch}</p>}
                  <div class="foot">
                    <span class="price">
                      <b>{usd(p.data.offerPrice ?? p.data.price)}</b>
                      {p.data.offerPrice != null && <s>{usd(p.data.price)}</s>}
                    </span>
                    <span class="go">{p.data.cardButton || t!.cardButton}</span>
                  </div>
                </div>
              </a>
            ))}
            {showCtflPreview && g.key === 'summaries' && (
              <a class="pcard" href="/store/ctfl-guide/preview/">
                <div class="thumb">
                  <span class="ctfl-cover" lang="en" dir="ltr">CTFL <small>STUDY GUIDE · v4.0.1</small></span>
                  <span class="flag">قيد التجهيز</span>
                </div>
                <div class="body">
                  <span class="kind">ملخصات</span>
                  <h3>دليل CTFL بالعربي</h3>
                  <p>عاين المحتوى الحالي للفصل الأول: Fundamentals of Testing. بقية الفصول قيد الإعداد.</p>
                  <div class="foot">
                    <span class="kind">معاينة الفصل الأول</span>
                    <span class="go">افتح الملخّص ←</span>
                  </div>
                </div>
              </a>
            )}
          </div>
        </section>
      ))}

    </div>
  </Base>
)}

<script>
  // موادي: إذا الجهاز عليه مواد بنبدّل الشريط لـ «افتح موادي»
  fetch('/api/pro/me', { cache: 'no-store' })
    .then((r) => r.json())
    .then((d) => {
      if (!d.ok || !d.products?.length) return;
      document.querySelectorAll<HTMLElement>('#mybar [data-none]').forEach((e) => (e.hidden = true));
      document.querySelectorAll<HTMLElement>('#mybar [data-has]').forEach((e) => (e.hidden = false));
      document.getElementById('mybar')!.classList.add('has');
    })
    .catch(() => {});

  const chips = [...document.querySelectorAll<HTMLButtonElement>('.store-head .chip')];
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((x) => x.classList.toggle('on', x === c));
      const f = c.dataset.f;
      document.querySelectorAll<HTMLElement>('.group').forEach((g) => (g.hidden = f !== 'all' && g.dataset.g !== f));
    }),
  );
</script>

<style>
  .store-soon { min-height: 62vh; display: flex; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; }
  .store-soon .wrap { width: min(92vw, 560px); }
  .soon-badge { display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 700; color: var(--orange); background: var(--orange-soft);
    border: 1px solid var(--orange-line); padding: 7px 16px; border-radius: 999px; margin-bottom: 22px; }
  .soon-badge .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--orange); }
  .store-soon h1 { margin: 0 0 18px; }
  .store-soon p { color: var(--muted); line-height: 1.9; margin-bottom: 26px; }

  .mybar { background: var(--surface); border-bottom: 1px solid var(--line); }
  .mybar.has { background: var(--cyan-soft); border-color: var(--cyan); }
  .mybar-in { display: flex; align-items: center; gap: 10px; padding-block: 10px; font-size: 14.5px; }
  .mb-text { flex: 1; color: var(--ink); min-width: 0; }
  .mb-text[hidden], .mb-btn[hidden] { display: none; }
  .mb-btn { flex: none; font-weight: 700; color: var(--cyan); border: 1.5px solid var(--cyan); border-radius: 999px; padding: 5px 16px; text-decoration: none; white-space: nowrap; }
  .mb-btn.on { background: var(--cyan); color: var(--navy); }
  .mb-btn:hover { filter: brightness(1.1); }
  .store-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 60px 40px; text-align: center; }
  .store-head .lead { max-width: 60ch; margin: 12px auto 0; color: var(--muted); line-height: 1.9; }
  .chips { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 26px; }
  .chip { font: inherit; font-size: 14.5px; font-weight: 600; padding: 7px 18px; border-radius: 999px; border: 1.5px solid var(--line-strong);
    background: transparent; color: var(--muted); cursor: pointer; }
  .chip.on { background: var(--cyan-soft); border-color: var(--cyan); color: var(--cyan); }

  .store-body { padding-block: 40px 70px; }
  .group + .group { margin-top: 44px; }
  .group h2 { font-size: 22px; margin-bottom: 18px; display: flex; align-items: center; gap: 10px; }
  .group h2::before { content: ''; width: 6px; height: 22px; border-radius: 3px; background: var(--orange); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
  .pcard { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    color: var(--ink); text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
  .pcard:hover { transform: translateY(-3px); border-color: var(--cyan); color: var(--ink); }
  .thumb { position: relative; aspect-ratio: 16 / 9; background: linear-gradient(135deg, #12213d, #0a1428); display: grid; place-items: center; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ctfl-cover { color: var(--cyan); font-size: 48px; font-weight: 800; text-align: center; }
  .ctfl-cover small { display: block; font-size: 13px; letter-spacing: .12em; color: var(--muted); margin-top: 6px; }
  .thumb .ph { font-size: 34px; }
  .flag { position: absolute; top: 12px; right: 12px; font-size: 12.5px; font-weight: 700; padding: 2px 12px; border-radius: 999px; background: var(--orange); color: var(--on-orange); }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .kind { font-size: 13px; font-weight: 700; color: var(--cyan); }
  .body h3 { font-size: 19px; line-height: 1.5; margin: 0; }
  .body p { color: var(--muted); font-size: 14.5px; line-height: 1.8; margin: 0; }
  .foot { margin-top: auto; padding-top: 12px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--line); }
  .price b { color: var(--orange); font-size: 20px; }
  .price s { color: var(--faint); font-size: 14px; margin-inline-start: 8px; }
  .go { font-size: 14px; font-weight: 700; color: var(--cyan); }
  .have { text-align: center; color: var(--muted); margin-top: 50px; font-size: 14.5px; }
  .empty { text-align: center; color: var(--muted); padding: 60px 0; }
</style>
