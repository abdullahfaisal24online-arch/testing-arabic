---
// صفحة المنتج. ما بتنبني أصلاً إلا لما المتجر مفتوح (STORE_OPEN=1) — شوف src/lib/store.ts
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import SampleQuiz from '../../components/store/SampleQuiz.astro';
import { getSite } from '../../lib/site';
import { STORE_OPEN, jod } from '../../lib/store';

export async function getStaticPaths() {
  if (!STORE_OPEN) return [];
  const products = (await getCollection('products')).filter((p) => !p.data.draft);
  return products.map((product) => ({ params: { slug: product.id }, props: { product, all: products } }));
}

const { product, all } = Astro.props;
const { data } = product;
await render(product);
const bodyHtml: string = (product as any).rendered?.html ?? '';
const site = await getSite();
const finalPrice = data.offerPrice ?? data.price;
const saving = data.offerPrice != null ? Math.round((1 - data.offerPrice / data.price) * 100) : 0;
const orderHref = `/store/${product.id}/order/`;

// العيّنة المجانية (إذا إلها ملف بـ src/data/store-samples/<slug>.json)
const samples = import.meta.glob<{ default: { total: number; items: any[] } }>('../../data/store-samples/*.json', { eager: true });
const sample = samples[`../../data/store-samples/${product.id}.json`]?.default;

type Item = (typeof all)[number];
const members: Item[] = (data.bundleOf ?? []).map((s: string) => all.find((p: Item) => p.id === s)).filter(Boolean) as Item[];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: data.title,
    description: data.pitch || data.title,
    image: data.cover ? new URL(data.cover, site.url).href : undefined,
    brand: { '@type': 'Brand', name: site.name },
    offers: { '@type': 'Offer', price: finalPrice, priceCurrency: 'JOD', availability: 'https://schema.org/InStock', url: `${site.url}/store/${product.id}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'المتجر', item: `${site.url}/store/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/store/${product.id}/` },
    ],
  },
];
---

<Base title={data.title} description={data.pitch || data.title} image={data.cover} jsonLd={jsonLd}>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span><a href="/store/">المتجر</a><span>›</span><span class="now">{data.title}</span>
  </div>

  <section class="wrap phero">
    <div class="pcover">
      {data.cover ? <img src={data.cover} alt={data.title} width="1280" height="720" decoding="async" fetchpriority="high" /> : <span class="ph">🔻</span>}
    </div>
    <div class="pinfo">
      <span class="eyebrow">{data.kind}</span>
      <h1>{data.title}</h1>
      {data.pitch && <p class="pitch">{data.pitch}</p>}

      <div class="pricebox">
        <div class="prow">
          <b class="now">{jod(finalPrice)}</b>
          {data.offerPrice != null && <s>{jod(data.price)}</s>}
          {saving > 0 && <span class="save">وفّر {saving}%</span>}
        </div>
        {data.offerNote && <p class="note">{data.offerNote}</p>}
        <a class="btn btn-primary buy" href={orderHref} data-track="store_buy">اطلب الآن ←</a>
        {sample && <a class="btn btn-ghost try" href="#sample">🎁 جرّب {sample.items.length} أسئلة مجاناً</a>}
        <ul class="trust">
          <li>دفع بـ CliQ أو تحويل بنكي</li>
          <li>كود تفعيل خاص فيك، على أي جهاز</li>
          <li>المحتوى جوّا المنصة، مش ملف بينتقل</li>
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap pbody">
    {data.includes.length > 0 && (
      <section class="panel">
        <h2>شو بتاخد؟</h2>
        <ul class="inc">{data.includes.map((it: string) => <li>{it}</li>)}</ul>
      </section>
    )}

    {members.length > 0 && (
      <section class="panel">
        <h2>الحزمة بتضم</h2>
        <ul class="inc">{members.map((m) => <li><a href={`/store/${m.id}/`}>{m.data.title}</a></li>)}</ul>
      </section>
    )}

    {sample && (
      <section class="sample" id="sample">
        <div class="shead">
          <span class="eyebrow">عيّنة مجانية</span>
          <h2>جرّب قبل ما تشتري</h2>
          <p>أول {sample.items.length} أسئلة من البنك، بنفس الشكل اللي بتلاقيه بعد الشراء. اختار جوابك وبتعرف فوراً إذا صح وليش.</p>
        </div>
        <SampleQuiz items={sample.items} total={sample.total} buyHref={orderHref} />
      </section>
    )}

    {bodyHtml && <section class="about panel"><Prose html={bodyHtml} /></section>}

    <section class="cta-end">
      <div>
        <h2>جاهز تبلّش؟</h2>
        <p>{data.title} · <b>{jod(finalPrice)}</b>{data.offerPrice != null && <s> {jod(data.price)}</s>}</p>
      </div>
      <a class="btn btn-primary" href={orderHref}>اطلب الآن ←</a>
    </section>

    <p class="have">اشتريت قبل؟ <a href="/pro/unlock/">فعّل الكود من هون</a></p>
  </div>
</Base>

<style>
  .crumbs { display: flex; gap: 8px; flex-wrap: wrap; font-size: 14px; color: var(--muted); padding-top: 22px; }
  .crumbs a { color: var(--muted); } .crumbs .now { color: var(--ink); }
  .phero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: start; padding-block: 26px 40px; }
  .pcover { border-radius: 20px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow-lg); aspect-ratio: 16 / 9; background: var(--surface); display: grid; place-items: center; }
  .pcover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pinfo h1 { font-size: clamp(26px, 3.4vw, 38px); line-height: 1.4; margin: 8px 0 10px; }
  .pitch { color: var(--muted); line-height: 1.9; margin: 0 0 20px; }
  .pricebox { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 20px; }
  .prow { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .prow .now { font-size: 34px; color: var(--orange); }
  .prow s { color: var(--faint); font-size: 18px; }
  .save { font-size: 13px; font-weight: 700; padding: 2px 10px; border-radius: 999px; background: rgba(52, 211, 153, .14); color: #34d399; }
  .note { margin: 6px 0 0; color: var(--muted); font-size: 14.5px; }
  .pricebox .btn { width: 100%; justify-content: center; margin-top: 14px; }
  .pricebox .try { margin-top: 10px; }
  .trust { list-style: none; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
  .trust li::before { content: '✓  '; color: #34d399; font-weight: 700; }

  .pbody { padding-bottom: 70px; display: grid; gap: 34px; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 22px 24px; }
  .panel h2, .shead h2, .cta-end h2 { font-size: 22px; margin: 0 0 12px; }
  .inc { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px 24px; }
  .inc li { position: relative; padding-inline-start: 26px; line-height: 1.8; }
  .inc li::before { content: '✓'; position: absolute; inset-inline-start: 0; color: #34d399; font-weight: 700; }
  .shead { margin-bottom: 16px; }
  .shead p { color: var(--muted); line-height: 1.9; margin: 0; }
  .cta-end { display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; padding: 22px 24px; border-radius: 18px;
    background: linear-gradient(135deg, var(--orange-soft), var(--cyan-soft)); border: 1px solid var(--orange-line); }
  .cta-end p { margin: 0; color: var(--muted); } .cta-end b { color: var(--orange); } .cta-end s { color: var(--faint); }
  .have { text-align: center; color: var(--muted); font-size: 14.5px; margin: 0; }
  @media (max-width: 860px) { .phero { grid-template-columns: 1fr; gap: 22px; } }
</style>
