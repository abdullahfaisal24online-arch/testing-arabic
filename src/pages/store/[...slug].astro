---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prose from '../../components/Prose.astro';
import { getSite } from '../../lib/site';

export async function getStaticPaths() {
  const products = (await getCollection('products')).filter((p) => !p.data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product, all: products },
  }));
}

const { product, all } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const site = await getSite();

const pay = site.payInstructions || '';
const wa = (site.whatsapp || '').replace(/[^0-9]/g, '');
const finalPrice = data.offerPrice ?? data.price;

// أعضاء الحزمة — أسماءهم بدل الـ slugs
type Item = (typeof all)[number];
const members: Item[] = [];
for (const slug of data.bundleOf ?? []) {
  const hit = all.find((p: Item) => p.id === slug);
  if (hit) members.push(hit);
}

const waText = encodeURIComponent(`مرحبا، بدي أشتري: ${data.title} (${finalPrice} د.أ)`);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: data.title,
    description: data.pitch || data.title,
    brand: { '@type': 'Brand', name: site.name },
    offers: {
      '@type': 'Offer',
      price: finalPrice,
      priceCurrency: 'JOD',
      availability: 'https://schema.org/InStock',
      url: `${site.url}/store/${product.id}/`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'المتجر', item: `${site.url}/store/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/store/${product.id}/` },
    ],
  },
];
---

<Base title={data.title} description={data.pitch || data.title} jsonLd={jsonLd}>
  <div class="wrap crumbs">
    <a href="/">الرئيسية</a><span>›</span>
    <a href="/store/">المتجر</a><span>›</span>
    <span class="now">{data.title}</span>
  </div>

  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">{data.kind}</span>
      <h1>{data.title}</h1>
      {data.pitch && <p class="intro">{data.pitch}</p>}

      <div class="pricebox">
        <p class="price">
          {
            data.offerPrice ? (
              <>
                <strong>{data.offerPrice} د.أ</strong>
                <span class="was">{data.price} د.أ</span>
              </>
            ) : (
              <strong>{data.price} د.أ</strong>
            )
          }
        </p>
        {data.offerNote && <p class="note">{data.offerNote}</p>}
        <p class="acts">
          <a class="btn btn-primary" href="#order">اطلبها</a>
          {data.sampleHref && <a class="btn" href={data.sampleHref}>شوف نموذج مجاني</a>}
        </p>
      </div>

      {
        data.includes.length > 0 && (
          <div class="panel">
            <h2>شو جواها</h2>
            <ul class="items">{data.includes.map((it) => <li>{it}</li>)}</ul>
          </div>
        )
      }

      {
        members.length > 0 && (
          <div class="panel">
            <h2>الحزمة بتضم</h2>
            <ul class="items">
              {members.map((m) => (
                <li><a href={`/store/${m.id}/`}>{m.data.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }

      <Prose><Content /></Prose>
    </div>
  </section>

  <section class="order" id="order">
    <div class="wrap">
      <h2>اطلب المادة</h2>
      <p class="sub">
        عبّي النموذج، بيوصلني الطلب، وبعد ما نأكّد الحوالة بابعتلك كود يفتحلك المادة.
      </p>

      <form class="form" id="order-form" novalidate>
        <input type="hidden" name="product" value={product.id} />
        <label>
          <span>الاسم</span>
          <input name="name" type="text" required maxlength="80" autocomplete="name" />
        </label>
        <label>
          <span>الإيميل</span>
          <input name="email" type="email" required maxlength="254" autocomplete="email" />
        </label>
        <label>
          <span>رقم الموبايل <em>(اختياري)</em></span>
          <input name="phone" type="tel" maxlength="40" autocomplete="tel" />
        </label>
        <label class="full">
          <span>ملاحظة <em>(اختياري)</em></span>
          <textarea name="note" rows="2" maxlength="500"></textarea>
        </label>
        <label class="check full">
          <input name="newsletter" type="checkbox" />
          <span>ضمّني بالنشرة البريدية كذلك</span>
        </label>
        <div class="full">
          <button class="btn btn-primary" type="submit" id="order-btn">ابعت الطلب</button>
          {wa && (
            <a class="btn" href={`https://wa.me/${wa}?text=${waText}`} target="_blank" rel="noopener">
              أو راسلني واتساب
            </a>
          )}
        </div>
        <p class="msg full" id="order-msg" role="status" aria-live="polite"></p>
      </form>

      {
        pay && (
          <div class="panel pay">
            <h2>طرق الدفع</h2>
            <p class="paytext">{pay}</p>
          </div>
        )
      }

      <p class="have">
        عندك كود أصلاً؟ <a href="/pro/unlock/">افتحه من هون</a>.
      </p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const form = document.getElementById('order-form');
    const btn = document.getElementById('order-btn');
    const msg = document.getElementById('order-msg');
    if (!form || !btn || !msg) return;

    const errors = {
      name: 'اكتب اسمك.',
      email: 'الإيميل مش مكتوب صح.',
      products: 'صار خطأ بتحديد المادة. حدّث الصفحة وجرّب من جديد.',
      rate: 'بعتت طلبات كثيرة بوقت قصير. استنى شوي وجرّب كمان مرة.',
      origin: 'صار خطأ بالطلب. حدّث الصفحة وجرّب من جديد.',
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.textContent = '';
      msg.className = 'msg full';
      const fd = new FormData(form);
      btn.disabled = true;
      try {
        const res = await fetch('/api/pro/order', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: String(fd.get('name') || ''),
            email: String(fd.get('email') || ''),
            phone: String(fd.get('phone') || ''),
            note: String(fd.get('note') || ''),
            newsletter: fd.get('newsletter') === 'on',
            products: [String(fd.get('product') || '')],
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (data && data.ok) {
          form.reset();
          msg.textContent = 'وصلني طلبك (رقم ' + (data.ref || '—') + '). بتوصلك رسالة مني بتفاصيل الدفع والكود.';
          msg.className = 'msg full ok';
          btn.disabled = false;
          return;
        }
        msg.textContent = errors[data && data.error] || 'ما زبطت. جرّب من جديد.';
        msg.className = 'msg full bad';
      } catch (err) {
        msg.textContent = 'ما قدرنا نوصل للسيرفر. شيك على النت وجرّب كمان مرة.';
        msg.className = 'msg full bad';
      }
      btn.disabled = false;
    });
  })();
</script>

<style>
  .crumbs { padding-top: 26px; font-size: 13px; color: var(--faint); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs a:hover { color: var(--orange); }
  .crumbs .now { color: var(--ink); }

  .hero { padding-block: 26px 20px; }
  .hero h1 { margin-top: 10px; }
  .intro { max-width: 62ch; color: var(--muted); margin-top: 12px; }

  .pricebox { margin-top: 26px; }
  .price { margin: 0; font-size: 30px; }
  .was { font-size: 17px; color: var(--faint); text-decoration: line-through; margin-inline-start: 10px; }
  .note { margin: 6px 0 0; font-size: 13px; color: var(--orange); }
  .acts { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }

  .panel {
    background: var(--surface);
    border: 1px solid var(--orange-line);
    border-radius: var(--r-xl);
    padding: 24px 22px;
    margin-top: 26px;
    max-width: 720px;
    display: grid;
    gap: 12px;
  }
  .panel h2 { font-size: 18px; margin: 0; }
  .paytext { margin: 0; color: var(--muted); white-space: pre-line; }

  .items { display: grid; gap: 10px; padding-inline-start: 0; list-style: none; margin: 0; }
  .items li { position: relative; padding-inline-start: 22px; color: var(--muted); }
  .items li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 9px;
    width: 9px;
    height: 9px;
    background: var(--orange);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }

  .order { padding-block: 30px 70px; }
  .order h2 { font-size: 22px; }
  .sub { color: var(--muted); max-width: 60ch; }

  .form {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 720px;
    margin-top: 22px;
  }
  .form label { display: grid; gap: 6px; font-size: 14px; }
  .form label em { color: var(--faint); font-style: normal; }
  .form .full { grid-column: 1 / -1; }
  .form input[type='text'],
  .form input[type='email'],
  .form input[type='tel'],
  .form textarea {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-md);
    padding: 12px 14px;
    color: var(--ink);
    font: inherit;
    min-height: 46px;
  }
  .form .check { display: flex; align-items: center; gap: 9px; }
  .form .check input { width: 17px; height: 17px; }

  .msg { font-size: 14px; margin: 0; min-height: 20px; }
  .msg.bad { color: #ff8f6b; }
  .msg.ok { color: #5ad19a; }

  .have { margin-top: 30px; font-size: 14px; color: var(--faint); }

  @media (max-width: 620px) {
    .form { grid-template-columns: 1fr; }
  }
</style>
