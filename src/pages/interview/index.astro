---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getSite } from '../../lib/site';
import { linkGlossary } from '../../lib/glossary';

const site = await getSite();

const levelOrder: Record<string, number> = { 'مبتدئ': 0, 'متوسط': 1, 'متقدّم': 2 };
// ترتيب المجالات: كل مجال كتلة كاملة (بمستوياتها الثلاثة: مبتدئ ← متوسط ← متقدّم) قبل الانتقال للمجال يلي بعده
const domainOrder: Record<string, number> = {
  'أساسيات': 0,
  'سلوكي': 1,
  'إدارة الاختبار': 2,
  'API': 3,
  'أتمتة': 4,
};
const domainRank = (d: string) => domainOrder[d] ?? 99;

// سؤال "عندك أسئلة إلنا؟" ثابت دايمًا آخر سؤال بالمقابلة، بغض النظر عن ترتيب/فلترة المواضيع
// (لأنه خاتمة طبيعية لأي مقابلة عمل، مش سؤال تقني عادي)
const CLOSING_QUESTION_ID = 'questions-for-interviewer';

const allQuestions = (await getCollection('questions')).filter((q) => !q.data.draft);

const glossaryTerms = (await getCollection('glossary'))
  .filter((t) => !t.data.draft)
  .map((t) => ({ slug: t.id, labels: [t.data.title, ...t.data.aliases] }));

const questions = await Promise.all(
  allQuestions
    .slice()
    .sort((a, b) => {
      // السؤال الختامي دايمًا بالآخر
      const aClosing = a.id === CLOSING_QUESTION_ID;
      const bClosing = b.id === CLOSING_QUESTION_ID;
      if (aClosing !== bClosing) return aClosing ? 1 : -1;
      // المجال أولًا (كل مجال كتلة كاملة)، وبعدين المستوى داخل نفس المجال
      const dv = domainRank(a.data.domain) - domainRank(b.data.domain);
      if (dv !== 0) return dv;
      const lv = levelOrder[a.data.level] - levelOrder[b.data.level];
      if (lv !== 0) return lv;
      return a.data.title.localeCompare(b.data.title, 'ar');
    })
    .map(async (q) => {
      const { Content } = await render(q);
      void Content;
      const fullHtml = (q as any).rendered?.html ?? '';
      return {
        id: q.id,
        t: q.data.title,
        a: q.data.shortAnswer,
        full: linkGlossary(fullHtml, glossaryTerms, q.id),
        d: q.data.domain,
        lvl: q.data.level,
      };
    }),
);

const domainCounts = allQuestions.reduce<Record<string, number>>((acc, q) => {
  acc[q.data.domain] = (acc[q.data.domain] ?? 0) + 1;
  return acc;
}, {});
const domains = Object.entries(domainCounts).sort(
  (a, b) => domainRank(a[0]) - domainRank(b[0]),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allQuestions.map((q) => ({
    '@type': 'Question',
    name: q.data.title,
    acceptedAnswer: { '@type': 'Answer', text: q.data.shortAnswer },
    url: `${site.url}/questions/${q.id}/`,
  })),
};
---
<Base
  title="مقابلة عمل — QA"
  description={`محاكي مقابلة عمل اختبار برمجيات — ${questions.length} سؤال حقيقي موزّعة على أساسيات الاختبار والأتمتة وAPI وأسئلة سلوكية، مع جواب نموذجي لكل سؤال.`}
  jsonLd={jsonLd}
>
  <!-- ============ 1) صفحة الشرح ============ -->
  <section class="page-head dots" id="intro">
    <div class="wrap">
      <h1>مقابلة عمل — QA</h1>
      <p class="lead">
        مجموعة أسئلة حقيقية بتتسأل بمقابلات اختبار البرمجيات، موزّعة على أساسيات الاختبار وأسئلة سلوكية وأتمتة وAPI. جاوب بنفسك الأول، ثم قارن إجابتك بالجواب النموذجي وقيّمها.
      </p>

      <p class="topics-lead">اختَر المواضيع اللي بدك تتدرّب عليها (كلها مفعّلة افتراضيًا):</p>
      <div class="topics-grid" id="topics-grid">
        {domains.map(([d, n]) => (
          <button type="button" class="topic-chip active" data-topic={d} data-count={n}>
            <span class="box">✓</span><span>{d}</span><span class="cnt">({n})</span>
          </button>
        ))}
      </div>
      <div class="quick-actions">
        <button type="button" id="topics-all">✓ اختر الكل</button>
        <button type="button" id="topics-manual">👤 مانيوال بس (بدون أتمتة/API)</button>
      </div>
      <p class="topics-warn" id="topics-warn" hidden>لازم تختار موضوع واحد على الأقل</p>

      <button class="btn btn-primary start-btn" type="button" id="start-btn">
        <Icon name="play" size={17} class="flip" /> ابدأ مقابلة (<span id="start-count">{questions.length}</span> سؤال)
      </button>

      <div class="stat-strip">
        <div class="s"><b>{questions.length}</b><span>سؤال بالبنك</span></div>
        <div class="s"><b>بالتدريج</b><span>مبتدئ ← متقدّم</span></div>
        <div class="s"><b>45 ثانية</b><span>لكل سؤال</span></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="below-hero">
        <b>كيف تشتغل المقابلة؟</b> بتشوف سؤال واحد بكل مرة، بترتيب متدرّج من الأساسيات للمتقدّم، وعندك 45 ثانية تفكّر فيها متل مقابلة حقيقية. جاوب بصوت عالي أو براسك، وبعدين اضغط «اعرف الجواب» — الإجابة بتطلع تحت نفس السؤال. قارن جوابك فيها واختَر «إجابتي صحيحة» أو «تحتاج مراجعة» قبل الانتقال. لو خلص الوقت قبل ما تكشف الجواب، بيظهر تلقائياً وبيتسجّل «لم أجب». تقدر تنهي المقابلة بأي لحظة، وبالنهاية فيك تشارك نتيجتك.
    </div>
  </div>

  <!-- ============ 2) وضع المقابلة ============ -->
  <section class="wrap interview-wrap" id="interview" hidden>
    <div class="interview-shell">
    <div class="interview-top">
      <span class="qnum" id="q-num">1 / {questions.length}</span>
      <div class="progtrack"><i id="prog-fill" style="width:0%"></i></div>
      <div class="timer-ring" id="timer-ring">
        <svg viewBox="0 0 40 40">
          <circle class="track" cx="20" cy="20" r="16"></circle>
          <circle class="fill" id="timer-fill" cx="20" cy="20" r="16" stroke-dasharray="100.5" stroke-dashoffset="0"></circle>
        </svg>
        <div class="timer-num" id="timer-num">45</div>
      </div>
      <span class="timer-status" id="timer-status" aria-live="polite">وقت التفكير</span>
      <button class="btn btn-ghost btn-sm end-btn" type="button" id="end-btn">إنهاء المقابلة</button>
    </div>

    <div class="interview-stage">
      <div class="interviewer-scene" aria-hidden="true">
        <img src="/images/interview/office-aqsa.webp" width="1200" height="900" alt="" decoding="async" />
      </div>
      <div class="interview-content">
    <div class="qcard">
      <p class="interviewer-label" id="interviewer-label">المُحاوِر يسألك الآن</p>
      <div class="qmeta">
        <span class="badge badge-outline" id="q-cat"></span>
        <span class="badge" id="q-level"></span>
      </div>
      <h2 class="qtext" id="q-text" tabindex="-1"></h2>
    </div>

    <div class="answer-zone">
      <p class="thinking-hint" id="thinking-hint">جاوب بصوت عالٍ، ثم قارن إجابتك بالإجابة النموذجية.</p>
      <button class="reveal-btn" type="button" id="reveal-btn">
        اعرف الجواب <Icon name="check" size={16} />
      </button>
      <div class="answer-box" id="answer-box" hidden>
        <h3 class="lbl" tabindex="-1" id="answer-heading">الإجابة النموذجية</h3>
        <p id="answer-text"></p>
        <details class="answer-details" id="answer-details"><summary>اقرأ الشرح المفصّل</summary><div class="full-answer" id="full-answer"></div></details>
      </div>
      <p class="timeout-note" id="timeout-note" hidden>⏱ خلص الوقت — سُجّل السؤال «لم أجب». تقدر تراجع الجواب وتكمل.</p>
      <div class="self-assessment" id="self-assessment" hidden>
        <h2>قارن إجابتك ثم قيّمها بنفسك</h2>
        <p>قارنها بالجواب اللي فوق، واختَر تقييمًا صادقًا لنفسك.</p>
        <div class="assessment-choices">
          <button class="assessment-choice good" type="button" id="rate-known">✓ إجابتي صحيحة</button>
          <button class="assessment-choice review" type="button" id="rate-review">↻ تحتاج مراجعة</button>
        </div>
        <p class="assessment-feedback" id="assessment-feedback" aria-live="polite">اختر تقييمك للمتابعة.</p>
      </div>
      <button class="btn btn-primary next-btn" type="button" id="next-btn" disabled hidden>
        السؤال التالي <Icon name="arrow" size={16} />
      </button>
    </div>
      </div>
    </div>
    </div>
  </section>

  <!-- ============ 3) شاشة انتهاء المقابلة ============ -->
  <section class="wrap done-wrap" id="finished" hidden>
    <div class="done">
      <div class="ic">🎉</div>
      <h2>خلصت المقابلة!</h2>
      <p id="done-sub"></p>

      <div class="score-row">
        <div class="score-pill ok"><b id="score-known">0</b><span>إجابتي صحيحة</span></div>
        <div class="score-pill miss"><b id="score-missed">0</b><span>تحتاج مراجعة</span></div>
        <div class="score-pill"><b id="score-unanswered">0</b><span>لم أجب</span></div>
        <div class="score-pill"><b id="score-pct">0%</b><span>من كل بنك الأسئلة</span></div>
      </div>
      <p class="scope-note">* التقييم ذاتي، والنسبة محسوبة من إجمالي الأسئلة المختارة للمقابلة.</p>

      <div class="done-actions">
        <button class="btn btn-primary" type="button" id="share-btn">📤 شارك نتيجتك</button>
        <button class="btn btn-ghost" type="button" id="restart-btn">↻ ابدأ مقابلة جديدة</button>
      </div>
    </div>
  </section>

  <canvas id="share-canvas" width="1080" height="1080" hidden></canvas>

  <div class="toast-layer" id="toast-layer" aria-live="polite"></div>

  <script type="application/json" id="interview-data" set:html={JSON.stringify(questions)} />
  <script type="application/json" id="site-data" set:html={JSON.stringify({ url: site.url, logoTop: 'Testing', logoBottom: 'بالعربي' })} />
</Base>

<style>
  .page-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 64px 48px; text-align: center; }
  .page-head h1 { margin-bottom: 14px; }
  .page-head .lead { max-width: 60ch; margin-inline: auto; line-height: 1.9; }

  .topics-lead { color: var(--muted); font-size: 14px; margin: 22px 0 14px; }
  .topics-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 14px; }
  .topic-chip {
    display: flex; align-items: center; gap: 8px; cursor: pointer; user-select: none;
    font: inherit; color: var(--ink-2);
    background: rgba(255,255,255,.05); border: 1.5px solid var(--line-strong); border-radius: 12px;
    padding: 10px 16px; font-size: 14px; font-weight: 600; transition: all .15s ease;
  }
  .topic-chip.active { background: rgba(56,189,248,.14); border-color: var(--cyan); color: var(--ink); }
  .topic-chip .box {
    width: 17px; height: 17px; border-radius: 5px; border: 2px solid var(--line-strong);
    display: flex; align-items: center; justify-content: center; flex: none; font-size: 11px;
  }
  .topic-chip.active .box { background: var(--cyan); border-color: var(--cyan); color: #0a1628; }
  .topic-chip .cnt { font-size: 12px; color: var(--muted); }
  .topic-chip.active .cnt { color: var(--ink-2); }

  .quick-actions { display: flex; justify-content: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
  .quick-actions button {
    font: inherit; font-size: 12.5px; font-weight: 600; color: var(--cyan); background: transparent;
    border: 1px solid var(--line-strong); border-radius: 8px; padding: 6px 14px; cursor: pointer;
  }
  .topics-warn { font-size: 12.5px; color: #f65b5b; margin: 0 0 14px; }

  .start-btn { margin: 10px auto 32px; display: inline-flex; }
  .start-btn:disabled { opacity: .45; cursor: not-allowed; }

  .stat-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 480px; margin-inline: auto; }
  .stat-strip .s { background: rgba(255,255,255,.05); border: 1px solid var(--line); border-radius: 10px; padding: 14px 8px; }
  .stat-strip .s b { display: block; font-size: 17px; font-weight: 700; color: #fff; }
  .stat-strip .s span { font-size: 12px; color: var(--muted); }

  .below-hero {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: 22px 24px; font-size: 15px; color: var(--ink-2); line-height: 1.9; margin-block: 32px;
    max-width: var(--read); margin-inline: auto;
  }
  .below-hero b { color: var(--ink); }

  .interview-wrap { max-width: 760px; padding-block: 48px 60px; }
  .interview-top { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; flex-wrap: wrap; }
  .qnum {
    font-size: 14px; font-weight: 600; color: var(--muted); background: var(--surface-2, var(--surface));
    border: 1px solid var(--line); border-radius: 8px; padding: 6px 12px; flex: none;
    font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate;
  }
  .progtrack { flex: 1; min-width: 120px; height: 6px; background: var(--line); border-radius: 99px; overflow: hidden; }
  .progtrack i { display: block; height: 100%; background: var(--orange); border-radius: 99px; transition: width .3s; }
  .end-btn { flex: none; }

  .timer-ring { position: relative; width: 38px; height: 38px; flex: none; }
  .timer-ring svg { transform: rotate(-90deg); width: 38px; height: 38px; }
  .timer-ring circle { fill: none; stroke-width: 4; }
  .timer-ring .track { stroke: var(--line); }
  .timer-ring .fill { stroke: var(--cyan); stroke-linecap: round; transition: stroke-dashoffset 1s linear, stroke .3s; }
  .timer-ring.warn .fill { stroke: var(--orange); }
  .timer-ring.danger .fill { stroke: var(--danger, #f65b5b); }
  .timer-num {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; font-family: 'IBM Plex Mono', monospace; color: var(--ink);
    direction: ltr; unicode-bidi: isolate;
  }

  .toast-layer {
    position: fixed; top: 20px; right: 20px; left: 20px; display: flex; justify-content: center;
    z-index: 200; pointer-events: none;
  }
  :global(.toast) {
    display: flex; align-items: center; gap: 10px;
    background: var(--surface); border: 1px solid var(--danger, #f65b5b);
    border-inline-start: 4px solid var(--danger, #f65b5b);
    border-radius: var(--r-md); padding: 14px 18px; box-shadow: 0 10px 30px rgba(0,0,0,.35);
    font-size: 14px; font-weight: 600; color: var(--ink);
    max-width: 420px; pointer-events: auto;
    animation: toast-in .35s ease-out, toast-out .35s ease-in 2.65s forwards;
  }
  :global(.toast .ic) { flex: none; font-size: 18px; }
  :global(.toast b) { color: var(--danger, #f65b5b); }

  @keyframes toast-in {
    from { opacity: 0; transform: translateY(-16px) scale(.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes toast-out {
    from { opacity: 1; transform: translateY(0) scale(1); }
    to { opacity: 0; transform: translateY(-10px) scale(.98); }
  }

  @media (max-width: 480px) {
    .toast-layer { top: 12px; }
  }

  .qcard { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px 30px; margin-bottom: 18px; }
  .qmeta { display: flex; gap: 8px; margin-bottom: 16px; }
  .qtext { font-size: 21px; font-weight: 700; margin: 0; line-height: 1.75; }

  .reveal-btn {
    width: 100%; font: inherit; font-size: 16px; font-weight: 700; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--surface); color: var(--orange); border: 1.5px dashed var(--line-strong);
    border-radius: var(--r-md); padding: 16px; margin-bottom: 16px;
  }
  .reveal-btn:hover { background: var(--orange-soft, rgba(246,130,59,.08)); }
  .reveal-btn[hidden], .next-btn[hidden] { display: none; }

  .answer-box {
    background: var(--surface); border: 1px solid var(--line); border-inline-start: 3px solid var(--cyan);
    border-radius: var(--r-md); padding: 24px 26px; margin-bottom: 16px;
  }
  .answer-box .lbl { font-size: 12.5px; font-weight: 700; color: var(--cyan); margin-bottom: 8px; }
  .answer-box p { margin: 0; font-size: 16.5px; line-height: 1.9; color: var(--ink-2); }
  .timeout-note { padding: 12px 16px; background: rgba(246,130,59,.1); border: 1px solid rgba(246,130,59,.35); border-radius: var(--r-md); color: var(--ink-2); font-size: 14px; margin: 0 0 16px; }
  .self-assessment { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); padding: 22px 24px; margin-bottom: 16px; }
  .self-assessment h2 { font-size: 17px; margin: 0 0 4px; }
  .self-assessment p { font-size: 13.5px; color: var(--muted); margin: 0 0 16px; }
  .assessment-choices { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; }
  .assessment-choice { font: inherit; font-size: 14px; font-weight: 700; color: var(--ink); background: rgba(255,255,255,.05); border: 1px solid var(--line-strong); border-radius: 10px; padding: 13px; cursor: pointer; }
  .assessment-choice.good.selected { color: #34d399; border-color: #34d399; background: rgba(52,211,153,.13); }
  .assessment-choice.review.selected { color: #f89a9a; border-color: #f65b5b; background: rgba(246,91,91,.13); }
  .assessment-choice:disabled { cursor: default; }
  .self-assessment .assessment-feedback { margin: 14px 0 0; }

  .full-answer { margin-top: 20px; padding-top: 20px; border-top: 1px dashed var(--line); }
  .full-answer :global(p) { margin: 0 0 12px; font-size: 15.5px; line-height: 1.9; color: var(--ink-2); }
  .full-answer :global(ul), .full-answer :global(ol) { margin: 0 0 12px; padding-inline-start: 22px; display: grid; gap: 8px; }
  .full-answer :global(li) { font-size: 15.5px; line-height: 1.85; color: var(--ink-2); }
  .full-answer :global(strong) { color: var(--ink); }
  .full-answer :global(a) { color: var(--cyan); }
  .full-answer :global(code) { font-family: 'IBM Plex Mono', monospace; font-size: .9em; background: rgba(255,255,255,.06); padding: 1px 6px; border-radius: 5px; }

  .next-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .next-btn:disabled { opacity: .45; cursor: not-allowed; }
  :global(.flip) { transform: scaleX(-1); }

  .done-wrap { max-width: 640px; padding-block: 40px 64px; }
  .done { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 48px 30px; text-align: center; }
  .done .ic { font-size: 40px; margin-bottom: 10px; }
  .done h2 { margin: 0 0 8px; }
  .done p { color: var(--muted); margin: 0 0 24px; }

  .score-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 4px 0 28px; }
  .score-pill { background: rgba(255,255,255,.05); border: 1px solid var(--line); border-radius: 12px; padding: 14px 10px; }
  .score-pill b { display: block; font-size: 22px; font-weight: 800; direction: ltr; unicode-bidi: isolate; }
  .score-pill span { font-size: 12.5px; color: var(--muted); }
  .score-pill.ok b { color: var(--ok, #34d399); }
  .score-pill.miss b { color: var(--danger, #f65b5b); }
  .score-pill:nth-child(3) b { color: var(--muted); }
  .scope-note { font-size: 12.5px; color: var(--muted); margin: -14px 0 26px; }

  .done-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 480px) {
    .stat-strip { grid-template-columns: 1fr 1fr; }
    .qcard { padding: 24px 20px; }
    .qtext { font-size: 18px; }
    .self-assessment { padding: 20px; }
    .assessment-choices { grid-template-columns: 1fr; }
    .score-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Interview room: separate regions keep every control away from the portrait. */
  .interview-wrap { max-width: 1320px; padding-block: 28px 48px; }
  .interview-shell { --site-header-h: 80px; --interview-toolbar-h: 72px; --ink: #edf4ff; --ink-2: #c3d1e5; --muted: #9fb2cc; --surface: #0b2137; --line: #244359; --line-strong: #38607a; color: var(--ink); background: #081b2e; border: 1px solid #38607a; border-radius: 20px; }
  .interview-shell [hidden] { display: none !important; }
  .interview-top { position: sticky; top: var(--site-header-h); z-index: 20; padding: 16px 24px; margin: 0; background: #091d30; border-bottom: 1px solid #38607a; border-radius: 19px 19px 0 0; flex-wrap: nowrap; }
  .interview-top .progtrack { min-width: 24px; }
  .timer-status { font-size: 12px; color: #9fb2cc; white-space: nowrap; }
  .interview-stage { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); direction: ltr; align-items: start; }
  .interviewer-scene { position: sticky; top: calc(var(--site-header-h) + var(--interview-toolbar-h) + 12px); align-self: start; margin: 12px; height: auto; aspect-ratio: 4 / 3; max-height: calc(100svh - var(--site-header-h) - var(--interview-toolbar-h) - 24px); overflow: hidden; border-radius: 12px; background: #0a1929; }
  .interviewer-scene img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .interview-content { direction: rtl; padding: 28px; min-width: 0; }
  .interviewer-label { font-size: 15px; color: #55d1fa; margin: 0 0 12px; font-weight: 700; }
  .qcard { background: transparent; border: 0; border-radius: 0; padding: 0 0 22px; margin: 0 0 22px; border-bottom: 1px solid #244359; }
  .qmeta { margin-bottom: 20px; flex-wrap: wrap; }
  .qtext { font-size: clamp(20px, 2vw, 27px); line-height: 1.7; overflow-wrap: anywhere; color: #edf4ff; }
  .qtext:focus, .answer-box .lbl:focus { outline: none; }
  .thinking-hint { color: #9fb2cc; font-size: 14px; line-height: 1.9; margin: 0 0 24px; }
  .reveal-btn { background: #ff852b; color: #071c30; border: 1px solid #ff852b; border-radius: 10px; min-height: 50px; margin: 0; }
  .reveal-btn:hover { background: #ff9c51; }
  .answer-box { background: #0b243b; border: 1px solid #287697; padding: 20px; animation: answer-in .25s ease-out; }
  .answer-box .lbl { font-size: 17px; margin: 0 0 14px; padding-bottom: 12px; border-bottom: 1px solid #244359; }
  .answer-box p { font-size: 16px; white-space: pre-line; overflow-wrap: anywhere; }
  .answer-details { margin-top: 16px; border-top: 1px solid #244359; padding-top: 12px; }
  .answer-details summary { cursor: pointer; color: #55d1fa; font-size: 14px; padding: 6px 0; }
  .full-answer { margin-top: 12px; padding-top: 0; border: 0; overflow-wrap: anywhere; }
  .full-answer :global(pre) { overflow-x: auto; max-width: 100%; }
  .full-answer :global(table) { display: block; overflow-x: auto; max-width: 100%; }
  .self-assessment { padding: 4px 0; border: 0; background: transparent; text-align: center; }
  .self-assessment h2 { font-size: 16px; color: #edf4ff; }
  .self-assessment p { margin: 8px 0 14px; }
  .assessment-choice { min-height: 48px; padding: 10px 8px; }
  .assessment-choice.good { color: #34d399; border-color: #34d399; }
  .assessment-choice.review, .assessment-choice.review.selected { color: #ff963e; border-color: #ff963e; }
  .assessment-choice.review.selected { background: rgba(255,150,62,.15); }
  .assessment-choice:disabled:not(.selected) { opacity: .45; }
  .next-btn { min-height: 48px; }
  .next-btn:disabled { background: #2c465f; border-color: #2c465f; color: #9fb2cc; opacity: 1; }
  @keyframes answer-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 760px) {
    .interview-wrap { padding-block: 16px 32px; }
    .interview-shell { border-radius: 14px; }
    .interview-top { padding: 10px; gap: 8px; border-radius: 13px 13px 0 0; }
    .qnum { padding: 4px 6px; font-size: 12px; }
    .end-btn { font-size: 11px; padding: 8px; }
    .timer-status { display: none; }
    .interview-stage { display: block; }
    .interviewer-scene { z-index: 10; margin: 0; top: calc(var(--site-header-h) + var(--interview-toolbar-h)); height: clamp(100px, 25svh, 210px); aspect-ratio: auto; max-height: none; padding-block: 8px; border-radius: 0; border-bottom: 1px solid #244359; background: #081b2e; }
    .interviewer-scene img { top: 8px; height: calc(100% - 16px); }
    .interview-content { padding: 20px 16px; }
    .qcard { padding-bottom: 16px; margin-bottom: 16px; }
    .qmeta { margin-bottom: 12px; }
    .qtext { font-size: 20px; }
    .answer-box { padding: 16px; }
    .assessment-choices { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .assessment-choice { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .answer-box { animation: none; } .progtrack i, .timer-ring .fill { transition: none; } }

</style>

<script>
  type Q = { id: string; t: string; a: string; full: string; d: string; lvl: string };
  type SiteInfo = { url: string; logoTop: string; logoBottom: string };

  const CLOSING_QUESTION_ID = 'questions-for-interviewer';

  const raw = document.getElementById('interview-data')?.textContent ?? '[]';
  const ALL: Q[] = JSON.parse(raw);
  const SITE: SiteInfo = JSON.parse(document.getElementById('site-data')?.textContent ?? '{}');

  // ORDERED = مجموعة الأسئلة الفعّالة بعد فلترة المواضيع المختارة (يُعاد حسابها كل ما المستخدم يغيّر الاختيار)
  let ORDERED: Q[] = ALL.slice();

  const TIME_PER_Q = 45;
  const CIRC = 2 * Math.PI * 16; // r=16

  let idx = 0;
  let answered = 0;
  let known = 0;
  let missed = 0;
  let unanswered = 0;
  let timeLeft = TIME_PER_Q;
  let timerId: ReturnType<typeof setInterval> | null = null;
  let questionState: 'thinking' | 'awaiting-rating' | 'rated' | 'timed-out' = 'thinking';

  const $ = (id: string) => document.getElementById(id);
  const introEl = document.getElementById('intro');
  const belowHero = document.querySelector<HTMLElement>('.below-hero')?.closest('.wrap') ?? null;
  const interviewEl = $('interview');
  const finishedEl = $('finished');

  // Keep the portrait and timer below the real header height, including mobile menus.
  const interviewShell = document.querySelector<HTMLElement>('.interview-shell');
  const interviewToolbar = document.querySelector<HTMLElement>('.interview-top');
  const siteHeader = document.querySelector<HTMLElement>('.site-head');
  function updateStickyOffsets() {
    const headerHeight = siteHeader?.getBoundingClientRect().height ?? 0;
    const toolbarHeight = interviewToolbar?.getBoundingClientRect().height ?? 0;
    interviewShell?.style.setProperty('--site-header-h', `${Math.ceil(headerHeight)}px`);
    if (toolbarHeight > 0) interviewShell?.style.setProperty('--interview-toolbar-h', `${Math.ceil(toolbarHeight)}px`);
  }
  if ('ResizeObserver' in window) {
    const stickyObserver = new ResizeObserver(updateStickyOffsets);
    if (siteHeader) stickyObserver.observe(siteHeader);
    if (interviewToolbar) stickyObserver.observe(interviewToolbar);
  } else {
    window.addEventListener('resize', updateStickyOffsets, { passive: true });
  }

  // ===== اختيار المواضيع قبل بدء المقابلة =====
  const topicChips = Array.from(document.querySelectorAll<HTMLButtonElement>('.topic-chip'));
  const startBtn = $('start-btn') as HTMLButtonElement | null;
  const startCountEl = $('start-count');
  const topicsWarnEl = $('topics-warn');

  function getSelectedTopics(): Set<string> {
    const set = new Set<string>();
    topicChips.forEach((chip) => {
      if (chip.classList.contains('active') && chip.dataset.topic) set.add(chip.dataset.topic);
    });
    return set;
  }

  function recomputeOrdered() {
    const selected = getSelectedTopics();
    // السؤال الختامي "عندك أسئلة إلنا؟" يظل دايمًا ضمن المقابلة كآخر سؤال، بغض النظر عن اختيار المواضيع
    const filtered = ALL.filter((q) => q.id === CLOSING_QUESTION_ID || selected.has(q.d));
    // نضمن إن السؤال الختامي (إذا موجود بالبيانات) يضل بالآخر تمامًا بعد الفلترة
    const closingIdx = filtered.findIndex((q) => q.id === CLOSING_QUESTION_ID);
    if (closingIdx !== -1 && closingIdx !== filtered.length - 1) {
      const [closing] = filtered.splice(closingIdx, 1);
      filtered.push(closing);
    }
    ORDERED = filtered;
    if (startCountEl) startCountEl.textContent = String(ORDERED.length);
    const anySelected = selected.size > 0;
    if (startBtn) startBtn.disabled = !anySelected;
    if (topicsWarnEl) topicsWarnEl.hidden = anySelected;
  }

  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('active');
      const box = chip.querySelector('.box');
      if (box) box.textContent = chip.classList.contains('active') ? '✓' : '';
      recomputeOrdered();
    });
  });

  $('topics-all')?.addEventListener('click', () => {
    topicChips.forEach((chip) => {
      chip.classList.add('active');
      const box = chip.querySelector('.box');
      if (box) box.textContent = '✓';
    });
    recomputeOrdered();
  });

  $('topics-manual')?.addEventListener('click', () => {
    topicChips.forEach((chip) => {
      const isAuto = chip.dataset.topic === 'أتمتة' || chip.dataset.topic === 'API';
      chip.classList.toggle('active', !isAuto);
      const box = chip.querySelector('.box');
      if (box) box.textContent = !isAuto ? '✓' : '';
    });
    recomputeOrdered();
  });

  recomputeOrdered();

  function stopTimer() {
    if (timerId !== null) {
      clearInterval(timerId);
      timerId = null;
    }
  }

  function updateTimerVisual() {
    const ring = $('timer-ring');
    const fill = $('timer-fill');
    const num = $('timer-num');
    if (num) num.textContent = String(timeLeft);
    if (fill) fill.setAttribute('stroke-dashoffset', String(CIRC - (timeLeft / TIME_PER_Q) * CIRC));
    if (ring) {
      ring.classList.toggle('warn', timeLeft <= 15 && timeLeft > 5);
      ring.classList.toggle('danger', timeLeft <= 5);
    }
  }

  function startTimer() {
    stopTimer();
    timeLeft = TIME_PER_Q;
    questionState = 'thinking';
    updateTimerVisual();
    timerId = setInterval(() => {
      timeLeft--;
      updateTimerVisual();
      if (timeLeft <= 0) {
        stopTimer();
        questionState = 'timed-out';
        unanswered++;
        answered++;
        revealAnswer();
        showTimeoutToast();
      }
    }, 1000);
  }

  function showTimeoutToast() {
    const layer = $('toast-layer');
    if (!layer) return;
    layer.innerHTML = '';
    const t = document.createElement('div');
    t.className = 'toast';
    t.innerHTML = '<span class="ic">⏱</span><span>خلص الوقت — هاي بتتحسب <b>"لم أجب"</b>، بس تقدر تراجع الجواب.</span>';
    layer.appendChild(t);
    setTimeout(() => { t.remove(); }, 3200);
  }

  function revealAnswer() {
    stopTimer();
    const status = $('timer-status'); if (status) status.textContent = 'توقف المؤقّت';
    const hint = $('thinking-hint'); if (hint) hint.hidden = true;
    const label = $('interviewer-label'); if (label) label.textContent = 'راجع إجابتك';
    const answerBox = $('answer-box') as HTMLElement | null;
    const revealBtn = $('reveal-btn') as HTMLElement | null;
    const nextBtn = $('next-btn') as HTMLButtonElement | null;
    if (answerBox) answerBox.hidden = false;
    if (revealBtn) revealBtn.hidden = true;
    if (questionState === 'timed-out') {
      const note = $('timeout-note'); if (note) note.hidden = false;
      if (nextBtn) nextBtn.disabled = false;
    } else {
      questionState = 'awaiting-rating';
      const assessment = $('self-assessment'); if (assessment) assessment.hidden = false;
    }
    if (nextBtn) nextBtn.hidden = false;
    $('answer-heading')?.focus({ preventScroll: true });
  }

  function rateAnswer(rating: 'known' | 'review') {
    if (questionState !== 'awaiting-rating') return;
    questionState = 'rated';
    answered++;
    if (rating === 'known') known++; else missed++;
    const knownBtn = $('rate-known') as HTMLButtonElement | null;
    const reviewBtn = $('rate-review') as HTMLButtonElement | null;
    if (knownBtn) { knownBtn.disabled = true; knownBtn.classList.toggle('selected', rating === 'known'); }
    if (reviewBtn) { reviewBtn.disabled = true; reviewBtn.classList.toggle('selected', rating === 'review'); }
    const feedback = $('assessment-feedback');
    if (feedback) feedback.textContent = rating === 'known' ? '✓ تم تسجيلها ضمن إجاباتك الصحيحة.' : '↻ تم تسجيلها للمراجعة.';
    const nextBtn = $('next-btn') as HTMLButtonElement | null;
    if (nextBtn) nextBtn.disabled = false;
  }

  function renderQuestion() {
    const status = $('timer-status'); if (status) status.textContent = 'وقت التفكير';
    const hint = $('thinking-hint'); if (hint) hint.hidden = false;
    const label = $('interviewer-label'); if (label) label.textContent = 'المُحاوِر يسألك الآن';
    const details = $('answer-details') as HTMLDetailsElement | null; if (details) details.open = false;
    const q = ORDERED[idx];
    const qNum = $('q-num');
    const progFill = $('prog-fill') as HTMLElement | null;
    if (qNum) qNum.textContent = `${idx + 1} / ${ORDERED.length}`;
    if (progFill) progFill.style.width = `${Math.round(((idx + 1) / ORDERED.length) * 100)}%`;
    const qCat = $('q-cat'); if (qCat) qCat.textContent = q.d;
    const qLevel = $('q-level'); if (qLevel) qLevel.textContent = q.lvl;
    const qText = $('q-text'); if (qText) qText.textContent = q.t;
    const aText = $('answer-text'); if (aText) aText.textContent = q.a;
    const fullAnswer = $('full-answer'); if (fullAnswer) fullAnswer.innerHTML = q.full;
    if (details) details.hidden = !q.full.trim();
    const answerBox = $('answer-box') as HTMLElement | null; if (answerBox) answerBox.hidden = true;
    const revealBtn = $('reveal-btn') as HTMLElement | null; if (revealBtn) revealBtn.hidden = false;
    const timeoutNote = $('timeout-note'); if (timeoutNote) timeoutNote.hidden = true;
    const assessment = $('self-assessment'); if (assessment) assessment.hidden = true;
    const knownBtn = $('rate-known') as HTMLButtonElement | null;
    const reviewBtn = $('rate-review') as HTMLButtonElement | null;
    for (const btn of [knownBtn, reviewBtn]) { if (btn) { btn.disabled = false; btn.classList.remove('selected'); } }
    const feedback = $('assessment-feedback'); if (feedback) feedback.textContent = 'اختر تقييمك للمتابعة.';
    const nextBtn = $('next-btn') as HTMLButtonElement | null; if (nextBtn) { nextBtn.hidden = true; nextBtn.disabled = true; }
    startTimer();
    // نضمن إن السؤال الجديد يبلّش من أعلى الصفحة تمامًا دايمًا، حتى لو صفحة السؤال السابق كانت طويلة
    // (الجواب المفصّل بيطوّل الصفحة وينزل بها المستخدم لتحت وقت ما يفتحه)
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function startInterview() {
    if (ORDERED.length === 0) return;
    idx = 0;
    answered = 0;
    known = 0;
    missed = 0;
    unanswered = 0;
    if (introEl) introEl.hidden = true;
    if (belowHero) (belowHero as HTMLElement).hidden = true;
    if (finishedEl) finishedEl.hidden = true;
    if (interviewEl) interviewEl.hidden = false;
    updateStickyOffsets();
    renderQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function finishInterview() {
    stopTimer();
    if (interviewEl) interviewEl.hidden = true;
    if (introEl) introEl.hidden = true;
    if (finishedEl) finishedEl.hidden = false;
    const sub = $('done-sub');
    if (sub) sub.textContent = `أنهيت ${answered} من ${ORDERED.length} سؤال. جاهز لمحاولة تانية؟`;
    const scoreKnown = $('score-known'); if (scoreKnown) scoreKnown.textContent = String(known);
    const scoreMissed = $('score-missed'); if (scoreMissed) scoreMissed.textContent = String(missed);
    const scoreUnanswered = $('score-unanswered'); if (scoreUnanswered) scoreUnanswered.textContent = String(unanswered);
    const scorePct = $('score-pct');
    // النسبة% دايمًا من إجمالي بنك الأسئلة (ORDERED.length)، مش من عدد الأسئلة اللي جاوبها فقط —
    // هيك لو خلّص المستخدم بدري (مثلاً 3 من 50) ما تظهر نسبة مضلّلة زي 100%
    if (scorePct) scorePct.textContent = ORDERED.length > 0 ? `${Math.round((known / ORDERED.length) * 100)}%` : '0%';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  $('start-btn')?.addEventListener('click', startInterview);

  $('reveal-btn')?.addEventListener('click', () => {
    if (questionState !== 'thinking') return;
    revealAnswer();
  });

  $('rate-known')?.addEventListener('click', () => rateAnswer('known'));
  $('rate-review')?.addEventListener('click', () => rateAnswer('review'));

  $('next-btn')?.addEventListener('click', () => {
    if (questionState !== 'rated' && questionState !== 'timed-out') return;
    if (idx < ORDERED.length - 1) {
      idx++;
      renderQuestion();
    } else {
      finishInterview();
    }
  });

  $('end-btn')?.addEventListener('click', finishInterview);

  $('restart-btn')?.addEventListener('click', () => {
    if (finishedEl) finishedEl.hidden = true;
    if (introEl) introEl.hidden = false;
    if (belowHero) (belowHero as HTMLElement).hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ===== مشاركة النتيجة كصورة =====
  function roundRect(ctx: CanvasRenderingContext2D, x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // يرسم شعار المنصة الحقيقي (الدرع الدائري + شاشة + علامة صح)، نفس تصميم favicon.svg
  function drawBadge(ctx: CanvasRenderingContext2D, cx: number, cy: number, r: number) {
    ctx.save();
    const glow = ctx.createRadialGradient(cx, cy, r * 0.3, cx, cy, r * 1.8);
    glow.addColorStop(0, 'rgba(56,189,248,.35)');
    glow.addColorStop(1, 'rgba(56,189,248,0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(cx, cy, r * 1.8, 0, Math.PI * 2);
    ctx.fill();

    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.fillStyle = '#0d1b33';
    ctx.fill();
    ctx.lineWidth = r * 0.067;
    ctx.strokeStyle = '#38bdf8';
    ctx.stroke();

    const s = r / 30;
    const ox = cx - 32 * s;
    const oy = cy - 32 * s;
    const X = (v: number) => ox + v * s;
    const Y = (v: number) => oy + v * s;

    ctx.lineWidth = 3.4 * s;
    ctx.strokeStyle = '#e8eef9';
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    const rx0 = X(16), ry0 = Y(20), rw = 32 * s, rh = 22 * s, rr = 3 * s;
    ctx.beginPath();
    ctx.moveTo(rx0 + rr, ry0);
    ctx.lineTo(rx0 + rw - rr, ry0);
    ctx.arcTo(rx0 + rw, ry0, rx0 + rw, ry0 + rr, rr);
    ctx.lineTo(rx0 + rw, ry0 + rh - rr);
    ctx.arcTo(rx0 + rw, ry0 + rh, rx0 + rw - rr, ry0 + rh, rr);
    ctx.lineTo(rx0 + rr, ry0 + rh);
    ctx.arcTo(rx0, ry0 + rh, rx0, ry0 + rh - rr, rr);
    ctx.lineTo(rx0, ry0 + rr);
    ctx.arcTo(rx0, ry0, rx0 + rr, ry0, rr);
    ctx.closePath();
    ctx.stroke();

    ctx.beginPath(); ctx.moveTo(X(26), Y(50)); ctx.lineTo(X(38), Y(50)); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(X(32), Y(42)); ctx.lineTo(X(32), Y(50)); ctx.stroke();

    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 3.6 * s;
    ctx.beginPath();
    ctx.moveTo(X(26), Y(31));
    ctx.lineTo(X(30), Y(35));
    ctx.lineTo(X(38), Y(27));
    ctx.stroke();

    ctx.restore();
  }

  function drawShareCard(): HTMLCanvasElement | null {
    const canvas = document.getElementById('share-canvas') as HTMLCanvasElement | null;
    if (!canvas) return null;
    const ctx = canvas.getContext('2d');
    if (!ctx) return null;
    ctx.direction = 'rtl';
    const W = canvas.width, H = canvas.height;
    const cx = W / 2;
    const arFont = (weight: string, size: number) => `${weight} ${size}px "IBM Plex Sans Arabic", Tahoma, sans-serif`;
    const logoTop = SITE.logoTop || 'Testing';
    const logoBottom = SITE.logoBottom || 'بالعربي';

    // خلفية متدرّجة
    const grad = ctx.createLinearGradient(0, 0, W, H);
    grad.addColorStop(0, '#0a1628');
    grad.addColorStop(1, '#182c52');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, W, H);

    // نقاط خفيفة بالخلفية
    ctx.fillStyle = 'rgba(56,189,248,.10)';
    for (let y = 40; y < H; y += 44) {
      for (let x = 40; x < W; x += 44) {
        ctx.beginPath();
        ctx.arc(x, y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    // Border خارجي يلفّ الكرت كامل
    ctx.strokeStyle = 'rgba(56,189,248,.35)';
    ctx.lineWidth = 6;
    ctx.strokeRect(3, 3, W - 6, H - 6);

    // الشعار: الدرع الحقيقي + النص تحته
    drawBadge(ctx, cx, 150, 72);

    ctx.direction = 'ltr';
    ctx.textAlign = 'left';
    ctx.font = arFont('800', 30);
    ctx.fillStyle = '#e8eef9';
    const w1 = ctx.measureText(logoTop).width;
    ctx.font = arFont('600', 24);
    const w2 = ctx.measureText(logoBottom).width;
    const gapWord = 12;
    const logoStartX = cx - (w1 + gapWord + w2) / 2;
    ctx.font = arFont('800', 30);
    ctx.fillStyle = '#e8eef9';
    ctx.fillText(logoTop, logoStartX, 268);
    ctx.font = arFont('600', 24);
    ctx.fillStyle = '#93a4c0';
    ctx.fillText(logoBottom, logoStartX + w1 + gapWord, 265);
    ctx.direction = 'rtl';
    ctx.textAlign = 'center';

    // النتيجة الكبيرة: known/TOTAL (من إجمالي بنك الأسئلة، مش من اللي جاوبه بس)
    const TOTAL = ORDERED.length || answered;
    const scoreText = `${known}`;
    const totalText = `/${TOTAL}`;
    ctx.font = arFont('800', 145);
    const scoreWidth = ctx.measureText(scoreText).width;
    ctx.font = arFont('700', 68);
    const totalWidth = ctx.measureText(totalText).width;
    const leftX = cx - (scoreWidth + totalWidth) / 2;

    ctx.direction = 'ltr';
    ctx.textAlign = 'left';
    ctx.font = arFont('800', 145);
    ctx.fillStyle = '#ffffff';
    ctx.fillText(scoreText, leftX, 460);
    ctx.font = arFont('700', 68);
    ctx.fillStyle = '#8fa3c4';
    ctx.fillText(totalText, leftX + scoreWidth, 460);
    ctx.direction = 'rtl';
    ctx.textAlign = 'center';

    ctx.fillStyle = '#9fb2ce';
    ctx.font = arFont('600', 33);
    ctx.fillText('نتيجتي بمقابلة QA التجريبية 🎯', cx, 515);

    ctx.fillStyle = '#8fa3c4';
    ctx.font = arFont('500', 23);
    ctx.fillText('تقييم ذاتي بعد مقارنة الإجابات', cx, 552);

    // إحصائيات داخل كبسولات — النسبة% من إجمالي بنك الأسئلة
    const pct = TOTAL > 0 ? Math.round((known / TOTAL) * 100) : 0;
    const statY = 630, pillW = 225, pillH = 110, gapX = 20;
    const stats: [string, string, string][] = [
      [String(known), 'إجابتي صحيحة ✓', '#34d399'],
      [String(missed), 'تحتاج مراجعة', '#f65b5b'],
      [String(unanswered), 'لم أجب', '#93a4c0'],
      [`${pct}%`, 'من كل البنك', '#38bdf8'],
    ];
    const totalW = pillW * stats.length + gapX * (stats.length - 1);
    const startX = cx - totalW / 2;
    stats.forEach(([val, lbl, color], i) => {
      const px = startX + i * (pillW + gapX);
      ctx.fillStyle = 'rgba(255,255,255,.05)';
      ctx.strokeStyle = 'rgba(56,189,248,.22)';
      ctx.lineWidth = 2;
      roundRect(ctx, px, statY, pillW, pillH, 18);
      ctx.fill();
      ctx.stroke();
      ctx.textAlign = 'center';
      ctx.fillStyle = color;
      ctx.font = arFont('800', 46);
      ctx.fillText(val, px + pillW / 2, statY + 52);
      ctx.fillStyle = '#93a4c0';
      ctx.font = arFont('600', 20);
      ctx.fillText(lbl, px + pillW / 2, statY + 85);
    });

    // زر الدعوة للعمل متدرّج
    const btnW = 480, btnH = 92, btnX = cx - btnW / 2, btnY = 800;
    const btnGrad = ctx.createLinearGradient(btnX, 0, btnX + btnW, 0);
    btnGrad.addColorStop(0, '#38bdf8');
    btnGrad.addColorStop(1, '#6366f1');
    ctx.fillStyle = btnGrad;
    roundRect(ctx, btnX, btnY, btnW, btnH, 20);
    ctx.fill();
    ctx.fillStyle = '#0a1628';
    ctx.font = arFont('800', 32);
    ctx.fillText('جرّب مقابلتك أنت 🎯', cx, btnY + 58);

    ctx.fillStyle = '#7d93b8';
    ctx.font = arFont('600', 26);
    ctx.fillText((SITE.url || 'testing-arabic.com').replace(/^https?:\/\//, '') + '/interview', cx, 940);

    return canvas;
  }

  $('share-btn')?.addEventListener('click', async () => {
    const canvas = drawShareCard();
    if (!canvas) return;
    canvas.toBlob(async (blob) => {
      if (!blob) return;
      const file = new File([blob], 'my-qa-interview-result.png', { type: 'image/png' });
      const shareData = {
        files: [file],
        title: 'نتيجتي بمقابلة QA التجريبية',
        text: `قيّمت إجاباتي بمقابلة QA التجريبية: ${known} صحيحة، ${missed} للمراجعة، ${unanswered} لم أجب، من ${ORDERED.length || answered} سؤال على ${SITE.logoTop || 'Testing'} ${SITE.logoBottom || 'بالعربي'} 🎯`,
      };
      const nav = navigator as Navigator & { canShare?: (data: any) => boolean; share?: (data: any) => Promise<void> };
      if (nav.canShare && nav.canShare(shareData) && nav.share) {
        try {
          await nav.share(shareData);
          return;
        } catch {
          // المستخدم ألغى المشاركة أو صار خطأ — بننزل لخيار التحميل
        }
      }
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'my-qa-interview-result.png';
      link.click();
      URL.revokeObjectURL(link.href);
    }, 'image/png');
  });
</script>
