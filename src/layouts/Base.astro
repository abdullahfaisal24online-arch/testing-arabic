---
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorFx from '../components/CursorFx.astro';
import VideoFacade from '../components/VideoFacade.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <BaseHead {...props} />
    <script is:inline>
      // يطبّق الوضع المحفوظ قبل الرسم حتى ما تصير ومضة
      (function () {
        try {
          var saved = localStorage.getItem('ta-theme');
          // الوضع الغامق هو الأساس، والفاتح باختيار صريح من الزائر
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">تخطَّ إلى المحتوى</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CursorFx />
    <VideoFacade poster={props.type === 'video.other' ? props.image : undefined} />
  </body>
</html>
