---
import '@fontsource/ibm-plex-sans-arabic/arabic-400.css';
import '@fontsource/ibm-plex-sans-arabic/latin-400.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-500.css';
import '@fontsource/ibm-plex-sans-arabic/latin-500.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-600.css';
import '@fontsource/ibm-plex-sans-arabic/latin-600.css';
import '@fontsource/ibm-plex-sans-arabic/arabic-700.css';
import '@fontsource/ibm-plex-sans-arabic/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import arabicHeadingFont from '@fontsource/ibm-plex-sans-arabic/files/ibm-plex-sans-arabic-arabic-700-normal.woff2?url';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CursorFx from '../components/CursorFx.astro';
import BgFx from '../components/BgFx.astro';
import VideoFacade from '../components/VideoFacade.astro';
import ChatBot from '../components/ChatBot.astro';
import StoreSoon from '../components/StoreSoon.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  publishDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const props = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <BaseHead {...props} />
    <link rel="preload" href={arabicHeadingFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // يطبّق الوضع المحفوظ قبل الرسم حتى ما تصير ومضة
      (function () {
        try {
          var saved = localStorage.getItem('ta-theme');
          // الوضع الغامق هو الأساس، والفاتح باختيار صريح من الزائر
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">تخطَّ إلى المحتوى</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CursorFx />
    <BgFx />
        <StoreSoon />
    <VideoFacade poster={props.type === 'video.other' ? props.image : undefined} />
    <ChatBot />
    <Analytics />
    <!-- نسخة احتياطية من إيميلات المشتركين بقاعدة البيانات عندنا — ما بتلمس مسار الاشتراك نفسه -->
    <script is:inline>
      document.addEventListener(
        'submit',
        (e) => {
          const form = e.target;
          if (!(form instanceof HTMLFormElement)) return;
          let host = '';
          try {
            host = new URL(form.action, location.href).hostname;
          } catch (err) {
            return;
          }
          if (!/(^|\.)(kit|convertkit)\.com$/.test(host)) return;
          const field = form.querySelector('input[type="email"]');
          const email = field && field.value ? field.value.trim() : '';
          if (!email) return;
          try {
            navigator.sendBeacon(
              '/api/subscribe',
              new Blob([JSON.stringify({ email })], { type: 'application/json' }),
            );
          } catch (err) {
            /* لو فشلت النسخة الاحتياطية، الاشتراك عند Kit بيضل شغّال */
          }
        },
        true,
      );
    </script>
  </body>
</html>
