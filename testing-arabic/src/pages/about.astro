---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../consts';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `عن ${SITE.name}`,
  url: `${SITE.url}/about`,
  inLanguage: 'ar',
};
---
<Base
  title="عن المنصة"
  description={`عن ${SITE.name} — منصة عربية مستقلة لتعليم اختبار البرمجيات، من صاحب قناة Testing بالعربي.`}
  jsonLd={jsonLd}
>
  <section class="page-head dots">
    <div class="wrap">
      <h1>عن المنصة</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p>
        <strong>{SITE.name}</strong> منصة عربية مستقلة لتعليم اختبار البرمجيات. بدأت القصة بقناة يوتيوب،
        وهاد المكان صار البيت الدائم للمحتوى: الدروس والمسارات والمقالات كلها هون، على دومين مستقل، وبترتيب
        بتقدر تتعلّم منه فعلاً بدل ما تدوّر بين الفيديوهات.
      </p>

      <h2>ليش منصة مستقلة؟</h2>
      <p>
        يوتيوب مكان ممتاز للاكتشاف، بس ما بتملكه. هون المحتوى مرتّب بمسارات، وكل درس معه ملفاته وشرحه المكتوب،
        وما في خوارزمية بتقرر شو بيوصلك.
      </p>

      <h2>لمين هالمحتوى؟</h2>
      <ul>
        <li>حدا بده يدخل مجال الـ QA وما بيعرف من وين يبدأ.</li>
        <li>مختبر يدوي بده ينتقل للأتمتة بخطوات واضحة.</li>
        <li>حدا شغّال بفريق وبده يفهم الأدوات وإدارة الاختبار عملياً.</li>
      </ul>

      <h2>المحتوى مجاني</h2>
      <p>
        كل الدروس والمقالات مجانية، بدون تسجيل دخول ولا اشتراك. الهدف إنه المحتوى العربي بالمجال يكون متاح للكل.
      </p>

      <h2>تواصل</h2>
      <p>
        {SITE.youtube && <><a href={SITE.youtube} target="_blank" rel="noopener">القناة على يوتيوب</a> · </>}
        {SITE.email && <a href={`mailto:${SITE.email}`}>{SITE.email}</a>}
      </p>
    </div>
  </section>
</Base>

<style>
  .page-head { background: var(--navy); border-bottom: 1px solid var(--line); padding-block: 52px 44px; }
</style>
