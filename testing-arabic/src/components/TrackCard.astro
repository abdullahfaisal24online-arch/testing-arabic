---
import Icon from './Icon.astro';
import { lessonsLabel } from '../lib/utils';

interface Props {
  track: {
    id: string;
    data: { title: string; description: string; level: string; accent: 'cyan' | 'orange'; recommended: boolean };
  };
  count: number;
}
const { track, count } = Astro.props;
const { data } = track;
const icon = data.accent === 'orange' ? 'board' : 'list';
---
<a class="card track" href={`/tracks/${track.id}/`} data-accent={data.accent}>
  <div class="card-body">
    <div class="top">
      <span class="ic"><Icon name={icon} size={21} /></span>
      <span class:list={['badge', data.accent === 'orange' && 'badge-orange']}>{data.level}</span>
    </div>
    <span class="ttl">{data.title}</span>
    <p class="desc">{data.description}</p>
    <span class="meta">{count === 0 ? 'قيد الإضافة' : lessonsLabel(count)}</span>
    {data.recommended && <span class="rec">موصى فيه للبداية</span>}
  </div>
</a>

<style>
  .track { color: inherit; }
  .track .card-body { padding: 26px; gap: 12px; }
  .top { display: flex; align-items: center; justify-content: space-between; }
  .ic {
    display: grid; place-items: center;
    width: 46px; height: 46px; border-radius: var(--r-md);
    background: var(--cyan-soft); color: var(--cyan);
  }
  [data-accent='orange'] .ic { background: var(--orange-soft); color: var(--orange); }
  .ttl { font-size: 20px; font-weight: 700; line-height: 1.55; }
  .desc { font-size: 15px; color: var(--ink-3); line-height: 1.85; }
  .meta { font-size: 14px; color: var(--muted); }
  .rec { font-size: 12px; font-weight: 600; color: var(--orange); }
</style>
