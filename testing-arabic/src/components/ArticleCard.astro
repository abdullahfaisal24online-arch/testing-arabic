---
import { formatDate, readingTime, minutesLabel } from '../lib/utils';

interface Props {
  article: {
    id: string;
    body?: string;
    data: { title: string; description: string; category: string; publishDate: Date };
  };
}
const { article } = Astro.props;
const mins = readingTime(article.body);
---
<a class="card art" href={`/articles/${article.id}/`}>
  <div class="card-body">
    <span class="meta mono">{article.data.category} · {minutesLabel(mins)} قراءة</span>
    <span class="ttl">{article.data.title}</span>
    <p class="desc">{article.data.description}</p>
    <span class="date">{formatDate(article.data.publishDate)}</span>
  </div>
</a>

<style>
  .art { color: inherit; background: var(--navy); }
  .art .card-body { padding: 24px; gap: 12px; }
  .meta { font-size: 12px; font-weight: 500; color: var(--cyan); }
  .ttl { font-size: 19px; font-weight: 700; line-height: 1.6; }
  .desc { font-size: 15px; color: var(--ink-3); line-height: 1.85; }
  .date { font-size: 13px; color: var(--faint); margin-top: auto; }
</style>
