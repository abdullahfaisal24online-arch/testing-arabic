{
  "name": "testing-arabic",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",

  // بدون هدول السطرين، كل نشر جديد بيرجّع يفعّل روابط workers.dev —
  // يعني بيصير في باب تاني للموقع وللوحة الأدمن ما بيمرّ من بوابة Access.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // لازم الـ Worker يمسك مسارات التعليقات قبل الملفات الثابتة
    "run_worker_first": ["/api/comments", "/api/comments/*", "/api/subscribe", "/api/pro/unlock", "/api/pro/status", "/api/pro/logout", "/pro", "/pro/*", "/admin/pro", "/admin/pro/*", "/admin/comments", "/admin/comments/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testing-arabic-comments",
      "database_id": "e5744c71-13a1-4b03-b142-3120c11ee9d1"
    }
  ],
  "observability": {
    "enabled": true
  }
}
